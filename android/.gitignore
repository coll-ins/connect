# Signing keys never go in git: lose this file and you cannot update the app.
*.keystore
*.jks
# Everything Bubblewrap generates from twa-manifest.json
*
!.gitignore
!README.md
!twa-manifest.json
!assetlinks.template.json
# Hand-built APK for the site's Install button (see README: Direct download APK)
!apk/
!apk/**
apk/.gradle/
apk/**/build/
*.keystore
*.jks
