SECRET_KEY=replace-with-a-long-random-django-secret
DEBUG=True
ADMIN_SIGNUP_CODE=replace-with-a-private-admin-code
PAYSTACK_SECRET_KEY=sk_test_replace_me
DATABASE_URL=sqlite:///db.sqlite3
TRIP_AUTO_CLOSE_AFTER_HOURS=12
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_ALERT_PHONE_NUMBERS=
AT_USERNAME=sandbox
AT_API_KEY=

# Production (DEBUG=False) refuses to start unless these are set. The error names every one that is missing.
# ALLOWED_HOSTS, CORS_ALLOWED_ORIGINS, FRONTEND_URL, DATABASE_URL, NUM_PROXIES (1 behind Render's proxy),
# REDIS_URL, REDIS_CACHE_URL, AT_API_KEY (live), AT_USERNAME (not "sandbox"), ADMIN_ALERT_PHONE_NUMBERS,
# SECRET_KEY (50+ chars), ADMIN_SIGNUP_CODE (20+ chars), PAYSTACK_SECRET_KEY, BEHIND_TLS_PROXY=True.
NUM_PROXIES=1
REDIS_URL=
REDIS_CACHE_URL=
BEHIND_TLS_PROXY=False
# Shared secret for POST /api/internal/cron/<job>/ (GitHub scheduled-jobs.yml sends it). Empty = jobs disabled.
CRON_SECRET=

# Payment timing (seconds). A payment this long after the 10-minute hold is still treated as on time.
PAYMENT_ARRIVAL_TOLERANCE_SECONDS=60
# Timeout for the Paystack check made when a passenger polls a payment.
PAYMENT_STATUS_VERIFY_TIMEOUT_SECONDS=10
# Largest per-company booking cut-off a manager may set, in minutes.
BOOKING_CUTOFF_MAX_MINUTES=240

# Driver GPS: a fix older than this many seconds, or less accurate than this many metres, is ignored.
GPS_FIX_MAX_AGE_SECONDS=120
GPS_MAX_ACCURACY_M=200

# Wallet. Both switches stay false until the live Paystack tests are done. Only "true" or "false" are accepted.
# The limits below are placeholders for the owner to set.
WALLET_TOPUP_ENABLED=false
WALLET_PAYOUTS_ENABLED=false
WALLET_TOPUP_CHANNELS=mobile_money
WALLET_TOPUP_MIN_KES=50
WALLET_TOPUP_MAX_KES=20000
WALLET_MAX_BALANCE_KES=50000
WALLET_WITHDRAW_MIN_KES=50
WALLET_WITHDRAW_MAX_KES=20000
WALLET_WITHDRAW_DAILY_LIMIT_KES=30000
