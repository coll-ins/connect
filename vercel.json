{
  "framework": "vite",
  "installCommand": "npm ci --prefix frontend-react",
  "buildCommand": "npm run build --prefix frontend-react",
  "outputDirectory": "frontend-react/dist",
  "routes": [
    {
      "src": "/connect\\.apk",
      "headers": {
        "Content-Type": "application/vnd.android.package-archive",
        "Content-Disposition": "attachment; filename=\"connect.apk\""
      },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "https://connect-lhqy.onrender.com/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
