{
  "framework": "vite",
  "installCommand": "npm ci --prefix frontend-react",
  "buildCommand": "npm run build --prefix frontend-react",
  "outputDirectory": "frontend-react/dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://connect-lhqy.onrender.com/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
