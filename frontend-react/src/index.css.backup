@import "tailwindcss";
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#e8eef7;background:#07111f;font-synthesis:none;text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased}*{box-sizing:border-box}html,body,#root{min-height:100%;margin:0}body{min-width:320px;background:radial-gradient(circle at 20% 0%,#12304a 0,transparent 35%),linear-gradient(135deg,#07111f,#091827 55%,#07111f)}button,input,select,textarea{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed;opacity:.55}a{color:inherit;text-decoration:none}.app-shell{min-height:100vh}.loading-screen{min-height:100vh;display:grid;place-items:center;color:#9fb1c7;font-weight:700}.auth-page{min-height:100vh;display:grid;place-items:center;padding:24px}.auth-card{width:min(460px,100%);padding:34px;border:1px solid #20354b;background:rgba(9,24,39,.92);border-radius:24px;box-shadow:0 24px 70px rgba(0,0,0,.35)}.brand-mark{width:48px;height:48px;display:grid;place-items:center;border-radius:14px;background:linear-gradient(135deg,#16c784,#07966a);font-weight:900;font-size:24px;color:#03120e}.eyebrow{font-size:11px;letter-spacing:.16em;font-weight:800;color:#61d7b2;margin:22px 0 8px}.auth-card h1{font-size:34px;margin:0 0 8px}.muted{color:#91a4b9;line-height:1.55}.auth-footer{text-align:center;color:#91a4b9;margin:22px 0 0}.auth-footer a{color:#61d7b2;font-weight:800}.form-stack{display:grid;gap:16px;margin-top:24px}.form-stack label{display:grid;gap:7px;color:#cbd8e6;font-size:13px;font-weight:750}.input,.select{width:100%;border:1px solid #294057;background:#071522;color:#f4f8fb;border-radius:12px;padding:13px 14px;outline:none}.input:focus,.select:focus{border-color:#1ec98c;box-shadow:0 0 0 3px rgba(30,201,140,.12)}

/* =========================================================
   CONNECT DRIVER PORTAL
   ========================================================= */

.driver-app {
  min-height: 100vh;
  display: flex;
  background:
    radial-gradient(circle at 70% -10%, rgba(22, 199, 132, 0.09), transparent 30%),
    radial-gradient(circle at 10% 80%, rgba(48, 106, 160, 0.10), transparent 30%),
    #07111f;
  color: #e8eef7;
}

.driver-sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 250px;
  z-index: 50;
  display: flex;
  flex-direction: column;
  padding: 25px 16px;
  border-right: 1px solid rgba(148, 173, 199, 0.13);
  background: rgba(6, 18, 31, 0.82);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
}

.driver-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 3px 9px 30px;
}

.driver-brand-mark {
  width: 39px;
  height: 39px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: linear-gradient(135deg, #19cf8d, #087f5d);
  color: #03120e;
  font-size: 20px;
  font-weight: 950;
  box-shadow: 0 8px 25px rgba(22, 199, 132, 0.18);
}

.driver-brand strong,
.driver-brand span {
  display: block;
}

.driver-brand strong {
  font-size: 14px;
  letter-spacing: 0.08em;
}

.driver-brand span {
  margin-top: 2px;
  color: #71869d;
  font-size: 11px;
}

.driver-nav {
  display: grid;
  gap: 6px;
}

.driver-nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 45px;
  padding: 0 13px;
  border: 1px solid transparent;
  border-radius: 12px;
  color: #8ea2b8;
  font-size: 13px;
  font-weight: 750;
  transition: 160ms ease;
}

.driver-nav-item:hover {
  color: #eaf4f2;
  background: rgba(255, 255, 255, 0.035);
}

.driver-nav-item.active {
  color: #72e1bd;
  border-color: rgba(44, 211, 153, 0.13);
  background: rgba(27, 185, 127, 0.09);
}

.driver-sidebar-bottom {
  margin-top: auto;
  padding-top: 18px;
  border-top: 1px solid rgba(148, 173, 199, 0.10);
}

.driver-mini-profile {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px;
}

.driver-avatar,
.driver-topbar-avatar {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  border-radius: 50%;
  background: linear-gradient(135deg, #153d50, #0b7560);
  color: #a9f1d7;
  font-weight: 850;
}

.driver-avatar {
  width: 35px;
  height: 35px;
  font-size: 13px;
}

.driver-mini-copy {
  min-width: 0;
}

.driver-mini-copy strong,
.driver-mini-copy span {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-mini-copy strong {
  color: #dce7f2;
  font-size: 12px;
}

.driver-mini-copy span {
  margin-top: 2px;
  color: #687f96;
  font-size: 10px;
}

.driver-signout {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 10px;
  padding: 10px;
  border: 1px solid rgba(148, 173, 199, 0.10);
  border-radius: 10px;
  background: transparent;
  color: #8195aa;
  font-size: 12px;
  font-weight: 750;
}

.driver-signout:hover {
  color: #f1c4c4;
  border-color: rgba(239, 107, 107, 0.18);
  background: rgba(239, 107, 107, 0.05);
}

.driver-main {
  width: calc(100% - 250px);
  min-height: 100vh;
  margin-left: 250px;
}

.driver-topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  min-height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 34px;
  border-bottom: 1px solid rgba(148, 173, 199, 0.09);
  background: rgba(7, 17, 31, 0.74);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.driver-topbar-title span,
.driver-panel-kicker,
.driver-eyebrow {
  display: block;
  color: #5fcfae;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 0.16em;
}

.driver-topbar-title strong {
  display: block;
  margin-top: 4px;
  color: #dce7f2;
  font-size: 14px;
}

.driver-topbar-user {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #8ca1b7;
  font-size: 12px;
  font-weight: 700;
}

.driver-status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #28cf91;
  box-shadow: 0 0 12px rgba(40, 207, 145, 0.65);
}

.driver-topbar-avatar {
  width: 33px;
  height: 33px;
  margin-left: 5px;
  font-size: 12px;
}

.driver-mobile-menu {
  display: none;
}

.driver-content {
  width: min(1380px, 100%);
  margin: 0 auto;
  padding: 36px 38px 60px;
}

.driver-welcome {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 25px;
  margin-bottom: 28px;
}

.driver-welcome h1 {
  margin: 8px 0 8px;
  color: #f1f6fb;
  font-size: clamp(30px, 4vw, 46px);
  line-height: 1.05;
  letter-spacing: -0.035em;
}

.driver-welcome p {
  margin: 0;
  color: #8297ad;
  font-size: 14px;
}

.driver-vehicle-chip {
  min-width: 205px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 15px;
  border: 1px solid rgba(148, 173, 199, 0.12);
  border-radius: 15px;
  background: rgba(14, 31, 48, 0.62);
}

.driver-vehicle-chip svg {
  color: #64d9b5;
}

.driver-vehicle-chip span,
.driver-vehicle-chip strong {
  display: block;
}

.driver-vehicle-chip span {
  color: #71869c;
  font-size: 10px;
  font-weight: 750;
}

.driver-vehicle-chip strong {
  margin-top: 3px;
  color: #dce8f3;
  font-size: 14px;
}

.driver-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 18px;
  padding: 12px 14px;
  border: 1px solid rgba(239, 107, 107, 0.20);
  border-radius: 12px;
  background: rgba(151, 43, 43, 0.10);
  color: #f2aaaa;
  font-size: 12px;
}

.driver-error button {
  display: grid;
  place-items: center;
  border: 0;
  background: transparent;
  color: inherit;
}

.driver-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 13px;
  margin-bottom: 18px;
}

.driver-stat-card,
.driver-panel,
.driver-booking-card,
.driver-empty-state {
  border: 1px solid rgba(148, 173, 199, 0.11);
  background: linear-gradient(
    145deg,
    rgba(17, 37, 56, 0.78),
    rgba(8, 22, 36, 0.74)
  );
  box-shadow: 0 18px 45px rgba(0, 0, 0, 0.16);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.driver-stat-card {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 17px;
  border-radius: 16px;
}

.driver-stat-icon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  border-radius: 12px;
  background: rgba(30, 201, 140, 0.09);
  color: #65dcb8;
}

.driver-stat-blue .driver-stat-icon {
  background: rgba(74, 146, 226, 0.10);
  color: #79b8ef;
}

.driver-stat-purple .driver-stat-icon {
  background: rgba(155, 116, 232, 0.10);
  color: #b69be9;
}

.driver-stat-amber .driver-stat-icon {
  background: rgba(224, 168, 69, 0.10);
  color: #e9ba68;
}

.driver-stat-content {
  min-width: 0;
}

.driver-stat-content span,
.driver-stat-content strong,
.driver-stat-content small {
  display: block;
}

.driver-stat-content span {
  color: #70859b;
  font-size: 10px;
  font-weight: 750;
  text-transform: uppercase;
  letter-spacing: 0.07em;
}

.driver-stat-content strong {
  margin-top: 4px;
  overflow: hidden;
  color: #edf4f9;
  font-size: 20px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-stat-content small {
  margin-top: 3px;
  overflow: hidden;
  color: #61768b;
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-primary-grid {
  display: grid;
  grid-template-columns: 1.35fr 0.65fr;
  gap: 15px;
  margin-bottom: 30px;
}

.driver-panel {
  padding: 21px;
  border-radius: 18px;
}

.driver-panel-heading,
.driver-section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
}

.driver-panel-heading h2,
.driver-section-heading h2 {
  margin: 5px 0 0;
  color: #e8f0f6;
  font-size: 18px;
  letter-spacing: -0.02em;
}

.driver-panel-heading > svg {
  color: #6b8299;
}

.driver-live-indicator {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 8px;
  border: 1px solid rgba(40, 207, 145, 0.12);
  border-radius: 7px;
  color: #66d8b6;
  font-size: 9px;
  font-weight: 850;
  letter-spacing: 0.08em;
}

.driver-live-indicator span {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #2bd093;
}

.driver-location-content {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 14px;
  margin-top: 24px;
  padding-top: 20px;
  border-top: 1px solid rgba(148, 173, 199, 0.08);
}

.driver-location-icon {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  border-radius: 15px;
  color: #6fe0ba;
  background: rgba(31, 200, 140, 0.08);
}

.driver-location-copy strong,
.driver-location-copy span {
  display: block;
}

.driver-location-copy strong {
  color: #e0eaf2;
  font-size: 14px;
}

.driver-location-copy span {
  max-width: 470px;
  margin-top: 5px;
  color: #72879c;
  font-size: 11px;
  line-height: 1.5;
}

.driver-primary-button,
.driver-board-button,
.driver-refresh-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: 10px;
  font-size: 11px;
  font-weight: 800;
  transition: 160ms ease;
}

.driver-primary-button,
.driver-board-button {
  border: 1px solid rgba(35, 211, 151, 0.20);
  background: linear-gradient(135deg, #17b97f, #0c9166);
  color: #03140f;
  padding: 10px 14px;
  box-shadow: 0 8px 20px rgba(17, 185, 127, 0.12);
}

.driver-primary-button:hover,
.driver-board-button:hover {
  transform: translateY(-1px);
  filter: brightness(1.06);
}

.driver-primary-button:disabled {
  transform: none;
}

.driver-profile-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px 20px;
  margin-top: 21px;
}

.driver-profile-list div {
  min-width: 0;
}

.driver-profile-list span,
.driver-profile-list strong {
  display: block;
}

.driver-profile-list span {
  color: #697f95;
  font-size: 10px;
  font-weight: 750;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.driver-profile-list strong {
  margin-top: 4px;
  overflow: hidden;
  color: #dce7ef;
  font-size: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-bookings-section {
  scroll-margin-top: 90px;
}

.driver-section-heading {
  align-items: flex-end;
  margin-bottom: 14px;
}

.driver-section-heading p {
  margin: 7px 0 0;
  color: #71869b;
  font-size: 12px;
}

.driver-refresh-button {
  padding: 9px 12px;
  border: 1px solid rgba(148, 173, 199, 0.13);
  background: rgba(17, 35, 52, 0.60);
  color: #9eb1c4;
}

.driver-refresh-button:hover {
  border-color: rgba(44, 211, 153, 0.18);
  color: #71dcb9;
}

.driver-spin {
  animation: driver-spin 0.8s linear infinite;
}

@keyframes driver-spin {
  to {
    transform: rotate(360deg);
  }
}

.driver-bookings-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.driver-booking-card {
  padding: 18px;
  border-radius: 16px;
  transition: transform 160ms ease, border-color 160ms ease;
}

.driver-booking-card:hover {
  transform: translateY(-2px);
  border-color: rgba(93, 216, 178, 0.18);
}

.driver-booking-header {
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

.driver-booking-number {
  color: #5f7890;
  font-size: 9px;
  font-weight: 850;
  letter-spacing: 0.10em;
}

.driver-booking-card h3 {
  margin: 4px 0 0;
  color: #e4edf4;
  font-size: 15px;
}

.driver-booking-status {
  align-self: flex-start;
  padding: 5px 8px;
  border-radius: 7px;
  font-size: 9px;
  font-weight: 850;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.driver-booking-status.confirmed {
  border: 1px solid rgba(40, 207, 145, 0.13);
  background: rgba(40, 207, 145, 0.08);
  color: #65dcb8;
}

.driver-booking-status.other {
  border: 1px solid rgba(225, 176, 77, 0.14);
  background: rgba(225, 176, 77, 0.08);
  color: #e6bb70;
}

.driver-route-box {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 16px 0;
  padding: 11px;
  border: 1px solid rgba(148, 173, 199, 0.08);
  border-radius: 10px;
  background: rgba(3, 13, 23, 0.22);
}

.driver-route-box svg {
  color: #63d7b5;
  flex: 0 0 auto;
}

.driver-route-box span,
.driver-route-box strong {
  display: block;
}

.driver-route-box span {
  color: #60768d;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.driver-route-box strong {
  margin-top: 2px;
  color: #cbd9e5;
  font-size: 11px;
}

.driver-booking-details {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.driver-booking-details span,
.driver-booking-details strong {
  display: block;
}

.driver-booking-details span {
  color: #60768d;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.driver-booking-details strong {
  margin-top: 3px;
  color: #cbd9e5;
  font-size: 11px;
  font-weight: 700;
}

.driver-board-button {
  width: 100%;
  margin-top: 16px;
}

.driver-empty-state {
  min-height: 230px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30px;
  border-radius: 17px;
  text-align: center;
}

.driver-empty-icon {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  margin-bottom: 13px;
  border-radius: 15px;
  color: #70dcb9;
  background: rgba(31, 200, 140, 0.08);
}

.driver-empty-state strong {
  color: #dbe6ef;
  font-size: 14px;
}

.driver-empty-state > span {
  max-width: 440px;
  margin-top: 6px;
  color: #6f8499;
  font-size: 11px;
  line-height: 1.6;
}

.driver-loading-spinner {
  width: 27px;
  height: 27px;
  margin-bottom: 13px;
  border: 2px solid rgba(111, 224, 186, 0.18);
  border-top-color: #65dcb8;
  border-radius: 50%;
  animation: driver-spin 0.8s linear infinite;
}

.driver-mobile-backdrop {
  display: none;
}

/* Driver responsive layout */

@media (max-width: 1100px) {
  .driver-stats {
    grid-template-columns: 1fr 1fr;
  }

  .driver-primary-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 820px) {
  .driver-sidebar {
    transform: translateX(-100%);
    transition: transform 180ms ease;
    box-shadow: 20px 0 50px rgba(0, 0, 0, 0.30);
  }

  .driver-sidebar-open {
    transform: translateX(0);
  }

  .driver-mobile-backdrop {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 40;
    border: 0;
    background: rgba(0, 0, 0, 0.48);
    backdrop-filter: blur(3px);
  }

  .driver-main {
    width: 100%;
    margin-left: 0;
  }

  .driver-mobile-menu {
    display: inline-grid;
    place-items: center;
    width: 35px;
    height: 35px;
    margin-right: 8px;
    border: 1px solid rgba(148, 173, 199, 0.12);
    border-radius: 9px;
    background: rgba(15, 32, 49, 0.60);
    color: #a5b8ca;
    vertical-align: middle;
  }

  .driver-topbar {
    padding: 0 17px;
  }

  .driver-topbar-user > span {
    display: none;
  }

  .driver-content {
    padding: 27px 17px 45px;
  }

  .driver-welcome {
    align-items: stretch;
    flex-direction: column;
  }

  .driver-vehicle-chip {
    width: 100%;
  }

  .driver-bookings-grid {
    grid-template-columns: 1fr;
  }

  .driver-location-content {
    grid-template-columns: auto 1fr;
  }

  .driver-primary-button {
    grid-column: 1 / -1;
    width: 100%;
  }
}

@media (max-width: 540px) {
  .driver-stats {
    grid-template-columns: 1fr;
  }

  .driver-welcome h1 {
    font-size: 31px;
  }

  .driver-profile-list {
    grid-template-columns: 1fr;
  }

  .driver-section-heading {
    align-items: stretch;
    flex-direction: column;
  }

  .driver-refresh-button {
    width: 100%;
  }

  .driver-booking-details {
    grid-template-columns: 1fr;
  }
}
