import { useCallback, useEffect, useMemo, useState } from 'react';
import { apiRequest } from '../../api';
import { useAuth } from '../../context/AuthContext';
import AppShell from '../../components/layout/AppShell';

const money = (v) => `KES ${Number(v || 0).toLocaleString('en-KE',{minimumFractionDigits:2,maximumFractionDigits:2})}`;
const date = (v) => v ? new Date(v).toLocaleString('en-KE',{dateStyle:'medium',timeStyle:'short'}) : 'Not scheduled';

function Shell({ children }) {
  return <AppShell>{children}</AppShell>;
}

function PaymentModal({ booking, onClose, onPaid }) {
  const [step, setStep] = useState('method');
  const [busy, setBusy] = useState(false);
  const [message, setMessage] = useState('');
  const [error, setError] = useState('');

  const cash = async () => {
    setBusy(true); setError('');
    try { await apiRequest(`/bookings/payments/${booking.booking_id}/cash/`, { method:'POST' }); setStep('cash-success'); onPaid(); }
    catch(e){setError(e.message)} finally{setBusy(false)}
  };

  const mpesa = async () => {
    setBusy(true); setError('');
    try {
      const data = await apiRequest(`/bookings/payments/${booking.booking_id}/mpesa/`, {method:'POST'});
      setMessage(data.display_text || 'Check your phone and complete the M-PESA prompt.');
      setStep('mpesa-wait');
    } catch(e){setError(e.message)} finally{setBusy(false)}
  };

  const card = async () => {
    setBusy(true); setError('');
    try {
      const data = await apiRequest(`/bookings/payments/${booking.booking_id}/paystack/`, {
        method:'POST', body:{callback_url:`${window.location.origin}/passenger/payment/${booking.booking_id}`}
      });
      window.location.href = data.authorization_url;
    } catch(e){setError(e.message);setBusy(false)}
  };

  useEffect(() => {
    if (step !== 'mpesa-wait') return undefined;
    let active = true; let attempts = 0;
    const poll = async () => {
      attempts += 1;
      try {
        const status = await apiRequest(`/bookings/payments/${booking.booking_id}/status/`);
        if (!active) return;
        if (status.payment_status === 'confirmed') { setStep('paid'); onPaid(); return; }
        if (status.payment_status === 'failed') { setError('The M-PESA payment failed. You can try again.'); setStep('method'); return; }
      } catch {
        // Keep polling while the gateway completes the transaction.
      }
      if (active && attempts < 60) window.setTimeout(poll, 3000);
      else if (active) setMessage('Still waiting for Paystack. You can refresh the status or close this window and check your bookings.');
    };
    poll();
    return () => { active = false; };
  }, [step, booking.booking_id, onPaid]);

  const verify = async () => {
    setBusy(true); setError('');
    try { const data = await apiRequest(`/bookings/payments/${booking.booking_id}/verify/`, {method:'POST'}); if(data.payment_status==='confirmed'){setStep('paid');onPaid();} else setMessage(data.message || 'Payment is still pending.'); }
    catch(e){setError(e.message)} finally{setBusy(false)}
  };

  return <div className="modal-backdrop"><div className="modal">
    <button className="btn btn-ghost modal-close" onClick={onClose}>Close</button>
    <p className="eyebrow">BOOKING {booking.booking_number}</p>
    <h2>{money(booking.total_amount)}</h2><p className="muted">Choose how you want to complete this trip.</p>
    {error && <div className="error">{error}</div>}
    {step==='method' && <div className="stack" style={{marginTop:18}}>
      <button className="pay-option" onClick={cash} disabled={busy}><div className="pay-icon">💵</div><div><strong>Pay with cash</strong><span>Pay the driver/conductor according to the trip rules.</span></div></button>
      <button className="pay-option" onClick={()=>setStep('online')} disabled={busy}><div className="pay-icon">💳</div><div><strong>Pay online</strong><span>Choose M-PESA or Card securely through Paystack.</span></div></button>
    </div>}
    {step==='online' && <div className="stack" style={{marginTop:18}}>
      <button className="pay-option" onClick={mpesa} disabled={busy}><div className="pay-icon">📱</div><div><strong>M-PESA</strong><span>Use your saved phone number and receive the STK push.</span></div></button>
      <button className="pay-option" onClick={card} disabled={busy}><div className="pay-icon">💳</div><div><strong>Card</strong><span>Secure Paystack checkout. Card authentication stays with Paystack.</span></div></button>
      <button className="btn btn-ghost" onClick={()=>setStep('method')}>← Back</button>
    </div>}
    {step==='mpesa-wait' && <div className="payment-status"><div className="payment-spinner"/><h3>Check your phone</h3><p className="muted">{message}</p><p className="mobile-note">The M-PESA prompt is sent to the number saved on your CONNECT account. Authorize it on your phone.</p><button className="btn btn-secondary" onClick={verify} disabled={busy}>{busy?'Checking…':'Check payment status'}</button></div>}
    {step==='cash-success' && <div className="success">Cash selected. Your booking is ready for the driver/conductor to confirm according to the cash-payment flow.</div>}
    {step==='paid' && <div className="payment-status"><div style={{fontSize:48}}>✓</div><h3>Payment confirmed</h3><p className="muted">Your booking is confirmed. Enjoy your trip.</p><button className="btn btn-primary" onClick={onClose}>Done</button></div>}
  </div></div>;
}

export default function PassengerDashboard({ initialJourneyStep = 'home' }) {
  const { user, logout } = useAuth();
  const [companies,setCompanies]=useState([]),[routes,setRoutes]=useState([]),[trips,setTrips]=useState([]),[bookings,setBookings]=useState([]),[wallet,setWallet]=useState(null);
  const [company,setCompany]=useState(''),[route,setRoute]=useState('');
  const [bookingTrip,setBookingTrip]=useState(null),[seats,setSeats]=useState(1),[pickup,setPickup]=useState(user?.location||'Main Stage');
  const [paymentBooking,setPaymentBooking]=useState(null),[loading,setLoading]=useState(false),[error,setError]=useState(''),[success,setSuccess]=useState('');

  const refresh = useCallback(async()=>{
    try { const [b,w]=await Promise.all([apiRequest('/bookings/my/'),apiRequest('/wallet/')]); setBookings(Array.isArray(b)?b:[]); setWallet(w); } catch(e){setError(e.message)}
  },[]);
  useEffect(()=>{apiRequest('/companies/').then(d=>setCompanies(Array.isArray(d)?d:[])).catch(e=>setError(e.message));refresh()},[refresh]);
  useEffect(()=>{if(!company){setRoutes([]);setTrips([]);return} apiRequest(`/companies/${company}/routes/`).then(d=>setRoutes(d||[])).catch(e=>setError(e.message))},[company]);
  useEffect(()=>{if(!company){setTrips([]);return} const q=route?`?route_id=${route}`:''; apiRequest(`/companies/${company}/trips/${q}`).then(d=>setTrips(Array.isArray(d)?d:[])).catch(e=>setError(e.message))},[company,route]);

  const selectedRoute=useMemo(()=>routes.find(r=>String(r.id)===String(route)),[routes,route]);
  const startBooking=(trip)=>{setError('');setBookingTrip(trip);setSeats(1);setPickup(user?.location||'Main Stage')};
  const createBooking=async()=>{
    if(!pickup.trim()) return setError('Enter a pickup location.');
    setLoading(true);setError('');
    try { const b=await apiRequest('/bookings/create/',{method:'POST',body:{trip_id:bookingTrip.id,seats:Number(seats),pickup_location:pickup.trim()}});setBookingTrip(null);await refresh();setPaymentBooking({booking_id:b.booking_id,booking_number:b.booking_number,total_amount:b.total_amount}); }
    catch(e){setError(e.message)}finally{setLoading(false)}
  };
  const cancel=async(id)=>{if(!confirm('Cancel this booking?'))return;try{await apiRequest(`/bookings/${id}/cancel/`,{method:'POST'});setSuccess('Booking cancelled.');refresh()}catch(e){setError(e.message)}};

  const [journeyStep, setJourneyStep] = useState(initialJourneyStep);
  const [journeyMode, setJourneyMode] = useState('');

  const selectedCompany = useMemo(
    () => companies.find((c) => String(c.id) === String(company)),
    [companies, company]
  );

  const chooseJourney = (mode) => {
    setError('');
    setSuccess('');
    setJourneyMode(mode);
    setCompany('');
    setRoute('');
    setRoutes([]);
    setTrips([]);
    setJourneyStep('companies');
  };

  const chooseCompany = (id) => {
    setError('');
    setCompany(String(id));
    setRoute('');
    setJourneyStep('routes');
  };

  const chooseRoute = (id) => {
    setError('');
    setRoute(String(id));
    setJourneyStep('trips');
  };

  const goBack = () => {
    setError('');

    if (journeyStep === 'companies') {
      setJourneyStep('home');
      setJourneyMode('');
      return;
    }

    if (journeyStep === 'routes') {
      setCompany('');
      setRoute('');
      setRoutes([]);
      setTrips([]);
      setJourneyStep('companies');
      return;
    }

    if (journeyStep === 'trips') {
      setRoute('');
      setTrips([]);
      setJourneyStep('routes');
    }
  };

  return <Shell>
    <div className="passenger-experience">

      {error && (
        <div className="connect-alert connect-alert-error">
          <span>{error}</span>
          <button type="button" onClick={() => setError('')}>×</button>
        </div>
      )}

      {success && (
        <div className="connect-alert connect-alert-success">
          <span>{success}</span>
          <button type="button" onClick={() => setSuccess('')}>×</button>
        </div>
      )}

      {/* =====================================================
          STEP 1 — PASSENGER HOME
          ===================================================== */}

      {journeyStep === 'home' && (
        <section className="passenger-home">
          <div className="passenger-welcome">
            <div>
              <span className="glass-eyebrow">CONNECT • SMART MATATU TRAVEL</span>
              <h1>Where are you<br />going today?</h1>
              <p>
                Choose how you want to travel and we'll guide you
                through the journey.
              </p>
            </div>

            <div className="welcome-orb" aria-hidden="true">
              <div className="welcome-orb-inner">
                <span>✦</span>
              </div>
            </div>
          </div>

          <div className="journey-choice-grid">

            <button
              type="button"
              className="journey-choice"
              onClick={() => chooseJourney('seat')}
            >
              <div className="journey-choice-image journey-seat-image">
                <div className="journey-image-overlay" />
                <span className="journey-icon">🚌</span>
              </div>

              <div className="journey-choice-content">
                <span className="journey-number">01</span>
                <h2>Book a Seat</h2>
                <p>
                  Find an available departure and reserve your seat
                  quickly.
                </p>
                <span className="journey-arrow">Explore seats <b>→</b></span>
              </div>
            </button>

            <button
              type="button"
              className="journey-choice"
              onClick={() => chooseJourney('delivery')}
            >
              <div className="journey-choice-image journey-travel-image">
                <div className="journey-image-overlay" />
                <span className="journey-icon">✦</span>
              </div>

              <div className="journey-choice-content">
                <span className="journey-number">02</span>
                <h2>Order Delivery</h2>
                <p>
                  Send a parcel safely through the CONNECT transport network.
                </p>
                <span className="journey-arrow">Send a parcel <b>→</b></span>
              </div>
            </button>

            <button
              type="button"
              className="journey-choice"
              onClick={() => chooseJourney('bus')}
            >
              <div className="journey-choice-image journey-bus-image">
                <div className="journey-image-overlay" />
                <span className="journey-icon">🚍</span>
              </div>

              <div className="journey-choice-content">
                <span className="journey-number">03</span>
                <h2>Book a Bus</h2>
                <p>
                  Reserve a whole bus for groups, events and private travel.
                </p>
                <span className="journey-arrow">Reserve a bus <b>→</b></span>
              </div>
            </button>

          </div>

          <div className="passenger-home-footer">
            <span>Secure booking</span>
            <span>•</span>
            <span>Wallet protected</span>
            <span>•</span>
            <span>Real-time departures</span>
          </div>
        </section>
      )}

      {/* =====================================================
          STEP 2 — TRANSPORT COMPANIES
          ===================================================== */}

      {journeyStep === 'companies' && (
        <section className="journey-section">

          <div className="journey-heading">
            <button type="button" className="journey-back" onClick={goBack}>
              ← Back
            </button>

            <span className="glass-eyebrow">
              {journeyMode === 'seat'
                ? 'BOOK A SEAT'
                : journeyMode === 'delivery'
                  ? 'ORDER DELIVERY'
                  : 'BOOK A BUS'}
            </span>

            <h1>Choose your transport company</h1>

            <p>
              Select a company to explore its available routes and
              scheduled departures.
            </p>
          </div>

          <div className="company-card-grid">
            {companies.map((c, index) => (
              <button
                type="button"
                className="company-glass-card"
                key={c.id}
                onClick={() => chooseCompany(c.id)}
              >
                <div className={`company-image company-image-${index % 3}`}>
                  <div className="company-image-shade" />
                  <div className="company-bus-mark">🚌</div>
                  <span className="company-image-label">CONNECT FLEET</span>
                </div>

                <div className="company-card-content">
                  <div>
                    <span className="company-kicker">TRANSPORT COMPANY</span>
                    <h2>{c.name}</h2>
                  </div>

                  <span className="company-card-arrow">↗</span>
                </div>

                <div className="company-card-footer">
                  <span>View routes</span>
                  <span>→</span>
                </div>
              </button>
            ))}
          </div>

          {!companies.length && (
            <div className="glass-empty">
              <span>Loading transport companies…</span>
            </div>
          )}
        </section>
      )}

      {/* =====================================================
          STEP 3 — ROUTES
          ===================================================== */}

      {journeyStep === 'routes' && (
        <section className="journey-section">

          <div className="journey-heading">
            <button type="button" className="journey-back" onClick={goBack}>
              ← Companies
            </button>

            <span className="glass-eyebrow">
              {selectedCompany?.name || 'TRANSPORT COMPANY'}
            </span>

            <h1>Where would you like to go?</h1>

            <p>
              Choose a route to see its available departures.
            </p>
          </div>

          <div className="selected-company-strip">
            <div className="selected-company-icon">🚌</div>
            <div>
              <span>Selected company</span>
              <strong>{selectedCompany?.name || 'Transport company'}</strong>
            </div>
          </div>

          <div className="route-list">
            {routes.map((r) => (
              <button
                type="button"
                className="route-glass-card"
                key={r.id}
                onClick={() => chooseRoute(r.id)}
              >
                <div className="route-point">
                  <span className="route-dot" />
                  <strong>{r.origin || 'Origin'}</strong>
                </div>

                <div className="route-line">
                  <span />
                  <span />
                  <span />
                </div>

                <div className="route-point route-destination">
                  <span className="route-dot" />
                  <strong>{r.destination || r.name || 'Destination'}</strong>
                </div>

                <div className="route-price">
                  <span>From</span>
                  <strong>{money(r.price)}</strong>
                </div>

                <span className="route-arrow">→</span>
              </button>
            ))}
          </div>

          {!routes.length && (
            <div className="glass-empty">
              <span>No routes are currently available for this company.</span>
            </div>
          )}
        </section>
      )}

      {/* =====================================================
          STEP 4 — AVAILABLE TRIPS
          ===================================================== */}

      {journeyStep === 'trips' && (
        <section className="journey-section">

          <div className="journey-heading">
            <button type="button" className="journey-back" onClick={goBack}>
              ← Routes
            </button>

            <span className="glass-eyebrow">
              AVAILABLE DEPARTURES
            </span>

            <h1>{selectedRoute?.name || 'Available trips'}</h1>

            <p>
              Select a scheduled departure that works for you.
            </p>
          </div>

          <div className="trip-summary-glass">
            <div>
              <span>{selectedCompany?.name || 'Transport company'}</span>
              <strong>
                {selectedRoute?.origin || 'Origin'}
                <b>→</b>
                {selectedRoute?.destination || 'Destination'}
              </strong>
            </div>

            <div className="trip-summary-price">
              <span>Fare</span>
              <strong>{money(selectedRoute?.price)}</strong>
            </div>
          </div>

          <div className="modern-trip-list">
            {!trips.length ? (
              <div className="glass-empty">
                <span>No scheduled departures are available for this route.</span>
              </div>
            ) : (
              trips.map((t) => (
                <article className="modern-trip-card" key={t.id}>

                  <div className="trip-time-block">
                    <span>DEPARTURE</span>
                    <strong>
                      {new Date(t.departure_at).toLocaleTimeString(
                        'en-KE',
                        { hour: '2-digit', minute: '2-digit' }
                      )}
                    </strong>
                    <small>
                      {new Date(t.departure_at).toLocaleDateString(
                        'en-KE',
                        { day: 'numeric', month: 'short' }
                      )}
                    </small>
                  </div>

                  <div className="trip-route-visual">
                    <div className="trip-route-line">
                      <span />
                      <i />
                      <span />
                    </div>

                    <div>
                      <strong>{t.route_details?.name || selectedRoute?.name}</strong>
                      <p>{t.company_name || selectedCompany?.name}</p>
                    </div>
                  </div>

                  <div className="trip-info">
                    <span>
                      🚌 {t.driver_bus_number || 'Bus pending'}
                    </span>
                    <span>
                      💺 {t.capacity || 0} seats
                    </span>
                    <span>
                      {t.status}
                    </span>
                  </div>

                  <div className="trip-action">
                    <strong>{money(t.route_details?.price)}</strong>
                    <button
                      type="button"
                      className="glass-primary-button"
                      disabled={t.status !== 'scheduled'}
                      onClick={() => startBooking(t)}
                    >
                      {t.status === 'scheduled'
                        ? 'Select trip →'
                        : 'Unavailable'}
                    </button>
                  </div>

                </article>
              ))
            )}
          </div>
        </section>
      )}

      {/* =====================================================
          BOOKING MODAL
          ===================================================== */}

      {bookingTrip && (
        <div className="modal-backdrop">
          <div className="modal modern-booking-modal">

            <button
              type="button"
              className="btn btn-ghost modal-close"
              onClick={() => setBookingTrip(null)}
            >
              Close
            </button>

            <span className="glass-eyebrow">CONFIRM YOUR JOURNEY</span>

            <h2>{bookingTrip.route_details?.name}</h2>

            <p className="muted">
              {date(bookingTrip.departure_at)}
              {' • '}
              {bookingTrip.driver_name || 'Driver pending'}
            </p>

            <div className="booking-modal-glass-summary">
              <div>
                <span>Fare</span>
                <strong>
                  {money(bookingTrip.route_details?.price)}
                </strong>
              </div>

              <div>
                <span>Bus</span>
                <strong>
                  {bookingTrip.driver_bus_number || 'Pending'}
                </strong>
              </div>
            </div>

            <div className="form-stack">
              <label className="field">
                Seats
                <input
                  className="input"
                  type="number"
                  min="1"
                  max="20"
                  value={seats}
                  onChange={(e) =>
                    setSeats(
                      Math.max(
                        1,
                        Math.min(20, Number(e.target.value) || 1)
                      )
                    )
                  }
                />
              </label>

              <label className="field">
                Pickup location
                <input
                  className="input"
                  value={pickup}
                  onChange={(e) => setPickup(e.target.value)}
                />
              </label>

              <div className="booking-total-glass">
                <span>Total journey cost</span>
                <strong>
                  {money(
                    Number(bookingTrip.route_details?.price || 0) *
                    Number(seats)
                  )}
                </strong>
              </div>

              <button
                type="button"
                className="glass-primary-button glass-primary-button-large"
                onClick={createBooking}
                disabled={loading}
              >
                {loading
                  ? 'Creating booking…'
                  : 'Confirm booking & continue →'}
              </button>
            </div>
          </div>
        </div>
      )}

      {/* =====================================================
          EXISTING PAYMENT FLOW
          ===================================================== */}

      {paymentBooking && (
        <PaymentModal
          booking={paymentBooking}
          onClose={() => {
            setPaymentBooking(null);
            refresh();
          }}
          onPaid={refresh}
        />
      )}

    </div>
  </Shell>;
}
