.passenger-live-map {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100dvh;
  overflow: hidden;
  background: #eef3f8;
  z-index: 2000;
}

.passenger-live-map__canvas {
  position: absolute;
  inset: 0;
}

.passenger-live-map__leaflet {
  width: 100%;
  height: 100%;
  background: #e9eef3;
}

.passenger-live-map__topbar {
  position: absolute;
  top: max(16px, env(safe-area-inset-top));
  left: 16px;
  right: 16px;
  z-index: 1000;

  display: flex;
  align-items: center;
  gap: 12px;

  padding: 10px 12px;
  border-radius: 18px;

  background: rgba(255,255,255,.94);
  border: 1px solid rgba(15,23,42,.08);
  box-shadow: 0 12px 35px rgba(15,23,42,.13);
  backdrop-filter: blur(18px);
}

.passenger-live-map__back {
  width: 42px;
  height: 42px;
  border: 0;
  border-radius: 13px;

  display: grid;
  place-items: center;

  background: #f1f5f9;
  color: #0f172a;
  cursor: pointer;
}

.passenger-live-map__trip-title {
  min-width: 0;
  flex: 1;
}

.passenger-live-map__trip-title strong {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;

  color: #0f172a;
  font-size: 14px;
  font-weight: 800;
}

.passenger-live-map__trip-title span {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-top: 3px;

  color: #64748b;
  font-size: 11px;
  font-weight: 700;
}

.passenger-live-map__live {
  display: flex;
  align-items: center;
  gap: 6px;

  padding: 7px 9px;
  border-radius: 999px;

  background: #ecfdf3;
  color: #15803d;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .06em;
}

.passenger-live-map__live span,
.passenger-live-map__vehicle-live span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 0 4px rgba(34,197,94,.12);
}

.passenger-live-map__locate {
  position: absolute;
  right: 18px;
  bottom: min(305px, 34vh);
  z-index: 1000;

  width: 48px;
  height: 48px;
  border: 0;
  border-radius: 16px;

  display: grid;
  place-items: center;

  background: rgba(255,255,255,.95);
  color: #0f172a;
  box-shadow: 0 10px 28px rgba(15,23,42,.18);
  cursor: pointer;
}

.passenger-live-map__locate.is-active {
  background: #111827;
  color: white;
}

.passenger-live-map__sheet {
  position: absolute;
  left: 50%;
  bottom: max(14px, env(safe-area-inset-bottom));
  transform: translateX(-50%);

  width: min(560px, calc(100% - 28px));
  z-index: 1000;

  padding: 12px 18px 18px;
  border-radius: 25px;

  background: rgba(255,255,255,.97);
  border: 1px solid rgba(15,23,42,.08);
  box-shadow: 0 20px 55px rgba(15,23,42,.18);
  backdrop-filter: blur(20px);
}

.passenger-live-map__handle {
  width: 38px;
  height: 4px;
  margin: 0 auto 14px;
  border-radius: 999px;
  background: #d5dbe3;
}

.passenger-live-map__status-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 15px;
}

.passenger-live-map__eyebrow {
  color: #64748b;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .12em;
}

.passenger-live-map__status-row h1 {
  margin: 4px 0 0;
  color: #0f172a;
  font-size: 19px;
  line-height: 1.15;
}

.passenger-live-map__distance {
  display: grid;
  grid-template-columns: auto auto;
  column-gap: 5px;
  align-items: center;
  padding: 8px 10px;
  border-radius: 13px;
  background: #f8fafc;
  color: #334155;
}

.passenger-live-map__distance strong {
  font-size: 14px;
}

.passenger-live-map__distance span {
  grid-column: 2;
  color: #94a3b8;
  font-size: 9px;
  font-weight: 700;
}

.passenger-live-map__vehicle-card {
  display: flex;
  align-items: center;
  gap: 11px;
  margin-top: 14px;
  padding: 11px;
  border-radius: 16px;
  background: #f8fafc;
}

.passenger-live-map__vehicle-icon {
  width: 40px;
  height: 40px;
  border-radius: 13px;

  display: grid;
  place-items: center;

  background: #111827;
  color: white;
}

.passenger-live-map__vehicle-info {
  min-width: 0;
  flex: 1;
}

.passenger-live-map__vehicle-info strong {
  display: block;
  color: #0f172a;
  font-size: 13px;
}

.passenger-live-map__vehicle-info span {
  display: block;
  margin-top: 2px;
  color: #64748b;
  font-size: 10px;
}

.passenger-live-map__vehicle-live {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #15803d;
  font-size: 9px;
  font-weight: 900;
}

.passenger-live-map__pickup {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 12px;
}

.passenger-live-map__pickup-dot {
  width: 10px;
  height: 10px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #111827;
  box-shadow: 0 0 0 5px #e2e8f0;
}

.passenger-live-map__pickup span {
  display: block;
  color: #94a3b8;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: .1em;
}

.passenger-live-map__pickup strong {
  display: block;
  margin-top: 2px;
  color: #334155;
  font-size: 12px;
}

.passenger-live-map__gps-note {
  margin-top: 11px;
  padding: 9px 11px;
  border-radius: 12px;
  background: #fff7ed;
  color: #9a3412;
  font-size: 10px;
  line-height: 1.4;
}

.passenger-live-map__loading,
.passenger-live-map__error {
  position: absolute;
  top: 90px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 1000;

  padding: 10px 14px;
  border-radius: 12px;

  background: rgba(15,23,42,.9);
  color: white;
  font-size: 11px;
  box-shadow: 0 10px 30px rgba(15,23,42,.2);
}

.passenger-live-map__error {
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(127,29,29,.94);
}

.passenger-live-map__error span {
  opacity: .8;
}

.passenger-live-map__error button {
  border: 0;
  border-radius: 8px;
  padding: 6px 9px;
  background: white;
  color: #7f1d1d;
  font-size: 10px;
  font-weight: 800;
  cursor: pointer;
}

/* Vehicle marker */
.passenger-vehicle-marker {
  background: transparent !important;
  border: 0 !important;
}

.passenger-vehicle-marker__outer {
  position: relative;
  width: 58px;
  height: 58px;
}

.passenger-vehicle-marker__pulse {
  position: absolute;
  inset: 4px;
  border-radius: 50%;
  background: rgba(17,24,39,.12);
}

.passenger-vehicle-marker__vehicle {
  position: absolute;
  left: 11px;
  top: 7px;

  width: 36px;
  height: 44px;

  border-radius: 12px 12px 9px 9px;
  background: #111827;
  border: 3px solid white;

  box-shadow:
    0 7px 18px rgba(15,23,42,.3),
    0 0 0 4px rgba(17,24,39,.12);
}

.vehicle-window {
  position: absolute;
  background: #dbeafe;
  border-radius: 5px;
}

.vehicle-window--front {
  left: 6px;
  right: 6px;
  top: 5px;
  height: 12px;
}

.vehicle-window--back {
  left: 6px;
  right: 6px;
  bottom: 6px;
  height: 9px;
  opacity: .7;
}

.vehicle-light {
  position: absolute;
  bottom: 2px;
  width: 5px;
  height: 3px;
  border-radius: 3px;
  background: #f8fafc;
}

.vehicle-light--left {
  left: 5px;
}

.vehicle-light--right {
  right: 5px;
}

/* Passenger location pin */
.passenger-location-marker {
  background: transparent !important;
  border: 0 !important;
}

.passenger-location-marker__wrap {
  position: relative;
  width: 58px;
  height: 70px;
}

.passenger-location-marker__shadow {
  position: absolute;
  left: 13px;
  bottom: 2px;
  width: 32px;
  height: 10px;
  border-radius: 50%;
  background: rgba(15,23,42,.2);
  filter: blur(3px);
}

.passenger-location-marker__pin {
  position: absolute;
  left: 7px;
  top: 2px;

  width: 44px;
  height: 44px;

  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);

  background: #111827;
  border: 4px solid white;

  box-shadow:
    0 8px 20px rgba(15,23,42,.28),
    0 0 0 5px rgba(17,24,39,.1);
}

.passenger-location-marker__core {
  position: absolute;
  left: 50%;
  top: 50%;

  width: 12px;
  height: 12px;

  transform: translate(-50%, -50%) rotate(45deg);
  border-radius: 50%;

  background: white;
}

/* Remove default popup visual weight */
.passenger-live-map .leaflet-popup-content-wrapper {
  border-radius: 13px;
}

.passenger-live-map .leaflet-popup-content {
  margin: 10px 12px;
  font-size: 11px;
}

@media (max-width: 640px) {
  .passenger-live-map__topbar {
    left: 10px;
    right: 10px;
    top: max(10px, env(safe-area-inset-top));
  }

  .passenger-live-map__sheet {
    width: calc(100% - 16px);
    bottom: max(8px, env(safe-area-inset-bottom));
    padding-left: 15px;
    padding-right: 15px;
    border-radius: 22px;
  }

  .passenger-live-map__locate {
    right: 14px;
    bottom: 300px;
  }

  .passenger-live-map__status-row h1 {
    font-size: 17px;
  }

  .passenger-live-map__error {
    left: 10px;
    right: 10px;
    transform: none;
    width: auto;
  }
}
