.operator-page {
  min-height: 100vh;
  color: #e8eef8;
  background:
    radial-gradient(circle at 10% 0%, rgba(59, 130, 246, 0.16), transparent 32%),
    radial-gradient(circle at 90% 10%, rgba(16, 185, 129, 0.10), transparent 28%),
    linear-gradient(145deg, #07101f 0%, #0a1425 48%, #07101d 100%);
}

.operator-shell {
  width: min(1480px, calc(100% - 40px));
  margin: 0 auto;
  padding-bottom: 30px;
}

.operator-topbar {
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.operator-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.operator-brand-mark {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  color: white;
  font-size: 18px;
  font-weight: 800;
  background: linear-gradient(145deg, #18b981, #1687a8);
  box-shadow: 0 10px 30px rgba(16, 185, 129, 0.18);
}

.operator-brand-copy {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.operator-brand-copy strong {
  color: #f8fbff;
  font-size: 16px;
  letter-spacing: 0.08em;
}

.operator-brand-copy span {
  color: rgba(203, 213, 225, 0.55);
  font-size: 11px;
}

.operator-topbar-right {
  display: flex;
  align-items: center;
  gap: 18px;
}

.operator-identity {
  display: flex;
  align-items: center;
  gap: 10px;
}

.operator-avatar,
.operator-mini-avatar {
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.07);
  color: #dffcf3;
  font-weight: 700;
}

.operator-avatar {
  width: 34px;
  height: 34px;
  border-radius: 50%;
}

.operator-mini-avatar {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  font-size: 12px;
}

.operator-identity-copy {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.operator-identity-copy strong {
  color: #f5f8fc;
  font-size: 13px;
}

.operator-identity-copy span {
  color: rgba(203, 213, 225, 0.52);
  font-size: 11px;
}

.operator-logout {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 9px 13px;
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 10px;
  color: rgba(226, 232, 240, 0.82);
  background: rgba(255, 255, 255, 0.045);
  cursor: pointer;
  transition: 160ms ease;
}

.operator-logout:hover {
  color: #fff;
  border-color: rgba(255, 255, 255, 0.18);
  background: rgba(255, 255, 255, 0.08);
}

.operator-main {
  padding: 34px 0 0;
}

.operator-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;
  padding: 12px 0 28px;
}

.operator-eyebrow,
.operator-section-kicker {
  display: flex;
  align-items: center;
  gap: 7px;
  color: #64e0b1;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.operator-live-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #36d399;
  box-shadow: 0 0 14px rgba(54, 211, 153, 0.7);
}

.operator-hero h1 {
  margin: 8px 0 8px;
  color: #f8fbff;
  font-size: clamp(30px, 4vw, 46px);
  line-height: 1.05;
  letter-spacing: -0.04em;
}

.operator-hero p {
  max-width: 650px;
  margin: 0;
  color: rgba(203, 213, 225, 0.64);
  font-size: 14px;
  line-height: 1.7;
}

.operator-refresh {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 11px;
  color: #dce8f5;
  background: rgba(255, 255, 255, 0.05);
  cursor: pointer;
  transition: 160ms ease;
}

.operator-refresh:hover:not(:disabled) {
  background: rgba(255, 255, 255, 0.09);
}

.operator-refresh:disabled {
  opacity: 0.6;
  cursor: wait;
}

.operator-spin {
  animation: operator-spin 0.9s linear infinite;
}

@keyframes operator-spin {
  to {
    transform: rotate(360deg);
  }
}

.operator-alert {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 20px;
  padding: 13px 15px;
  border: 1px solid rgba(248, 113, 113, 0.20);
  border-radius: 13px;
  color: #fecaca;
  background: rgba(127, 29, 29, 0.16);
}

.operator-alert div {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.operator-alert strong {
  font-size: 13px;
}

.operator-alert span {
  color: rgba(254, 202, 202, 0.70);
  font-size: 12px;
}

.operator-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 13px;
  margin-bottom: 34px;
}

.operator-stat-card {
  display: flex;
  align-items: center;
  gap: 13px;
  min-height: 105px;
  padding: 18px;
  border: 1px solid rgba(255, 255, 255, 0.085);
  border-radius: 17px;
  background: rgba(255, 255, 255, 0.045);
  box-shadow: 0 16px 45px rgba(0, 0, 0, 0.16);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.operator-stat-icon {
  width: 42px;
  height: 42px;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  border-radius: 12px;
  color: #8fe8c8;
  background: rgba(16, 185, 129, 0.10);
  border: 1px solid rgba(16, 185, 129, 0.12);
}

.operator-stat-card > div:last-child {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.operator-stat-card span {
  color: rgba(203, 213, 225, 0.55);
  font-size: 11px;
}

.operator-stat-card strong {
  margin: 3px 0;
  color: #f8fbff;
  font-size: 25px;
  line-height: 1;
}

.operator-stat-card small {
  color: rgba(203, 213, 225, 0.42);
  font-size: 10px;
}

.operator-stat-active .operator-stat-icon {
  color: #7dd3fc;
  background: rgba(56, 189, 248, 0.10);
  border-color: rgba(56, 189, 248, 0.14);
}

.operator-stat-warning .operator-stat-icon {
  color: #fcd34d;
  background: rgba(245, 158, 11, 0.10);
  border-color: rgba(245, 158, 11, 0.14);
}

.operator-section {
  margin-bottom: 34px;
}

.operator-section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 14px;
}

.operator-section-heading h2 {
  margin: 5px 0 5px;
  color: #f5f8fc;
  font-size: 21px;
  letter-spacing: -0.02em;
}

.operator-section-heading p {
  margin: 0;
  color: rgba(203, 213, 225, 0.50);
  font-size: 12px;
}

.operator-section-meta {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 8px 11px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 9px;
  color: rgba(203, 213, 225, 0.62);
  background: rgba(255, 255, 255, 0.035);
  font-size: 11px;
}

.operator-panel {
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.085);
  border-radius: 17px;
  background: rgba(255, 255, 255, 0.035);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.16);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.operator-table-wrap {
  overflow-x: auto;
}

.operator-table {
  width: 100%;
  min-width: 850px;
  border-collapse: collapse;
}

.operator-table th {
  padding: 13px 16px;
  color: rgba(203, 213, 225, 0.38);
  background: rgba(255, 255, 255, 0.025);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-align: left;
  text-transform: uppercase;
}

.operator-table td {
  padding: 15px 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.055);
  color: rgba(226, 232, 240, 0.78);
  font-size: 12px;
}

.operator-table tbody tr {
  transition: background 140ms ease;
}

.operator-table tbody tr:hover {
  background: rgba(255, 255, 255, 0.025);
}

.operator-route {
  display: flex;
  align-items: center;
  gap: 10px;
}

.operator-route-icon {
  width: 32px;
  height: 32px;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  border-radius: 9px;
  color: #78e2bd;
  background: rgba(16, 185, 129, 0.09);
}

.operator-route div:last-child,
.operator-time,
.operator-driver {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.operator-route strong,
.operator-time strong {
  color: #eaf1f9;
  font-size: 12px;
}

.operator-route span,
.operator-time span {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  color: rgba(203, 213, 225, 0.43);
  font-size: 10px;
}

.operator-driver {
  flex-direction: row;
  align-items: center;
  gap: 8px;
}

.operator-driver span {
  color: rgba(226, 232, 240, 0.72);
}

.operator-status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 8px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.04);
  font-size: 10px;
  font-weight: 700;
}

.operator-status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #94a3b8;
}

.operator-status-boarding {
  color: #7dd3fc;
  border-color: rgba(56, 189, 248, 0.16);
  background: rgba(56, 189, 248, 0.07);
}

.operator-status-boarding .operator-status-dot {
  background: #38bdf8;
}

.operator-status-scheduled {
  color: #cbd5e1;
}

.operator-status-departed {
  color: #a7f3d0;
  border-color: rgba(16, 185, 129, 0.16);
  background: rgba(16, 185, 129, 0.07);
}

.operator-status-departed .operator-status-dot,
.operator-status-completed .operator-status-dot {
  background: #34d399;
}

.operator-status-completed {
  color: #a7f3d0;
}

.operator-status-cancelled {
  color: #fca5a5;
  border-color: rgba(248, 113, 113, 0.14);
  background: rgba(248, 113, 113, 0.06);
}

.operator-status-cancelled .operator-status-dot {
  background: #f87171;
}

.operator-select-wrap,
.operator-modal-select {
  position: relative;
  display: inline-flex;
  align-items: center;
}

.operator-select-wrap svg,
.operator-modal-select svg {
  position: absolute;
  right: 10px;
  pointer-events: none;
  color: rgba(203, 213, 225, 0.45);
}

.operator-select,
.operator-modal-select select {
  appearance: none;
  min-width: 125px;
  padding: 8px 30px 8px 10px;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 9px;
  outline: none;
  color: #dce7f3;
  background: rgba(7, 16, 31, 0.75);
  font-size: 11px;
  cursor: pointer;
}

.operator-select:focus,
.operator-modal-select select:focus {
  border-color: rgba(52, 211, 153, 0.35);
}

.operator-empty {
  min-height: 220px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  color: rgba(203, 213, 225, 0.45);
  text-align: center;
}

.operator-empty strong {
  color: rgba(226, 232, 240, 0.80);
  font-size: 13px;
}

.operator-empty span {
  font-size: 11px;
}

.operator-booking-list {
  display: flex;
  flex-direction: column;
}

.operator-booking {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 17px 18px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.055);
}

.operator-booking:last-child {
  border-bottom: 0;
}

.operator-booking-main {
  min-width: 0;
  flex: 1;
  display: grid;
  grid-template-columns: 105px minmax(170px, 1.4fr) minmax(150px, 1fr) minmax(100px, 0.7fr);
  align-items: center;
  gap: 18px;
}

.operator-booking-number {
  color: #8fe8c8;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.03em;
}

.operator-booking-passenger {
  display: flex;
  align-items: center;
  gap: 9px;
  min-width: 0;
}

.operator-booking-passenger div:last-child,
.operator-booking-route,
.operator-booking-payment,
.operator-booking-driver div {
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
}

.operator-booking-passenger strong,
.operator-booking-route strong,
.operator-booking-payment strong,
.operator-booking-driver strong {
  overflow: hidden;
  color: #e8eef7;
  font-size: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.operator-booking-passenger span,
.operator-booking-route span,
.operator-booking-payment span,
.operator-booking-driver span {
  color: rgba(203, 213, 225, 0.38);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

.operator-booking-passenger span {
  font-size: 10px;
  font-weight: 400;
  letter-spacing: 0;
  text-transform: none;
}

.operator-booking-driver {
  display: flex;
  align-items: center;
  gap: 18px;
}

.operator-assign-button {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 11px;
  border: 1px solid rgba(52, 211, 153, 0.18);
  border-radius: 9px;
  color: #9ae6c9;
  background: rgba(16, 185, 129, 0.07);
  font-size: 10px;
  font-weight: 700;
  cursor: pointer;
  white-space: nowrap;
  transition: 150ms ease;
}

.operator-assign-button:hover {
  border-color: rgba(52, 211, 153, 0.32);
  background: rgba(16, 185, 129, 0.12);
}

.operator-footer {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: 12px 2px;
  color: rgba(203, 213, 225, 0.30);
  font-size: 10px;
}

.operator-footer div {
  display: flex;
  align-items: center;
  gap: 6px;
}

.operator-footer-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #34d399;
}

.operator-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: grid;
  place-items: center;
  padding: 20px;
  background: rgba(2, 8, 18, 0.72);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.operator-modal {
  width: min(430px, 100%);
  padding: 24px;
  border: 1px solid rgba(255, 255, 255, 0.11);
  border-radius: 19px;
  background: rgba(13, 25, 43, 0.96);
  box-shadow: 0 30px 100px rgba(0, 0, 0, 0.45);
}

.operator-modal-icon {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  margin-bottom: 16px;
  border-radius: 12px;
  color: #8fe8c8;
  background: rgba(16, 185, 129, 0.10);
}

.operator-modal-heading span {
  color: #64e0b1;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.13em;
}

.operator-modal-heading h3 {
  margin: 5px 0 6px;
  color: #f8fbff;
  font-size: 22px;
}

.operator-modal-heading p {
  margin: 0 0 20px;
  color: rgba(203, 213, 225, 0.56);
  font-size: 12px;
  line-height: 1.6;
}

.operator-field {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.operator-field > span {
  color: rgba(203, 213, 225, 0.55);
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.operator-modal-select {
  width: 100%;
}

.operator-modal-select select {
  width: 100%;
  padding: 11px 34px 11px 12px;
}

.operator-modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 9px;
  margin-top: 22px;
}

.operator-modal-cancel,
.operator-modal-confirm {
  padding: 10px 14px;
  border-radius: 10px;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
}

.operator-modal-cancel {
  border: 1px solid rgba(255, 255, 255, 0.09);
  color: rgba(226, 232, 240, 0.70);
  background: rgba(255, 255, 255, 0.04);
}

.operator-modal-confirm {
  border: 1px solid rgba(52, 211, 153, 0.25);
  color: #062016;
  background: #5ee0ae;
}

.operator-modal-cancel:disabled,
.operator-modal-confirm:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

@media (max-width: 1050px) {
  .operator-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .operator-booking-main {
    grid-template-columns: 90px 1fr 1fr;
  }

  .operator-booking-payment {
    display: none;
  }
}

@media (max-width: 760px) {
  .operator-shell {
    width: min(100% - 24px, 1480px);
  }

  .operator-topbar {
    align-items: flex-start;
    flex-direction: column;
    padding: 15px 0;
  }

  .operator-topbar-right {
    width: 100%;
    justify-content: space-between;
  }

  .operator-hero {
    align-items: flex-start;
    flex-direction: column;
  }

  .operator-stats {
    grid-template-columns: 1fr;
  }

  .operator-section-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .operator-booking {
    align-items: flex-start;
    flex-direction: column;
  }

  .operator-booking-main {
    width: 100%;
    grid-template-columns: 1fr 1fr;
  }

  .operator-booking-number {
    grid-column: 1 / -1;
  }

  .operator-booking-driver {
    width: 100%;
    justify-content: space-between;
  }

  .operator-footer {
    flex-direction: column;
  }
}
