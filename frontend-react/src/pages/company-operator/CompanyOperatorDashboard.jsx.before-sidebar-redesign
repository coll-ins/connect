import { useCallback, useEffect, useMemo, useState } from 'react';
import {
  Activity,
  ArrowRight,
  Bus,
  CalendarDays,
  CheckCircle2,
  ChevronDown,
  CircleAlert,
  LogOut,
  MapPin,
  RefreshCw,
  UserRound,
  Users,
  WalletCards,
} from 'lucide-react';
import { apiRequest } from '../../api';
import { useAuth } from '../../context/AuthContext';
import './CompanyOperatorDashboard.css';

const formatShortDate = (value) =>
  value
    ? new Date(value).toLocaleDateString('en-KE', {
        day: 'numeric',
        month: 'short',
      })
    : '—';

const statusLabel = (status) =>
  status ? status.charAt(0).toUpperCase() + status.slice(1) : 'Unknown';

function StatusBadge({ status }) {
  return (
    <span className={`operator-status operator-status-${status}`}>
      <span className="operator-status-dot" />
      {statusLabel(status)}
    </span>
  );
}

function Shell({ user, logout, children }) {
  return (
    <div className="operator-page">
      <div className="operator-shell">
        <header className="operator-topbar">
          <div className="operator-brand">
            <div className="operator-brand-mark">C</div>

            <div className="operator-brand-copy">
              <strong>CONNECT</strong>
              <span>Company Operations</span>
            </div>
          </div>

          <div className="operator-topbar-right">
            <div className="operator-identity">
              <div className="operator-avatar">
                {(user?.username || 'O').charAt(0).toUpperCase()}
              </div>

              <div className="operator-identity-copy">
                <strong>{user?.username || 'Operator'}</strong>
                <span>
                  {user?.company_name || 'Company'} · Operator
                </span>
              </div>
            </div>

            <button
              type="button"
              className="operator-logout"
              onClick={logout}
            >
              <LogOut size={16} />
              <span>Sign out</span>
            </button>
          </div>
        </header>

        {children}
      </div>
    </div>
  );
}

export default function CompanyOperatorDashboard() {
  const { user, logout } = useAuth();
  const companyId = user?.company_id;

  const [trips, setTrips] = useState([]);
  const [drivers, setDrivers] = useState([]);
  const [bookings, setBookings] = useState([]);
  const [error, setError] = useState('');
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [assigningBooking, setAssigningBooking] = useState(null);
  const [selectedDriver, setSelectedDriver] = useState('');
  const [savingAssignment, setSavingAssignment] = useState(false);

  const load = useCallback(
    async (showRefresh = false) => {
      if (!companyId) return;

      if (showRefresh) {
        setRefreshing(true);
      } else {
        setLoading(true);
      }

      setError('');

      try {
        const [tripData, driverData, bookingData] = await Promise.all([
          apiRequest(`/companies/${companyId}/trips/`),
          apiRequest(`/drivers/?company_id=${companyId}`),
          apiRequest(`/bookings/all/?company_id=${companyId}`),
        ]);

        setTrips(tripData || []);
        setDrivers(driverData || []);
        setBookings(bookingData || []);
      } catch (e) {
        setError(e.message || 'Unable to load operator data.');
      } finally {
        setLoading(false);
        setRefreshing(false);
      }
    },
    [companyId],
  );

  useEffect(() => {
    load();
  }, [load]);

  const updateTripStatus = async (trip, newStatus) => {
    try {
      setError('');

      await apiRequest(`/companies/trips/${trip.id}/status/`, {
        method: 'POST',
        body: { status: newStatus },
      });

      await load(true);
    } catch (e) {
      setError(e.message || 'Unable to update trip status.');
    }
  };

  const openAssign = (booking) => {
    setAssigningBooking(booking);
    setSelectedDriver(booking.driver_id ? String(booking.driver_id) : '');
  };

  const closeAssign = () => {
    if (savingAssignment) return;

    setAssigningBooking(null);
    setSelectedDriver('');
  };

  const assignDriver = async () => {
    if (!assigningBooking || !selectedDriver) return;

    try {
      setSavingAssignment(true);
      setError('');

      await apiRequest(
        `/bookings/${assigningBooking.booking_id}/assign-driver/`,
        {
          method: 'POST',
          body: {
            driver_id: Number(selectedDriver),
          },
        },
      );

      closeAssign();
      await load(true);
    } catch (e) {
      setError(e.message || 'Unable to assign driver.');
    } finally {
      setSavingAssignment(false);
    }
  };

  const stats = useMemo(() => {
    const boarding = trips.filter((trip) => trip.status === 'boarding').length;

    const activeBookings = bookings.filter(
      (booking) =>
        !['cancelled', 'completed'].includes(
          String(booking.status || '').toLowerCase(),
        ),
    ).length;

    const unassigned = bookings.filter(
      (booking) => !booking.driver_name,
    ).length;

    return {
      trips: trips.length,
      boarding,
      bookings: activeBookings,
      unassigned,
    };
  }, [trips, bookings]);

  const upcomingTrips = useMemo(
    () =>
      [...trips]
        .sort(
          (a, b) =>
            new Date(a.departure_at) - new Date(b.departure_at),
        )
        .slice(0, 8),
    [trips],
  );

  const recentBookings = useMemo(
    () => bookings.slice(0, 8),
    [bookings],
  );

  return (
    <Shell user={user} logout={logout}>
      <main className="operator-main">
        <section className="operator-hero">
          <div>
            <div className="operator-eyebrow">
              <span className="operator-live-dot" />
              LIVE OPERATIONS
            </div>

            <h1>Operations Centre</h1>

            <p>
              Keep today&apos;s departures, boarding activity and passenger
              assignments moving smoothly.
            </p>
          </div>

          <button
            type="button"
            className="operator-refresh"
            onClick={() => load(true)}
            disabled={refreshing}
          >
            <RefreshCw
              size={16}
              className={refreshing ? 'operator-spin' : ''}
            />
            {refreshing ? 'Refreshing…' : 'Refresh'}
          </button>
        </section>

        {error && (
          <div className="operator-alert">
            <CircleAlert size={18} />
            <div>
              <strong>Something needs attention</strong>
              <span>{error}</span>
            </div>
          </div>
        )}

        <section className="operator-stats">
          <div className="operator-stat-card">
            <div className="operator-stat-icon">
              <Bus size={19} />
            </div>

            <div>
              <span>Trips</span>
              <strong>{stats.trips}</strong>
              <small>Company departures</small>
            </div>
          </div>

          <div className="operator-stat-card operator-stat-active">
            <div className="operator-stat-icon">
              <Activity size={19} />
            </div>

            <div>
              <span>Boarding</span>
              <strong>{stats.boarding}</strong>
              <small>Currently boarding</small>
            </div>
          </div>

          <div className="operator-stat-card">
            <div className="operator-stat-icon">
              <Users size={19} />
            </div>

            <div>
              <span>Bookings</span>
              <strong>{stats.bookings}</strong>
              <small>Active passenger bookings</small>
            </div>
          </div>

          <div className="operator-stat-card operator-stat-warning">
            <div className="operator-stat-icon">
              <UserRound size={19} />
            </div>

            <div>
              <span>Needs assignment</span>
              <strong>{stats.unassigned}</strong>
              <small>Bookings without drivers</small>
            </div>
          </div>
        </section>

        <section className="operator-section">
          <div className="operator-section-heading">
            <div>
              <span className="operator-section-kicker">
                DEPARTURES
              </span>
              <h2>Trip operations</h2>
              <p>
                Monitor departures and move trips through their operational
                stages.
              </p>
            </div>

            <div className="operator-section-meta">
              <CalendarDays size={16} />
              <span>{formatShortDate(new Date())}</span>
            </div>
          </div>

          <div className="operator-panel">
            {loading ? (
              <div className="operator-empty">
                <RefreshCw className="operator-spin" size={22} />
                <span>Loading trip operations…</span>
              </div>
            ) : upcomingTrips.length === 0 ? (
              <div className="operator-empty">
                <Bus size={24} />
                <strong>No trips available</strong>
                <span>
                  There are no company trips available to operate.
                </span>
              </div>
            ) : (
              <div className="operator-table-wrap">
                <table className="operator-table">
                  <thead>
                    <tr>
                      <th>Route</th>
                      <th>Departure</th>
                      <th>Driver</th>
                      <th>Status</th>
                      <th>Update</th>
                    </tr>
                  </thead>

                  <tbody>
                    {upcomingTrips.map((trip) => (
                      <tr key={trip.id}>
                        <td>
                          <div className="operator-route">
                            <div className="operator-route-icon">
                              <MapPin size={15} />
                            </div>

                            <div>
                              <strong>
                                {trip.route_details?.name ||
                                  'Route unavailable'}
                              </strong>
                              <span>
                                {trip.route_details?.start_point ||
                                  'Origin'}{' '}
                                <ArrowRight size={12} />{' '}
                                {trip.route_details?.end_point ||
                                  'Destination'}
                              </span>
                            </div>
                          </div>
                        </td>

                        <td>
                          <div className="operator-time">
                            <strong>{formatShortDate(trip.departure_at)}</strong>
                            <span>
                              {new Date(
                                trip.departure_at,
                              ).toLocaleTimeString('en-KE', {
                                hour: '2-digit',
                                minute: '2-digit',
                              })}
                            </span>
                          </div>
                        </td>

                        <td>
                          <div className="operator-driver">
                            <div className="operator-mini-avatar">
                              {(trip.driver_name || 'D')
                                .charAt(0)
                                .toUpperCase()}
                            </div>

                            <span>
                              {trip.driver_name || 'No driver'}
                            </span>
                          </div>
                        </td>

                        <td>
                          <StatusBadge status={trip.status} />
                        </td>

                        <td>
                          <div className="operator-select-wrap">
                            <select
                              className="operator-select"
                              value={trip.status}
                              onChange={(event) =>
                                updateTripStatus(
                                  trip,
                                  event.target.value,
                                )
                              }
                            >
                              <option value="scheduled">Scheduled</option>
                              <option value="boarding">Boarding</option>
                              <option value="departed">Departed</option>
                              <option value="completed">Completed</option>
                              <option value="cancelled">Cancelled</option>
                            </select>

                            <ChevronDown size={14} />
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        </section>

        <section className="operator-section">
          <div className="operator-section-heading">
            <div>
              <span className="operator-section-kicker">
                PASSENGER FLOW
              </span>
              <h2>Booking assignments</h2>
              <p>
                Review passenger bookings and make sure every active booking
                has an assigned driver.
              </p>
            </div>

            <div className="operator-section-meta">
              <WalletCards size={16} />
              <span>{bookings.length} total</span>
            </div>
          </div>

          <div className="operator-panel">
            {loading ? (
              <div className="operator-empty">
                <RefreshCw className="operator-spin" size={22} />
                <span>Loading bookings…</span>
              </div>
            ) : recentBookings.length === 0 ? (
              <div className="operator-empty">
                <CheckCircle2 size={24} />
                <strong>No bookings to display</strong>
                <span>Passenger bookings will appear here.</span>
              </div>
            ) : (
              <div className="operator-booking-list">
                {recentBookings.map((booking) => (
                  <article
                    className="operator-booking"
                    key={booking.booking_id}
                  >
                    <div className="operator-booking-main">
                      <div className="operator-booking-number">
                        {booking.booking_number}
                      </div>

                      <div className="operator-booking-passenger">
                        <div className="operator-mini-avatar">
                          {(booking.user || 'P').charAt(0).toUpperCase()}
                        </div>

                        <div>
                          <strong>{booking.user || 'Passenger'}</strong>
                          <span>{booking.user_phone || 'No phone'}</span>
                        </div>
                      </div>

                      <div className="operator-booking-route">
                        <span>ROUTE</span>
                        <strong>
                          {booking.route_name || 'Route unavailable'}
                        </strong>
                      </div>

                      <div className="operator-booking-payment">
                        <span>PAYMENT</span>
                        <strong>
                          {booking.payment_status || 'Unknown'}
                        </strong>
                      </div>
                    </div>

                    <div className="operator-booking-driver">
                      <div>
                        <span>DRIVER</span>
                        <strong>
                          {booking.driver_name || 'Unassigned'}
                        </strong>
                      </div>

                      <button
                        type="button"
                        className="operator-assign-button"
                        onClick={() => openAssign(booking)}
                      >
                        <UserRound size={15} />
                        {booking.driver_name ? 'Change' : 'Assign'}
                      </button>
                    </div>
                  </article>
                ))}
              </div>
            )}
          </div>
        </section>

        <footer className="operator-footer">
          <div>
            <span className="operator-footer-dot" />
            CONNECT Operations
          </div>

          <span>Company Operator workspace</span>
        </footer>
      </main>

      {assigningBooking && (
        <div className="operator-modal-backdrop" onClick={closeAssign}>
          <div
            className="operator-modal"
            onClick={(event) => event.stopPropagation()}
          >
            <div className="operator-modal-icon">
              <UserRound size={20} />
            </div>

            <div className="operator-modal-heading">
              <span>BOOKING ASSIGNMENT</span>
              <h3>Assign a driver</h3>
              <p>
                Choose a driver for booking{' '}
                <strong>{assigningBooking.booking_number}</strong>.
              </p>
            </div>

            <label className="operator-field">
              <span>Company driver</span>

              <div className="operator-modal-select">
                <select
                  value={selectedDriver}
                  onChange={(event) =>
                    setSelectedDriver(event.target.value)
                  }
                >
                  <option value="">Select a driver</option>

                  {drivers.map((driver) => (
                    <option key={driver.id} value={driver.id}>
                      {driver.name}
                      {driver.bus_number
                        ? ` · ${driver.bus_number}`
                        : ''}
                    </option>
                  ))}
                </select>

                <ChevronDown size={15} />
              </div>
            </label>

            <div className="operator-modal-actions">
              <button
                type="button"
                className="operator-modal-cancel"
                onClick={closeAssign}
                disabled={savingAssignment}
              >
                Cancel
              </button>

              <button
                type="button"
                className="operator-modal-confirm"
                onClick={assignDriver}
                disabled={!selectedDriver || savingAssignment}
              >
                {savingAssignment ? 'Assigning…' : 'Assign driver'}
              </button>
            </div>
          </div>
        </div>
      )}
    </Shell>
  );
}