import { useCallback, useEffect, useState } from 'react';
import { NavLink } from 'react-router-dom';
import {
  Activity,
  BarChart3,
  Bus,
  CalendarDays,
  ClipboardList,
  Gauge,
  Menu,
  Route,
  Settings,
  ShieldCheck,
  Users,
  WalletCards,
} from 'lucide-react';
import { apiRequest } from '../../api';
import { useAuth } from '../../context/AuthContext';

const money = (value) =>
  `KES ${Number(value || 0).toLocaleString('en-KE', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  })}`;

const navigation = [
  { label: 'Overview', icon: Gauge, path: '/company-manager' },
  { label: 'Companies', icon: Bus, path: '/company-manager/companies' },
  { label: 'Routes', icon: Route, path: '/company-manager/routes' },
  { label: 'Trips', icon: CalendarDays, path: '/company-manager/trips' },
  { label: 'Drivers', icon: Users, path: '/company-manager/drivers' },
  { label: 'Operators', icon: ShieldCheck, path: '/company-manager/operators' },
  { label: 'Bookings', icon: ClipboardList, path: '/company-manager/bookings' },
];

const operations = [
  { label: 'Seats & Capacity', icon: Bus, path: '/company-manager/capacity' },
  { label: 'Pricing', icon: WalletCards, path: '/company-manager/pricing' },
  { label: 'Revenue', icon: BarChart3, path: '/company-manager/revenue' },
];

function Sidebar({ open, onClose, user }) {
  const renderLink = ({ label, icon: Icon, path }) => (
    <NavLink
      key={path}
      to={path}
      end={path === '/company-manager'}
      onClick={onClose}
      className={({ isActive }) =>
        `company-nav-link ${isActive ? 'active' : ''}`
      }
    >
      <Icon size={18} />
      <span>{label}</span>
    </NavLink>
  );

  return (
    <>
      {open && (
        <button
          type="button"
          className="company-sidebar-overlay"
          onClick={onClose}
          aria-label="Close menu"
        />
      )}

      <aside className={`company-sidebar ${open ? 'open' : ''}`}>
        <div className="company-brand">
          <div className="company-brand-mark">C</div>

          <div>
            <strong>CONNECT</strong>
            <span>Company Management</span>
          </div>
        </div>

        <div className="company-sidebar-scroll">
          <div className="company-nav-label">OVERVIEW</div>

          {navigation.map(renderLink)}

          <div className="company-nav-label">OPERATIONS</div>

          {operations.map(renderLink)}

          <div className="company-nav-label">SYSTEM</div>

          {renderLink({
            label: 'Settings',
            icon: Settings,
            path: '/company-manager/settings',
          })}
        </div>

        <div className="company-sidebar-user">
          <div className="company-user-avatar">
            {(user?.name || 'U').charAt(0).toUpperCase()}
          </div>

          <div>
            <strong>{user?.name || 'Manager'}</strong>
            <span>Company Manager</span>
          </div>
        </div>
      </aside>
    </>
  );
}

function StatCard({ label, value, icon: Icon, description }) {
  return (
    <div className="company-stat-card">
      <div className="company-stat-top">
        <span>{label}</span>

        <div className="company-stat-icon">
          <Icon size={18} />
        </div>
      </div>

      <strong>{value}</strong>
      <small>{description}</small>
    </div>
  );
}

export default function CompanyManagerOverview() {
  const { user, logout } = useAuth();

  const [sidebarOpen, setSidebarOpen] = useState(false);
  const [companies, setCompanies] = useState([]);
  const [drivers, setDrivers] = useState([]);
  const [trips, setTrips] = useState([]);
  const [bookings, setBookings] = useState([]);
  const [routes, setRoutes] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');

  const load = useCallback(async () => {
    setLoading(true);
    setError('');

    try {
      const [
        companiesData,
        driversData,
        tripsData,
        bookingsData,
        routesData,
      ] = await Promise.all([
        apiRequest('/companies/'),
        apiRequest('/drivers/'),
        apiRequest('/companies/trips/'),
        apiRequest('/bookings/all/'),
        apiRequest('/companies/routes/'),
      ]);

      setCompanies(companiesData || []);
      setDrivers(driversData || []);
      setTrips(tripsData || []);
      setBookings(bookingsData || []);
      setRoutes(routesData || []);
    } catch (err) {
      setError(
        err.message || 'Unable to load company management data.'
      );
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    load();
  }, [load]);

  const activeTrips = trips.filter(
    (trip) => !['completed', 'cancelled'].includes(trip.status)
  ).length;

  const activeBookings = bookings.filter(
    (booking) => !['completed', 'cancelled'].includes(booking.status)
  ).length;

  return (
    <div className="company-management-page">
      <Sidebar
        open={sidebarOpen}
        onClose={() => setSidebarOpen(false)}
        user={user}
      />

      <main className="company-management-main">
        <header className="company-management-topbar">
          <button
            type="button"
            className="company-mobile-menu"
            onClick={() => setSidebarOpen(true)}
          >
            <Menu size={21} />
          </button>

          <div>
            <p className="company-eyebrow">GLOBAL OPERATIONS</p>
            <h1>Company Management</h1>
          </div>

          <div className="company-top-actions">
            <button
              className="company-refresh"
              onClick={load}
              disabled={loading}
            >
              <Activity size={17} />
              {loading ? 'Refreshing...' : 'Refresh'}
            </button>

            <button
              className="company-logout"
              onClick={logout}
            >
              Logout
            </button>
          </div>
        </header>

        <section className="company-content">
          <div className="company-hero">
            <p className="company-eyebrow">
              CONNECT CONTROL CENTRE
            </p>

            <h2>Everything in one place.</h2>

            <p>
              Monitor companies, routes, trips, drivers,
              operators and bookings across the CONNECT network.
            </p>
          </div>

          {error && (
            <div className="company-error">
              {error}
            </div>
          )}

          {loading ? (
            <div className="company-loading">
              Loading management data...
            </div>
          ) : (
            <>
              <section className="company-stats-grid">
                <StatCard
                  label="Companies"
                  value={companies.length}
                  description="Registered operators"
                  icon={Bus}
                />

                <StatCard
                  label="Routes"
                  value={routes.length}
                  description="Network routes"
                  icon={Route}
                />

                <StatCard
                  label="Trips"
                  value={trips.length}
                  description={`${activeTrips} currently active`}
                  icon={CalendarDays}
                />

                <StatCard
                  label="Drivers"
                  value={drivers.length}
                  description="Registered drivers"
                  icon={Users}
                />

                <StatCard
                  label="Bookings"
                  value={bookings.length}
                  description={`${activeBookings} active bookings`}
                  icon={ClipboardList}
                />
              </section>

              <section className="company-section-heading">
                <p className="company-eyebrow">
                  NETWORK SNAPSHOT
                </p>

                <h2>Today's operations</h2>
              </section>

              <section className="company-dashboard-grid">
                <div className="company-panel">
                  <div className="company-panel-header">
                    <div>
                      <span className="company-panel-kicker">
                        TRIPS
                      </span>

                      <h3>Latest departures</h3>
                    </div>

                    <span className="company-panel-count">
                      {trips.length}
                    </span>
                  </div>

                  {trips.length === 0 ? (
                    <div className="company-empty">
                      No trips have been created yet.
                    </div>
                  ) : (
                    <div className="company-trip-list">
                      {trips.slice(0, 6).map((trip) => (
                        <div
                          className="company-trip-row"
                          key={trip.id}
                        >
                          <div className="company-trip-icon">
                            <Bus size={17} />
                          </div>

                          <div className="company-trip-info">
                            <strong>
                              {trip.route_details?.name || 'Route'}
                            </strong>

                            <span>
                              {trip.driver_name || 'No driver'}
                              {' · '}
                              Capacity {trip.capacity ?? '—'}
                            </span>
                          </div>

                          <span
                            className={`company-status ${
                              trip.status || ''
                            }`}
                          >
                            {trip.status || 'unknown'}
                          </span>
                        </div>
                      ))}
                    </div>
                  )}
                </div>

                <div className="company-panel">
                  <div className="company-panel-header">
                    <div>
                      <span className="company-panel-kicker">
                        BOOKINGS
                      </span>

                      <h3>Recent activity</h3>
                    </div>

                    <span className="company-panel-count">
                      {bookings.length}
                    </span>
                  </div>

                  {bookings.length === 0 ? (
                    <div className="company-empty">
                      No bookings yet.
                    </div>
                  ) : (
                    <div className="company-booking-list">
                      {bookings.slice(0, 6).map((booking) => (
                        <div
                          className="company-booking-row"
                          key={booking.booking_id}
                        >
                          <div>
                            <strong>
                              {booking.booking_number}
                            </strong>

                            <span>
                              {booking.user || 'Passenger'}
                            </span>
                          </div>

                          <div>
                            <strong>
                              {money(booking.total_amount)}
                            </strong>

                            <span>
                              {booking.status ||
                                booking.payment_status ||
                                '—'}
                            </span>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </section>
            </>
          )}
        </section>
      </main>
    </div>
  );
