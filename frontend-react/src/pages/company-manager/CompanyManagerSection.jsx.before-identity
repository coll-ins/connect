import { useCallback, useEffect, useState } from 'react';
import { NavLink } from 'react-router-dom';
import {
  ArrowLeft,
  Bus,
  CalendarDays,
  CheckCircle2,
  ClipboardList,
  Edit3,
  Plus,
  Route,
  Save,
  ShieldCheck,
  Trash2,
  Users,
  WalletCards,
  X,
} from 'lucide-react';
import { apiRequest } from '../../api';
import { useAuth } from '../../context/AuthContext';

const money = (value) =>
  `KES ${Number(value || 0).toLocaleString('en-KE', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  })}`;

const formatDate = (value) =>
  value
    ? new Date(value).toLocaleString('en-KE', {
        dateStyle: 'medium',
        timeStyle: 'short',
      })
    : '—';

const sectionConfig = {
  company: {
    title: 'Company Profile',
    description: 'View your company information and operational identity.',
    icon: Bus,
  },
  routes: {
    title: 'Routes',
    description: 'Create and maintain routes operated by your company.',
    icon: Route,
  },
  trips: {
    title: 'Trips',
    description: 'Create departures and control your daily operations.',
    icon: CalendarDays,
  },
  drivers: {
    title: 'Drivers',
    description: 'Manage the drivers and vehicles belonging to your company.',
    icon: Users,
  },
  operators: {
    title: 'Operators',
    description: 'Manage staff accounts belonging to your company.',
    icon: ShieldCheck,
  },
  bookings: {
    title: 'Bookings',
    description: 'Monitor your passengers and manage their bookings.',
    icon: ClipboardList,
  },
  capacity: {
    title: 'Seats & Capacity',
    description: 'Monitor scheduled seats and passenger occupancy.',
    icon: Bus,
  },
  pricing: {
    title: 'Pricing',
    description: 'Manage the prices of your company routes.',
    icon: WalletCards,
  },
  revenue: {
    title: 'Revenue',
    description: 'Review revenue generated by your company.',
    icon: WalletCards,
  },
  settings: {
    title: 'Settings',
    description: 'Company management settings.',
    icon: ShieldCheck,
  },
};

const navItems = [
  ['Company Profile', '/company-manager/companies', Bus],
  ['Routes', '/company-manager/routes', Route],
  ['Trips', '/company-manager/trips', CalendarDays],
  ['Drivers', '/company-manager/drivers', Users],
  ['Operators', '/company-manager/operators', ShieldCheck],
  ['Bookings', '/company-manager/bookings', ClipboardList],
  ['Seats & Capacity', '/company-manager/capacity', Bus],
  ['Pricing', '/company-manager/pricing', WalletCards],
  ['Revenue', '/company-manager/revenue', WalletCards],
];

function Input({ label, ...props }) {
  return (
    <label className="company-field">
      <span>{label}</span>
      <input {...props} />
    </label>
  );
}

function Select({ label, children, ...props }) {
  return (
    <label className="company-field">
      <span>{label}</span>
      <select {...props}>{children}</select>
    </label>
  );
}

function Modal({ title, children, onClose }) {
  return (
    <div className="company-modal-backdrop">
      <div className="company-modal">
        <div className="company-modal-header">
          <h3>{title}</h3>
          <button onClick={onClose} className="company-icon-button">
            <X size={19} />
          </button>
        </div>
        {children}
      </div>
    </div>
  );
}

function Sidebar() {
  return (
    <aside className="company-sidebar">
      <div className="company-brand">
        <div className="company-brand-mark">C</div>
        <div>
          <strong>CONNECT</strong>
          <span>Company Operations</span>
        </div>
      </div>

      <div className="company-nav-label">MANAGEMENT</div>

      <NavLink to="/company-manager" className="company-nav-link">
        <ArrowLeft size={18} />
        <span>Overview</span>
      </NavLink>

      {navItems.slice(0, 6).map(([label, path, Icon]) => (
        <NavLink
          key={path}
          to={path}
          className={({ isActive }) =>
            `company-nav-link ${isActive ? 'active' : ''}`
          }
        >
          <Icon size={18} />
          <span>{label}</span>
        </NavLink>
      ))}

      <div className="company-nav-label">OPERATIONS</div>

      {navItems.slice(6).map(([label, path, Icon]) => (
        <NavLink
          key={path}
          to={path}
          className={({ isActive }) =>
            `company-nav-link ${isActive ? 'active' : ''}`
          }
        >
          <Icon size={18} />
          <span>{label}</span>
        </NavLink>
      ))}

      <div className="company-nav-label">SYSTEM</div>

      <NavLink to="/company-manager/settings" className="company-nav-link">
        <ShieldCheck size={18} />
        <span>Settings</span>
      </NavLink>
    </aside>
  );
}

export default function CompanyManagerSection({ section }) {
  const { user } = useAuth();
  const companyId = user?.company_id;
  const config = sectionConfig[section] || sectionConfig.settings;
  const Icon = config.icon;

  const [data, setData] = useState([]);
  const [analytics, setAnalytics] = useState(null);
  const [company, setCompany] = useState(null);
  const [drivers, setDrivers] = useState([]);
  const [routes, setRoutes] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [message, setMessage] = useState('');
  const [modal, setModal] = useState(null);
  const [editing, setEditing] = useState(null);

  const [routeForm, setRouteForm] = useState({
    name: '',
    start_point: '',
    end_point: '',
    price: '',
  });

  const [tripForm, setTripForm] = useState({
    route_id: '',
    driver_id: '',
    departure_at: '',
    capacity: 30,
  });

  const [driverForm, setDriverForm] = useState({
    name: '',
    phone_number: '',
    bus_number: '',
  });

  const [operatorForm, setOperatorForm] = useState({
    username: '',
    email: '',
    phone_number: '',
    role: 'company_operator',
    password: '',
  });

  const load = useCallback(async () => {
    if (!companyId) {
      setError('This account is not linked to a company.');
      setLoading(false);
      return;
    }

    setLoading(true);
    setError('');

    try {
      if (section === 'company') {
        const [companies, analyticsData] = await Promise.all([
          apiRequest('/companies/'),
          apiRequest(`/companies/${companyId}/analytics/`),
        ]);

        setCompany(
          (companies || []).find(
            (item) => Number(item.id) === Number(companyId)
          ) || null
        );
        setAnalytics(analyticsData);
      }

      if (section === 'routes' || section === 'pricing') {
        const result = await apiRequest(
          `/companies/${companyId}/routes/`
        );
        setData(result || []);
      }

      if (
        section === 'trips' ||
        section === 'capacity'
      ) {
        const result = await apiRequest(
          `/companies/${companyId}/trips/`
        );
        setData(result || []);

        const routeData = await apiRequest(
          `/companies/${companyId}/routes/`
        );
        setRoutes(routeData || []);

        const driverData = await apiRequest(
          `/drivers/?company_id=${companyId}`
        );
        setDrivers(driverData || []);
      }

      if (section === 'drivers') {
        const result = await apiRequest(
          `/drivers/?company_id=${companyId}`
        );
        setData(result || []);
      }

      if (section === 'operators') {
        const result = await apiRequest('/users/company-staff/');
        setData(
          (result || []).filter(
            (item) => Number(item.company) === Number(companyId)
          )
        );
      }

      if (section === 'bookings') {
        const result = await apiRequest(
          `/bookings/all/?company_id=${companyId}`
        );
        setData(result || []);
      }

      if (section === 'revenue') {
        const result = await apiRequest(
          `/companies/${companyId}/analytics/`
        );
        setAnalytics(result);
      }
    } catch (err) {
      setError(err.message || 'Unable to load this section.');
    } finally {
      setLoading(false);
    }
  }, [companyId, section]);

  useEffect(() => {
    load();
  }, [load]);

  const closeModal = () => {
    setModal(null);
    setEditing(null);
  };

  const createRoute = async (event) => {
    event.preventDefault();

    try {
      await apiRequest('/companies/routes/create/', {
        method: 'POST',
        body: {
          company_id: companyId,
          ...routeForm,
          price: Number(routeForm.price),
        },
      });

      setMessage('Route created successfully.');
      closeModal();
      setRouteForm({
        name: '',
        start_point: '',
        end_point: '',
        price: '',
      });
      load();
    } catch (err) {
      setError(err.message);
    }
  };

  const updateRoute = async (event) => {
    event.preventDefault();

    try {
      await apiRequest(`/companies/routes/${editing.id}/`, {
        method: 'PATCH',
        body: {
          ...routeForm,
          price: Number(routeForm.price),
        },
      });

      setMessage('Route updated successfully.');
      closeModal();
      load();
    } catch (err) {
      setError(err.message);
    }
  };

  const deleteRoute = async (route) => {
    if (!window.confirm(`Delete ${route.name}?`)) return;

    try {
      await apiRequest(`/companies/routes/${route.id}/`, {
        method: 'DELETE',
      });

      setMessage('Route deleted.');
      load();
    } catch (err) {
      setError(err.message);
    }
  };

  const createTrip = async (event) => {
    event.preventDefault();

    try {
      await apiRequest('/companies/trips/create/', {
        method: 'POST',
        body: {
          company_id: companyId,
          route_id: Number(tripForm.route_id),
          driver_id: Number(tripForm.driver_id),
          departure_at: new Date(
            tripForm.departure_at
          ).toISOString(),
          capacity: Number(tripForm.capacity),
        },
      });

      setMessage('Trip created successfully.');
      closeModal();
      load();
    } catch (err) {
      setError(err.message);
    }
  };

  const changeTripStatus = async (trip, status) => {
    try {
      await apiRequest(
        `/companies/trips/${trip.id}/status/`,
        {
          method: 'POST',
          body: { status },
        }
      );

      setMessage('Trip status updated.');
      load();
    } catch (err) {
      setError(err.message);
    }
  };

  const saveDriver = async (event) => {
    event.preventDefault();

    try {
      if (editing) {
        await apiRequest(`/drivers/${editing.id}/`, {
          method: 'PATCH',
          body: driverForm,
        });
        setMessage('Driver updated successfully.');
      } else {
        await apiRequest('/drivers/', {
          method: 'POST',
          body: {
            ...driverForm,
            company: companyId,
          },
        });
        setMessage('Driver added successfully.');
      }

      closeModal();
      load();
    } catch (err) {
      setError(err.message);
    }
  };

  const deleteDriver = async (driver) => {
    if (!window.confirm(`Delete ${driver.name}?`)) return;

    try {
      await apiRequest(`/drivers/${driver.id}/`, {
        method: 'DELETE',
      });

      setMessage('Driver deleted.');
      load();
    } catch (err) {
      setError(err.message);
    }
  };

  const saveOperator = async (event) => {
    event.preventDefault();

    try {
      if (editing) {
        await apiRequest(`/users/company-staff/${editing.id}/`, {
          method: 'PATCH',
          body: operatorForm,
        });
        setMessage('Operator updated successfully.');
      } else {
        await apiRequest('/users/company-staff/', {
          method: 'POST',
          body: {
            ...operatorForm,
            company: companyId,
          },
        });
        setMessage('Operator created successfully.');
      }

      closeModal();
      load();
    } catch (err) {
      setError(err.message);
    }
  };

  const deleteOperator = async (operator) => {
    if (!window.confirm(`Remove ${operator.username}?`)) return;

    try {
      await apiRequest(
        `/users/company-staff/${operator.id}/`,
        { method: 'DELETE' }
      );

      setMessage('Operator removed.');
      load();
    } catch (err) {
      setError(err.message);
    }
  };

  const assignDriver = async (booking) => {
    const driverId = window.prompt(
      'Enter the ID of the company driver:',
      drivers[0]?.id || ''
    );

    if (!driverId) return;

    try {
      await apiRequest(
        `/bookings/${booking.booking_id}/assign-driver/`,
        {
          method: 'POST',
          body: { driver_id: Number(driverId) },
        }
      );

      setMessage('Driver assigned.');
      load();
    } catch (err) {
      setError(err.message);
    }
  };

  const openRoute = (route) => {
    setEditing(route);
    setRouteForm({
      name: route.name || '',
      start_point: route.start_point || '',
      end_point: route.end_point || '',
      price: route.price || '',
    });
    setModal('route');
  };

  const openDriver = (driver) => {
    setEditing(driver);
    setDriverForm({
      name: driver.name || '',
      phone_number: driver.phone_number || '',
      bus_number: driver.bus_number || '',
    });
    setModal('driver');
  };

  const openOperator = (operator) => {
    setEditing(operator);
    setOperatorForm({
      username: operator.username || '',
      email: operator.email || '',
      phone_number: operator.phone_number || '',
      role: operator.role || 'company_operator',
      password: '',
    });
    setModal('operator');
  };

  const renderHeader = () => (
    <div className="company-section-header">
      <div className="company-section-title">
        <div className="company-section-icon">
          <Icon size={24} />
        </div>

        <div>
          <p className="company-eyebrow">YOUR COMPANY</p>
          <h1>{config.title}</h1>
          <p>{config.description}</p>
        </div>
      </div>

      {['routes', 'trips', 'drivers', 'operators'].includes(section) && (
        <button
          className="company-primary-button"
          onClick={() => {
            setEditing(null);

            if (section === 'routes') {
              setRouteForm({
                name: '',
                start_point: '',
                end_point: '',
                price: '',
              });
              setModal('route');
            }

            if (section === 'trips') {
              setTripForm({
                route_id: '',
                driver_id: '',
                departure_at: '',
                capacity: 30,
              });
              setModal('trip');
            }

            if (section === 'drivers') {
              setDriverForm({
                name: '',
                phone_number: '',
                bus_number: '',
              });
              setModal('driver');
            }

            if (section === 'operators') {
              setOperatorForm({
                username: '',
                email: '',
                phone_number: '',
                role: 'company_operator',
                password: '',
              });
              setModal('operator');
            }
          }}
        >
          <Plus size={18} />
          {section === 'routes' && 'Create Route'}
          {section === 'trips' && 'Create Trip'}
          {section === 'drivers' && 'Add Driver'}
          {section === 'operators' && 'Add Operator'}
        </button>
      )}
    </div>
  );

  return (
    <div className="company-management-page">
      <Sidebar />

      <main className="company-management-main">
        <section className="company-content">
          {renderHeader()}

          {error && (
            <div className="company-error">
              {error}
              <button onClick={() => setError('')}>
                <X size={16} />
              </button>
            </div>
          )}

          {message && (
            <div className="company-success">
              <CheckCircle2 size={18} />
              {message}
              <button onClick={() => setMessage('')}>
                <X size={16} />
              </button>
            </div>
          )}

          {loading ? (
            <div className="company-loading">
              Loading {config.title.toLowerCase()}...
            </div>
          ) : (
            <>
              {section === 'company' && company && (
                <div className="company-profile-grid">
                  <div className="company-panel company-profile-main">
                    <span className="company-panel-kicker">
                      COMPANY PROFILE
                    </span>
                    <h2>{company.name}</h2>
                    <p>{company.description || 'No description provided.'}</p>

                    <div className="company-profile-details">
                      <div>
                        <span>Phone</span>
                        <strong>{company.phone_number || '—'}</strong>
                      </div>

                      <div>
                        <span>Areas served</span>
                        <strong>{company.areas_served || '—'}</strong>
                      </div>
                    </div>
                  </div>

                  <div className="company-panel">
                    <span className="company-panel-kicker">
                      COMPANY SUMMARY
                    </span>

                    <div className="company-mini-stat">
                      <Route size={19} />
                      <div>
                        <span>Routes</span>
                        <strong>{analytics?.total_routes ?? 0}</strong>
                      </div>
                    </div>

                    <div className="company-mini-stat">
                      <CalendarDays size={19} />
                      <div>
                        <span>Trips</span>
                        <strong>{analytics?.total_trips ?? 0}</strong>
                      </div>
                    </div>

                    <div className="company-mini-stat">
                      <WalletCards size={19} />
                      <div>
                        <span>Settled revenue</span>
                        <strong>
                          {money(analytics?.total_revenue_settled)}
                        </strong>
                      </div>
                    </div>
                  </div>
                </div>
              )}

              {(section === 'routes' || section === 'pricing') && (
                <div className="company-card-grid">
                  {data.map((route) => (
                    <div className="company-record-card" key={route.id}>
                      <div className="company-record-icon">
                        <Route size={21} />
                      </div>

                      <div className="company-record-main">
                        <strong>{route.name}</strong>
                        <span>
                          {route.start_point} → {route.end_point}
                        </span>
                      </div>

                      <div className="company-price">
                        {money(route.price)}
                      </div>

                      <div className="company-card-actions">
                        <button
                          onClick={() => openRoute(route)}
                          className="company-secondary-button"
                        >
                          <Edit3 size={15} />
                          Edit
                        </button>

                        <button
                          onClick={() => deleteRoute(route)}
                          className="company-danger-button"
                        >
                          <Trash2 size={15} />
                        </button>
                      </div>
                    </div>
                  ))}
                </div>
              )}

              {section === 'trips' && (
                <div className="company-card-grid">
                  {data.map((trip) => (
                    <div className="company-record-card" key={trip.id}>
                      <div className="company-record-icon">
                        <CalendarDays size={21} />
                      </div>

                      <div className="company-record-main">
                        <strong>
                          {trip.route_details?.name || 'Route'}
                        </strong>
                        <span>
                          {formatDate(trip.departure_at)}
                          {' · '}
                          {trip.driver_name || 'No driver'}
                        </span>
                      </div>

                      <div>
                        <strong>{trip.capacity}</strong>
                        <span className="company-record-sub">
                          seats
                        </span>
                      </div>

                      <Select
                        value={trip.status}
                        onChange={(event) =>
                          changeTripStatus(
                            trip,
                            event.target.value
                          )
                        }
                      >
                        <option value="scheduled">Scheduled</option>
                        <option value="boarding">Boarding</option>
                        <option value="departed">Departed</option>
                        <option value="completed">Completed</option>
                        <option value="cancelled">Cancelled</option>
                      </Select>
                    </div>
                  ))}
                </div>
              )}

              {section === 'drivers' && (
                <div className="company-card-grid">
                  {data.map((driver) => (
                    <div className="company-record-card" key={driver.id}>
                      <div className="company-record-icon">
                        <Users size={21} />
                      </div>

                      <div className="company-record-main">
                        <strong>{driver.name}</strong>
                        <span>
                          {driver.phone_number} · Bus {driver.bus_number}
                        </span>
                      </div>

                      <span
                        className={`company-status ${
                          driver.is_available
                            ? 'available'
                            : 'unavailable'
                        }`}
                      >
                        {driver.is_available
                          ? 'Available'
                          : 'Unavailable'}
                      </span>

                      <div className="company-card-actions">
                        <button
                          onClick={() => openDriver(driver)}
                          className="company-secondary-button"
                        >
                          <Edit3 size={15} />
                          Edit
                        </button>

                        <button
                          onClick={() => deleteDriver(driver)}
                          className="company-danger-button"
                        >
                          <Trash2 size={15} />
                        </button>
                      </div>
                    </div>
                  ))}
                </div>
              )}

              {section === 'operators' && (
                <div className="company-card-grid">
                  {data.map((operator) => (
                    <div className="company-record-card" key={operator.id}>
                      <div className="company-record-icon">
                        <ShieldCheck size={21} />
                      </div>

                      <div className="company-record-main">
                        <strong>{operator.username}</strong>
                        <span>
                          {operator.email || operator.phone_number || 'No contact'}
                        </span>
                      </div>

                      <span className="company-status available">
                        {operator.role}
                      </span>

                      <div className="company-card-actions">
                        <button
                          onClick={() => openOperator(operator)}
                          className="company-secondary-button"
                        >
                          <Edit3 size={15} />
                          Edit
                        </button>

                        <button
                          onClick={() => deleteOperator(operator)}
                          className="company-danger-button"
                        >
                          <Trash2 size={15} />
                        </button>
                      </div>
                    </div>
                  ))}
                </div>
              )}

              {section === 'bookings' && (
                <div className="company-card-grid">
                  {data.map((booking) => (
                    <div
                      className="company-record-card"
                      key={booking.booking_id}
                    >
                      <div className="company-record-icon">
                        <ClipboardList size={21} />
                      </div>

                      <div className="company-record-main">
                        <strong>{booking.booking_number}</strong>
                        <span>
                          {booking.user || 'Passenger'} ·{' '}
                          {booking.route_name || 'Route'}
                        </span>
                      </div>

                      <div>
                        <strong>
                          {money(
                            booking.total_amount ||
                              booking.amount ||
                              booking.fare
                          )}
                        </strong>
                        <span className="company-record-sub">
                          {booking.payment_status || 'Pending'}
                        </span>
                      </div>

                      <button
                        className="company-secondary-button"
                        onClick={() => assignDriver(booking)}
                      >
                        Assign Driver
                      </button>
                    </div>
                  ))}
                </div>
              )}

              {section === 'capacity' && (
                <div className="company-capacity-grid">
                  {data.map((trip) => {
                    const booked = Number(
                      trip.booked_seats || trip.seats_booked || 0
                    );
                    const capacity = Number(trip.capacity || 0);
                    const percentage = capacity
                      ? Math.min(100, (booked / capacity) * 100)
                      : 0;

                    return (
                      <div className="company-capacity-card" key={trip.id}>
                        <div>
                          <span className="company-panel-kicker">
                            {trip.status}
                          </span>

                          <h3>
                            {trip.route_details?.name || 'Trip'}
                          </h3>

                          <p>{formatDate(trip.departure_at)}</p>
                        </div>

                        <strong>
                          {booked} / {capacity}
                        </strong>

                        <div className="company-capacity-bar">
                          <div style={{ width: `${percentage}%` }} />
                        </div>

                        <span>{Math.round(percentage)}% occupied</span>
                      </div>
                    );
                  })}
                </div>
              )}

              {section === 'revenue' && (
                <div className="company-revenue-dashboard">
                  <div className="company-revenue-main">
                    <span>SETTLED REVENUE</span>
                    <strong>
                      {money(analytics?.total_revenue_settled)}
                    </strong>
                    <p>
                      Revenue settled for your company according to the
                      existing company analytics service.
                    </p>
                  </div>

                  <div className="company-revenue-side">
                    <WalletCards size={30} />
                    <span>Company financials</span>
                    <strong>Company-scoped</strong>
                  </div>
                </div>
              )}

              {['settings'].includes(section) && (
                <div className="company-panel">
                  <span className="company-panel-kicker">
                    SETTINGS
                  </span>
                  <h2>Company management settings</h2>
                  <p>
                    Your company settings and permissions are controlled
                    through the authenticated company account.
                  </p>
                </div>
              )}

              {data.length === 0 &&
                ['routes', 'pricing', 'trips', 'drivers', 'operators', 'bookings', 'capacity'].includes(section) && (
                  <div className="company-empty">
                    <Icon size={30} />
                    <strong>No records yet</strong>
                    <span>
                      Use the action button above to add your first record.
                    </span>
                  </div>
                )}
            </>
          )}
        </section>
      </main>

      {modal === 'route' && (
        <Modal
          title={editing ? 'Edit Route' : 'Create Route'}
          onClose={closeModal}
        >
          <form onSubmit={editing ? updateRoute : createRoute}>
            <Input
              label="Route name"
              value={routeForm.name}
              onChange={(e) =>
                setRouteForm({
                  ...routeForm,
                  name: e.target.value,
                })
              }
              placeholder="CBD to Rongai"
              required
            />

            <div className="company-form-grid">
              <Input
                label="Starting point"
                value={routeForm.start_point}
                onChange={(e) =>
                  setRouteForm({
                    ...routeForm,
                    start_point: e.target.value,
                  })
                }
                required
              />

              <Input
                label="Destination"
                value={routeForm.end_point}
                onChange={(e) =>
                  setRouteForm({
                    ...routeForm,
                    end_point: e.target.value,
                  })
                }
                required
              />
            </div>

            <Input
              label="Price (KES)"
              type="number"
              min="0"
              value={routeForm.price}
              onChange={(e) =>
                setRouteForm({
                  ...routeForm,
                  price: e.target.value,
                })
              }
              required
            />

            <button className="company-primary-button" type="submit">
              <Save size={17} />
              {editing ? 'Save Changes' : 'Create Route'}
            </button>
          </form>
        </Modal>
      )}

      {modal === 'trip' && (
        <Modal title="Create Trip" onClose={closeModal}>
          <form onSubmit={createTrip}>
            <Select
              label="Route"
              value={tripForm.route_id}
              onChange={(e) =>
                setTripForm({
                  ...tripForm,
                  route_id: e.target.value,
                })
              }
              required
            >
              <option value="">Select route</option>
              {routes.map((route) => (
                <option key={route.id} value={route.id}>
                  {route.name}
                </option>
              ))}
            </Select>

            <Select
              label="Driver"
              value={tripForm.driver_id}
              onChange={(e) =>
                setTripForm({
                  ...tripForm,
                  driver_id: e.target.value,
                })
              }
              required
            >
              <option value="">Select driver</option>
              {drivers.map((driver) => (
                <option key={driver.id} value={driver.id}>
                  {driver.name} · {driver.bus_number}
                </option>
              ))}
            </Select>

            <Input
              label="Departure"
              type="datetime-local"
              value={tripForm.departure_at}
              onChange={(e) =>
                setTripForm({
                  ...tripForm,
                  departure_at: e.target.value,
                })
              }
              required
            />

            <Input
              label="Seat capacity"
              type="number"
              min="1"
              max="100"
              value={tripForm.capacity}
              onChange={(e) =>
                setTripForm({
                  ...tripForm,
                  capacity: e.target.value,
                })
              }
              required
            />

            <button className="company-primary-button" type="submit">
              <CalendarDays size={17} />
              Create Trip
            </button>
          </form>
        </Modal>
      )}

      {modal === 'driver' && (
        <Modal
          title={editing ? 'Edit Driver' : 'Add Driver'}
          onClose={closeModal}
        >
          <form onSubmit={saveDriver}>
            <Input
              label="Driver name"
              value={driverForm.name}
              onChange={(e) =>
                setDriverForm({
                  ...driverForm,
                  name: e.target.value,
                })
              }
              required
            />

            <Input
              label="Phone number"
              value={driverForm.phone_number}
              onChange={(e) =>
                setDriverForm({
                  ...driverForm,
                  phone_number: e.target.value,
                })
              }
              required
            />

            <Input
              label="Bus number"
              value={driverForm.bus_number}
              onChange={(e) =>
                setDriverForm({
                  ...driverForm,
                  bus_number: e.target.value,
                })
              }
              required
            />

            <button className="company-primary-button" type="submit">
              <Save size={17} />
              {editing ? 'Save Driver' : 'Add Driver'}
            </button>
          </form>
        </Modal>
      )}

      {modal === 'operator' && (
        <Modal
          title={editing ? 'Edit Operator' : 'Add Operator'}
          onClose={closeModal}
        >
          <form onSubmit={saveOperator}>
            <Input
              label="Username"
              value={operatorForm.username}
              onChange={(e) =>
                setOperatorForm({
                  ...operatorForm,
                  username: e.target.value,
                })
              }
              required
            />

            <Input
              label="Email"
              type="email"
              value={operatorForm.email}
              onChange={(e) =>
                setOperatorForm({
                  ...operatorForm,
                  email: e.target.value,
                })
              }
            />

            <Input
              label="Phone number"
              value={operatorForm.phone_number}
              onChange={(e) =>
                setOperatorForm({
                  ...operatorForm,
                  phone_number: e.target.value,
                })
              }
            />

            <Select
              label="Role"
              value={operatorForm.role}
              onChange={(e) =>
                setOperatorForm({
                  ...operatorForm,
                  role: e.target.value,
                })
              }
            >
              <option value="company_operator">Company Operator</option>
              <option value="company_auditor">Company Auditor</option>
              <option value="company_manager">Company Manager</option>
            </Select>

            {!editing && (
              <Input
                label="Password"
                type="password"
                value={operatorForm.password}
                onChange={(e) =>
                  setOperatorForm({
                    ...operatorForm,
                    password: e.target.value,
                  })
                }
                minLength="6"
                required
              />
            )}

            <button className="company-primary-button" type="submit">
              <ShieldCheck size={17} />
              {editing ? 'Save Operator' : 'Create Operator'}
            </button>
          </form>
        </Modal>
      )}
    </div>
  );
}