function Passengers({ bookings }) {
  const passengers = useMemo(() => {
    const map = new Map();

    bookings.forEach((b) => {
      const key = b.user || b.user_phone || b.booking_id;

      if (!map.has(key)) {
        map.set(key, {
          user: b.user || '—',
          phone: b.user_phone || '—',
          bookings: 0,
          failed: 0,
          confirmed: 0,
        });
      }

      const p = map.get(key);
      p.bookings += 1;

      if (b.payment_status === 'failed') p.failed += 1;
      if (b.payment_status === 'confirmed') p.confirmed += 1;
    });

    return [...map.values()];
  }, [bookings]);

  return (
    <>
      <SectionHeader
        eyebrow="PASSENGER AUDIT"
        title="Passengers"
        description="Review passenger activity through company booking and payment records."
        icon={UserRound}
      />

      <section className="audit-panel">
        <div className="audit-panel-head">
          <div>
            <h2>Passenger register</h2>
            <p>Grouped from company booking records.</p>
          </div>
          <UserRound size={19} />
        </div>

        <DataTable>
          <thead>
            <tr>
              <th>Passenger</th>
              <th>Phone</th>
              <th>Bookings</th>
              <th>Confirmed payments</th>
              <th>Failed payments</th>
            </tr>
          </thead>

          <tbody>
            {passengers.map((p) => (
              <tr key={`${p.user}-${p.phone}`}>
                <td><strong>{p.user}</strong></td>
                <td>{p.phone}</td>
                <td>{p.bookings}</td>
                <td>{p.confirmed}</td>
                <td>{p.failed}</td>
              </tr>
            ))}
          </tbody>
        </DataTable>
      </section>
    </>
  );
}

