function SearchPage() {
  const [query, setQuery] = useState('');
  const [results, setResults] = useState([]);
  const [selected, setSelected] = useState(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');

  async function submit(e) {
    e.preventDefault();

    if (!query.trim()) {
      setError('Enter something to search.');
      return;
    }

    setLoading(true);
    setError('');

    try {
      const data = await apiRequest(
        `/bookings/auditor/receipts/?search=${encodeURIComponent(query.trim())}`
      );

      setResults(Array.isArray(data) ? data : []);
      setSelected(data?.[0] || null);

      if (!data?.length) setError('No matching records found.');
    } catch (err) {
      setError(err.message || 'Search failed.');
      setResults([]);
      setSelected(null);
    } finally {
      setLoading(false);
    }
  }

  return (
    <>
      <SectionHeader
        eyebrow="INVESTIGATION"
        title="Search"
        description="Search the company's audit records from one place."
        icon={Search}
      />

      <section className="audit-panel">
        <form className="audit-search-form" onSubmit={submit}>
          <Search size={18} />
          <input
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            placeholder="Receipt, booking, payment reference, username or phone"
          />
          <button disabled={loading}>
            {loading ? 'Searching…' : 'Search'}
          </button>
        </form>

        {error && <div className="audit-search-error">{error}</div>}
      </section>

      {results.length > 0 && (
        <section className="audit-panel audit-search-results">
          <div className="audit-panel-head">
            <div>
              <h2>Matching records</h2>
              <p>{results.length} result(s)</p>
            </div>
            <Receipt size={19} />
          </div>

          <div className="audit-search-list">
            {results.map((record) => (
              <button
                key={record.booking_id}
                className={
                  selected?.booking_id === record.booking_id
                    ? 'selected'
                    : ''
                }
                onClick={() => setSelected(record)}
              >
                <div>
                  <strong>{record.booking_number}</strong>
                  <span>{record.passenger?.name || record.passenger?.username}</span>
                </div>

                <Status value={record.payment?.status} />
              </button>
            ))}
          </div>

          {selected && (
            <div className="audit-investigation">
              <div className="audit-investigation-grid">
                <div>
                  <span>Passenger</span>
                  <strong>{selected.passenger?.name || '—'}</strong>
                </div>
                <div>
                  <span>Phone</span>
                  <strong>{selected.passenger?.phone_number || '—'}</strong>
                </div>
                <div>
                  <span>Route</span>
                  <strong>{selected.trip?.route || '—'}</strong>
                </div>
                <div>
                  <span>Amount</span>
                  <strong>{money(selected.payment?.amount)}</strong>
                </div>
                <div>
                  <span>Payment</span>
                  <strong><Status value={selected.payment?.status} /></strong>
                </div>
                <div>
                  <span>Reference</span>
                  <strong>{selected.payment?.provider_reference || '—'}</strong>
                </div>
              </div>

              <div className="audit-timeline">
                <h3>Recorded timeline</h3>

                {(selected.activity || []).map((event, index) => (
                  <div className="audit-event" key={`${event.type}-${index}`}>
                    <div />
                    <section>
                      <strong>{event.label}</strong>
                      <time>{date(event.timestamp)}</time>
                      <p>{event.details || 'Recorded event.'}</p>
                    </section>
                  </div>
                ))}
              </div>
            </div>
          )}
        </section>
      )}
    </>
  );
}

