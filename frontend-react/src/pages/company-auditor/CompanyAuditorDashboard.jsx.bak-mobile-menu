const money = (value) =>
  `KES ${Number(value || 0).toLocaleString('en-KE', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  })}`;

const date = (value) =>
  value
    ? new Date(value).toLocaleString('en-KE', {
        dateStyle: 'medium',
        timeStyle: 'short',
      })
    : '—';

const statusClass = (value) => {
  const s = String(value || '').toLowerCase();

  if (['confirmed', 'completed', 'settled', 'processed'].includes(s)) {
    return 'audit-status success';
  }

  if (['failed', 'cancelled', 'refunded', 'no_show'].includes(s)) {
    return 'audit-status danger';
  }

  return 'audit-status neutral';
};

function Status({ value }) {
  return (
    <span className={statusClass(value)}>
      {value || 'Unknown'}
    </span>
  );
}

