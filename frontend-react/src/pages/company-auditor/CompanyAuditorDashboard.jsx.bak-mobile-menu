export default function CompanyAuditorDashboard() {
  const { user, logout } = useAuth();
  const location = useLocation();

  const [analytics, setAnalytics] = useState(null);
  const [trips, setTrips] = useState([]);
  const [bookings, setBookings] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');

  const section = location.pathname
    .replace('/company-auditor', '')
    .replace(/^\/+/, '')
    .split('/')[0] || 'overview';

  useEffect(() => {
    async function loadAuditData() {
      if (!user?.company_id) return;

      setLoading(true);

      try {
        const [analyticsData, tripsData, bookingsData] = await Promise.all([
          apiRequest(`/companies/${user.company_id}/analytics/`),
          apiRequest(`/companies/${user.company_id}/trips/`),
          apiRequest(`/bookings/all/?company_id=${user.company_id}`),
        ]);

        setAnalytics(analyticsData || null);
        setTrips(Array.isArray(tripsData) ? tripsData : []);
        setBookings(Array.isArray(bookingsData) ? bookingsData : []);
      } catch (err) {
        setError(err.message || 'Unable to load audit records.');
      } finally {
        setLoading(false);
      }
    }

    loadAuditData();
  }, [user?.company_id]);

  const content = (() => {
    if (loading) {
      return (
        <div className="audit-loading">
          <ShieldCheck size={28} />
          <span>Loading company audit records…</span>
        </div>
      );
    }

    if (error && section !== 'search') {
      return (
        <div className="audit-error-page">
          <AlertTriangle size={28} />
          <h2>Audit data could not be loaded</h2>
          <p>{error}</p>
        </div>
      );
    }

    switch (section) {
      case 'trips':
        return <Trips trips={trips} />;

      case 'payments':
        return <Payments bookings={bookings} />;

      case 'transactions':
        return <Transactions bookings={bookings} />;

      case 'receipts':
        return (
          <Receipts
            onSearch={() => {
              window.history.pushState({}, '', '/company-auditor/search');
              window.dispatchEvent(new PopStateEvent('popstate'));
            }}
          />
        );

      case 'bookings':
        return <Bookings bookings={bookings} />;

      case 'passengers':
        return <Passengers bookings={bookings} />;

      case 'incidents':
        return <Incidents />;

      case 'reports':
        return (
          <Reports
            analytics={analytics}
            bookings={bookings}
            trips={trips}
          />
        );

      case 'search':
        return <SearchPage />;

      case 'profile':
        return <Profile user={user} />;

      default:
        return (
          <Overview
            analytics={analytics}
            trips={trips}
            bookings={bookings}
          />
        );
    }
  })();

  return (
    <Layout user={user} logout={logout}>
      {content}
    </Layout>
  );
}
