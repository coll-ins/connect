.driver-app {
  min-height: 100vh;
  display: flex;
  background:
    radial-gradient(circle at 80% 0%, rgba(14,165,233,.08), transparent 30%),
    radial-gradient(circle at 20% 20%, rgba(56,189,248,.07), transparent 28%),
    #07111f;
  color: #e8eef7;
}

.driver-sidebar {
  width: 260px;
  min-width: 260px;
  min-height: 100vh;
  position: sticky;
  top: 0;
  display: flex;
  flex-direction: column;
  padding: 24px 16px;
  border-right: 1px solid rgba(255,255,255,.07);
  background: rgba(5,14,27,.78);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
  z-index: 30;
}

.driver-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 4px 10px 22px;
}

.driver-brand-mark {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: rgba(56,189,248,.14);
  color: #38bdf8;
  border: 1px solid rgba(56,189,248,.20);
}

.driver-brand strong,
.driver-brand span {
  display: block;
}

.driver-brand strong {
  font-size: 18px;
  letter-spacing: .08em;
}

.driver-brand span {
  margin-top: 2px;
  color: #718096;
  font-size: 11px;
}

.driver-company-card {
  padding: 15px;
  border: 1px solid rgba(255,255,255,.07);
  border-radius: 16px;
  background: rgba(255,255,255,.035);
  margin-bottom: 25px;
}

.driver-company-card span,
.driver-company-card small {
  display: block;
  color: #718096;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .12em;
}

.driver-company-card strong {
  display: block;
  margin: 7px 0 5px;
  font-size: 14px;
  color: #f5f8fc;
}

.driver-company-card small {
  text-transform: none;
  letter-spacing: 0;
  font-size: 11px;
}

.driver-nav {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.driver-nav-label {
  padding: 0 11px 9px;
  color: #526176;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .14em;
}

.driver-nav-item {
  width: 100%;
  min-height: 44px;
  padding: 0 12px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  gap: 12px;
  color: #8290a5;
  text-decoration: none;
  transition: .2s ease;
}

.driver-nav-item:hover {
  color: #eaf2f8;
  background: rgba(255,255,255,.045);
  transform: translateX(2px);
}

.driver-nav-item-active {
  color: #e0f7ff;
  background:
    linear-gradient(
      90deg,
      rgba(14,165,233,.17),
      rgba(14,165,233,.055)
    );
  box-shadow: inset 2px 0 #38bdf8;
}

.driver-nav-item-active .driver-nav-icon {
  color: #38bdf8;
}

.driver-nav-icon {
  width: 18px;
  text-align: center;
  font-size: 17px;
  color: #64748b;
}

.driver-sidebar-bottom {
  margin-top: auto;
}

.driver-user-card {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 13px 9px;
  border-top: 1px solid rgba(255,255,255,.06);
}

.driver-user-avatar,
.driver-topbar-avatar {
  display: grid;
  place-items: center;
  flex-shrink: 0;
  border-radius: 50%;
  background: linear-gradient(145deg,#163746,#102a37);
  border: 1px solid rgba(56,189,248,.22);
  color: #bae6fd;
  font-weight: 700;
}

.driver-user-avatar {
  width: 36px;
  height: 36px;
  font-size: 13px;
}

.driver-user-card strong,
.driver-user-card span {
  display: block;
}

.driver-user-card strong {
  font-size: 12px;
}

.driver-user-card span {
  margin-top: 2px;
  color: #64748b;
  font-size: 10px;
}

.driver-logout {
  width: 100%;
  height: 40px;
  border: 1px solid rgba(255,255,255,.06);
  border-radius: 11px;
  background: rgba(255,255,255,.025);
  color: #8390a2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  cursor: pointer;
  font: inherit;
  transition: .2s ease;
}

.driver-logout:hover {
  color: #fca5a5;
  border-color: rgba(248,113,113,.2);
  background: rgba(248,113,113,.035);
}

.driver-main {
  flex: 1;
  min-width: 0;
}

.driver-topbar {
  height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 34px;
  border-bottom: 1px solid rgba(255,255,255,.06);
  background: rgba(7,17,31,.68);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  position: sticky;
  top: 0;
  z-index: 20;
}

.driver-topbar-title span,
.driver-topbar-title strong {
  display: block;
}

.driver-topbar-title span {
  color: #526176;
  font-size: 9px;
  letter-spacing: .15em;
  font-weight: 800;
}

.driver-topbar-title strong {
  margin-top: 4px;
  font-size: 14px;
  color: #e7edf5;
}

.driver-topbar-right {
  display: flex;
  align-items: center;
  gap: 22px;
}

.driver-live-indicator {
  display: flex;
  align-items: center;
  gap: 7px;
  color: #9fb0c4;
  font-size: 11px;
}

.driver-live-indicator span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #38bdf8;
  box-shadow: 0 0 0 4px rgba(56,189,248,.09);
}

.driver-topbar-avatar {
  width: 34px;
  height: 34px;
  font-size: 12px;
}

.driver-content {
  padding: 30px 34px;
  min-height: calc(100vh - 76px);
}

.driver-content h1 {
  color: #e8eef7 !important;
}

.driver-content p,
.driver-content [style*="color: #64748b"] {
  color: #91a4b9 !important;
}

@media(max-width:800px) {
  .driver-sidebar {
    width: 230px;
    min-width: 230px;
  }

  .driver-topbar {
    padding: 0 20px;
  }

  .driver-content {
    padding: 24px 20px;
  }
}

@media(max-width:600px) {
  .driver-app {
    display: block;
  }

  .driver-sidebar {
    position: relative;
    width: 100%;
    min-width: 0;
    min-height: auto;
    border-right: 0;
    border-bottom: 1px solid rgba(255,255,255,.07);
  }

  .driver-nav {
    display: grid;
    grid-template-columns: repeat(2,1fr);
  }

  .driver-topbar {
    position: relative;
  }
}

/* =========================================================
   DRIVER PORTAL — INNER CONTENT / GLASS DASHBOARD
   ========================================================= */

.driver-main {
  flex: 1;
  min-width: 0;
  min-height: 100vh;
  background:
    radial-gradient(circle at 90% 10%, rgba(14,165,233,.055), transparent 28%),
    radial-gradient(circle at 45% 80%, rgba(56,189,248,.035), transparent 30%);
}

/* ---------- TOP BAR ---------- */

.driver-topbar {
  height: 76px;
  min-height: 76px;
  padding: 0 30px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 20;

  background: rgba(5,14,27,.72);
  border-bottom: 1px solid rgba(255,255,255,.07);

  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
}

.driver-topbar-title {
  display: flex;
  align-items: center;
  gap: 12px;
}

.driver-topbar-title h1 {
  margin: 0;
  font-size: 21px;
  font-weight: 700;
  letter-spacing: -.02em;
  color: #f4f8fc;
}

.driver-topbar-title p {
  margin: 3px 0 0;
  color: #718096;
  font-size: 12px;
}

.driver-topbar-right {
  display: flex;
  align-items: center;
  gap: 18px;
}

.driver-live-indicator {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 7px 11px;
  border: 1px solid rgba(34,197,94,.18);
  border-radius: 999px;
  background: rgba(34,197,94,.07);
  color: #86efac;
  font-size: 11px;
  font-weight: 700;
}

.driver-live-indicator::before {
  content: "";
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 12px rgba(34,197,94,.7);
}

.driver-topbar-user {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #cbd5e1;
  font-size: 13px;
}

.driver-topbar-avatar {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: linear-gradient(
    135deg,
    rgba(14,165,233,.22),
    rgba(56,189,248,.08)
  );
  border: 1px solid rgba(56,189,248,.2);
  color: #7dd3fc;
  font-weight: 700;
}

/* ---------- MAIN CONTENT ---------- */

.driver-content {
  width: 100%;
  max-width: 1480px;
  margin: 0 auto;
  padding: 30px;
  box-sizing: border-box;
}

/* Every major section gets the same operator-dashboard glass treatment */

.driver-content section {
  position: relative;
  margin-bottom: 22px;
  padding: 22px;
  border: 1px solid rgba(255,255,255,.07);
  border-radius: 18px;

  background:
    linear-gradient(
      145deg,
      rgba(15,31,51,.72),
      rgba(7,17,31,.78)
    );

  box-shadow:
    0 18px 45px rgba(0,0,0,.18),
    inset 0 1px 0 rgba(255,255,255,.025);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.driver-content section:last-child {
  margin-bottom: 0;
}

.driver-content section:hover {
  border-color: rgba(56,189,248,.12);
}

/* ---------- SECTION HEADINGS ---------- */

.driver-content section > h2,
.driver-content section > h3 {
  margin: 0 0 18px;
  color: #f1f5f9;
  font-size: 17px;
  font-weight: 700;
  letter-spacing: -.015em;
}

.driver-content section > p {
  color: #8290a3;
}

/* ---------- STAT / SUMMARY CARDS ---------- */

.driver-stat,
.driver-stat-card,
.driver-summary-card,
.driver-metric,
.driver-info-card {
  border: 1px solid rgba(255,255,255,.07);
  border-radius: 15px;
  background:
    linear-gradient(
      145deg,
      rgba(20,38,61,.66),
      rgba(8,20,35,.72)
    );
  box-shadow:
    0 12px 30px rgba(0,0,0,.15),
    inset 0 1px 0 rgba(255,255,255,.025);
  transition:
    transform .2s ease,
    border-color .2s ease,
    background .2s ease;
}

.driver-stat:hover,
.driver-stat-card:hover,
.driver-summary-card:hover,
.driver-metric:hover,
.driver-info-card:hover {
  transform: translateY(-2px);
  border-color: rgba(56,189,248,.18);
  background:
    linear-gradient(
      145deg,
      rgba(22,44,70,.72),
      rgba(8,22,39,.78)
    );
}

/* ---------- COMMON CARD ELEMENTS ---------- */

.driver-content article {
  border: 1px solid rgba(255,255,255,.06);
  border-radius: 15px;
  background: rgba(8,20,35,.62);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.025);
}

.driver-content strong {
  color: #e8eef7;
}

.driver-content small {
  color: #718096;
}

.driver-content label {
  color: #94a3b8;
  font-size: 12px;
  font-weight: 600;
}

/* ---------- TABLES ---------- */

.driver-content table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.06);
  border-radius: 14px;
  background: rgba(6,16,29,.58);
}

.driver-content thead {
  background: rgba(255,255,255,.025);
}

.driver-content th {
  padding: 13px 15px;
  border-bottom: 1px solid rgba(255,255,255,.07);
  color: #718096;
  font-size: 11px;
  font-weight: 700;
  text-align: left;
  text-transform: uppercase;
  letter-spacing: .06em;
}

.driver-content td {
  padding: 14px 15px;
  border-bottom: 1px solid rgba(255,255,255,.045);
  color: #cbd5e1;
  font-size: 13px;
}

.driver-content tbody tr {
  transition: background .18s ease;
}

.driver-content tbody tr:hover {
  background: rgba(56,189,248,.035);
}

.driver-content tbody tr:last-child td {
  border-bottom: 0;
}

/* ---------- STATUS BADGES ---------- */

.driver-content [class*="status"],
.driver-content [class*="badge"] {
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
}

/* ---------- BUTTONS ---------- */

.driver-content button {
  border: 1px solid rgba(56,189,248,.18);
  border-radius: 11px;
  padding: 9px 14px;
  background: rgba(14,165,233,.10);
  color: #bae6fd;
  font-weight: 700;
  cursor: pointer;
  transition:
    transform .18s ease,
    background .18s ease,
    border-color .18s ease;
}

.driver-content button:hover {
  transform: translateY(-1px);
  background: rgba(14,165,233,.16);
  border-color: rgba(56,189,248,.3);
}

.driver-content button:active {
  transform: translateY(0);
}

/* ---------- INPUTS ---------- */

.driver-content input,
.driver-content select,
.driver-content textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 11px;
  padding: 11px 13px;
  outline: none;

  background: rgba(4,13,25,.68);
  color: #e2e8f0;

  transition:
    border-color .18s ease,
    box-shadow .18s ease,
    background .18s ease;
}

.driver-content input::placeholder,
.driver-content textarea::placeholder {
  color: #526176;
}

.driver-content input:focus,
.driver-content select:focus,
.driver-content textarea:focus {
  border-color: rgba(56,189,248,.38);
  box-shadow: 0 0 0 3px rgba(56,189,248,.07);
  background: rgba(5,17,31,.82);
}

/* ---------- ERROR / ALERT ---------- */

.driver-content [class*="error"],
.driver-content [class*="alert"] {
  border-radius: 13px;
  border: 1px solid rgba(248,113,113,.18);
  background: rgba(127,29,29,.14);
  color: #fca5a5;
}

/* ---------- EMPTY STATES ---------- */

.driver-content [class*="empty"] {
  padding: 32px 20px;
  border: 1px dashed rgba(255,255,255,.09);
  border-radius: 15px;
  text-align: center;
  color: #64748b;
  background: rgba(5,15,27,.34);
}

/* ---------- LINKS ---------- */

.driver-content a {
  color: #7dd3fc;
  text-decoration: none;
}

.driver-content a:hover {
  color: #bae6fd;
}

/* ---------- SCROLLBARS ---------- */

.driver-content ::-webkit-scrollbar {
  width: 7px;
  height: 7px;
}

.driver-content ::-webkit-scrollbar-track {
  background: rgba(255,255,255,.025);
}

.driver-content ::-webkit-scrollbar-thumb {
  border-radius: 99px;
  background: rgba(100,116,139,.32);
}

.driver-content ::-webkit-scrollbar-thumb:hover {
  background: rgba(125,211,252,.32);
}

/* ---------- MOBILE ---------- */

@media (max-width: 900px) {
  .driver-sidebar {
    width: 220px;
    min-width: 220px;
  }

  .driver-content {
    padding: 22px;
  }

  .driver-topbar {
    padding: 0 22px;
  }
}

@media (max-width: 700px) {
  .driver-app {
    display: block;
  }

  .driver-sidebar {
    width: 100%;
    min-width: 0;
    min-height: auto;
    position: relative;
  }

  .driver-main {
    min-height: auto;
  }

  .driver-topbar {
    position: relative;
  }

  .driver-content {
    padding: 16px;
  }

  .driver-content section {
    padding: 17px;
    border-radius: 15px;
  }
}

/* =========================================================
   STRONG GLASSMORPHISM — DRIVER INNER PAGES
   ========================================================= */

.driver-main {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 78% 8%,
      rgba(14, 165, 233, .20),
      transparent 30%
    ),
    radial-gradient(
      circle at 30% 38%,
      rgba(59, 130, 246, .12),
      transparent 34%
    ),
    radial-gradient(
      circle at 75% 85%,
      rgba(6, 182, 212, .10),
      transparent 30%
    ),
    #050b15;
}

/* floating ambient light behind the glass */
.driver-main::before,
.driver-main::after {
  content: "";
  position: absolute;
  pointer-events: none;
  border-radius: 50%;
  filter: blur(90px);
  z-index: -1;
}

.driver-main::before {
  width: 420px;
  height: 420px;
  top: 110px;
  right: -130px;
  background: rgba(14, 165, 233, .13);
}

.driver-main::after {
  width: 360px;
  height: 360px;
  bottom: -80px;
  left: 25%;
  background: rgba(37, 99, 235, .09);
}

/* ---------- TOP BAR ---------- */

.driver-topbar {
  background: rgba(7, 17, 31, .48) !important;
  border-bottom: 1px solid rgba(255,255,255,.10) !important;

  box-shadow:
    0 8px 32px rgba(0,0,0,.20),
    inset 0 1px 0 rgba(255,255,255,.045);

  backdrop-filter: blur(30px) saturate(150%);
  -webkit-backdrop-filter: blur(30px) saturate(150%);
}

/* ---------- CONTENT ---------- */

.driver-content {
  position: relative;
  z-index: 1;
}

/* ---------- REAL GLASS PANELS ---------- */

.driver-content section {
  position: relative;
  overflow: hidden;

  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.075),
      rgba(255,255,255,.025) 45%,
      rgba(14,165,233,.025)
    ) !important;

  border: 1px solid rgba(255,255,255,.105) !important;

  box-shadow:
    0 24px 70px rgba(0,0,0,.30),
    0 8px 25px rgba(0,0,0,.18),
    inset 0 1px 0 rgba(255,255,255,.10),
    inset 0 -1px 0 rgba(0,0,0,.20);

  backdrop-filter: blur(28px) saturate(145%);
  -webkit-backdrop-filter: blur(28px) saturate(145%);

  transition:
    transform .25s ease,
    border-color .25s ease,
    box-shadow .25s ease;
}

/* glass reflection across the top */

.driver-content section::before {
  content: "";
  position: absolute;
  top: 0;
  left: 5%;
  right: 5%;
  height: 1px;

  background: linear-gradient(
    90deg,
    transparent,
    rgba(255,255,255,.20),
    rgba(125,211,252,.16),
    transparent
  );

  pointer-events: none;
}

/* subtle blue glow when hovering */

.driver-content section:hover {
  transform: translateY(-2px);

  border-color: rgba(125,211,252,.20) !important;

  box-shadow:
    0 28px 75px rgba(0,0,0,.34),
    0 0 35px rgba(14,165,233,.055),
    inset 0 1px 0 rgba(255,255,255,.13);
}

/* ---------- INNER CARDS ---------- */

.driver-content article,
.driver-stat,
.driver-stat-card,
.driver-summary-card,
.driver-metric,
.driver-info-card {
  position: relative;
  overflow: hidden;

  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.065),
      rgba(255,255,255,.018)
    ) !important;

  border: 1px solid rgba(255,255,255,.085) !important;

  box-shadow:
    0 14px 40px rgba(0,0,0,.22),
    inset 0 1px 0 rgba(255,255,255,.075);

  backdrop-filter: blur(22px) saturate(140%);
  -webkit-backdrop-filter: blur(22px) saturate(140%);
}

/* ---------- STAT CARDS ---------- */

.driver-stat,
.driver-stat-card,
.driver-summary-card,
.driver-metric {
  min-height: 110px;
}

.driver-stat:hover,
.driver-stat-card:hover,
.driver-summary-card:hover,
.driver-metric:hover {
  transform: translateY(-3px);

  border-color: rgba(56,189,248,.24) !important;

  box-shadow:
    0 18px 45px rgba(0,0,0,.30),
    0 0 30px rgba(14,165,233,.07),
    inset 0 1px 0 rgba(255,255,255,.12);
}

/* ---------- TABLE = GLASS INSIDE GLASS ---------- */

.driver-content table {
  background: rgba(2,10,20,.48) !important;
  border: 1px solid rgba(255,255,255,.075) !important;

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.045),
    0 12px 35px rgba(0,0,0,.16);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.driver-content thead {
  background: rgba(255,255,255,.045) !important;
}

.driver-content tbody tr:hover {
  background: rgba(56,189,248,.065) !important;
}

/* ---------- BUTTONS ---------- */

.driver-content button {
  background:
    linear-gradient(
      135deg,
      rgba(14,165,233,.22),
      rgba(37,99,235,.13)
    ) !important;

  border: 1px solid rgba(125,211,252,.22) !important;

  box-shadow:
    0 8px 25px rgba(14,165,233,.08),
    inset 0 1px 0 rgba(255,255,255,.10);

  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.driver-content button:hover {
  background:
    linear-gradient(
      135deg,
      rgba(14,165,233,.32),
      rgba(37,99,235,.20)
    ) !important;

  border-color: rgba(125,211,252,.36) !important;

  box-shadow:
    0 10px 30px rgba(14,165,233,.14),
    inset 0 1px 0 rgba(255,255,255,.14);
}

/* ---------- INPUTS ---------- */

.driver-content input,
.driver-content select,
.driver-content textarea {
  background: rgba(2,10,20,.42) !important;

  border: 1px solid rgba(255,255,255,.10) !important;

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.035);
}

.driver-content input:focus,
.driver-content select:focus,
.driver-content textarea:focus {
  background: rgba(5,17,31,.58) !important;

  border-color: rgba(56,189,248,.40) !important;

  box-shadow:
    0 0 0 3px rgba(56,189,248,.075),
    0 0 25px rgba(14,165,233,.07),
    inset 0 1px 0 rgba(255,255,255,.06);
}

/* ---------- EMPTY STATES ---------- */

.driver-content [class*="empty"] {
  background: rgba(255,255,255,.018) !important;

  border: 1px dashed rgba(125,211,252,.16) !important;

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.035);
}

/* ---------- HEADINGS ---------- */

.driver-content section > h2,
.driver-content section > h3 {
  color: #f8fafc;
  text-shadow: 0 1px 12px rgba(255,255,255,.04);
}

/* ---------- CYAN ACCENT ---------- */

.driver-content strong {
  color: #f1f5f9;
}

.driver-content a {
  color: #7dd3fc;
  text-shadow: 0 0 15px rgba(56,189,248,.10);
}

/* ---------- MOBILE ---------- */

@media (max-width: 700px) {
  .driver-main::before {
    width: 280px;
    height: 280px;
  }

  .driver-main::after {
    width: 240px;
    height: 240px;
  }
}

