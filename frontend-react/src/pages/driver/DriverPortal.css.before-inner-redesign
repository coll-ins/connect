.driver-app {
  min-height: 100vh;
  display: flex;
  background:
    radial-gradient(circle at 80% 0%, rgba(16, 185, 129, .08), transparent 30%),
    radial-gradient(circle at 20% 20%, rgba(59, 130, 246, .07), transparent 28%),
    #07111f;
  color: #e8eef7;
}

/* =========================================================
   SIDEBAR
   ========================================================= */

.driver-sidebar {
  width: 260px;
  min-width: 260px;
  min-height: 100vh;
  position: sticky;
  top: 0;
  display: flex;
  flex-direction: column;
  padding: 24px 16px;
  border-right: 1px solid rgba(255,255,255,.07);
  background: rgba(5,14,27,.78);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
  z-index: 30;
  box-sizing: border-box;
}

.driver-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 4px 10px 22px;
}

.driver-brand-mark {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: rgba(16,185,129,.14);
  color: #34d399;
  border: 1px solid rgba(52,211,153,.2);
}

.driver-brand strong,
.driver-brand span {
  display: block;
}

.driver-brand strong {
  font-size: 18px;
  letter-spacing: .08em;
}

.driver-brand span {
  margin-top: 2px;
  color: #718096;
  font-size: 11px;
}

.driver-company-card {
  padding: 15px;
  border: 1px solid rgba(255,255,255,.07);
  border-radius: 16px;
  background: rgba(255,255,255,.035);
  margin-bottom: 25px;
}

.driver-company-card span,
.driver-company-card small {
  display: block;
  color: #718096;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .12em;
}

.driver-company-card strong {
  display: block;
  margin: 7px 0 5px;
  font-size: 14px;
  color: #f5f8fc;
}

.driver-company-card small {
  text-transform: none;
  letter-spacing: 0;
  font-size: 11px;
}

.driver-nav {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.driver-nav-label {
  padding: 0 11px 9px;
  color: #526176;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .14em;
}

.driver-nav-item {
  width: 100%;
  min-height: 44px;
  padding: 0 12px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  gap: 12px;
  border: 0;
  background: transparent;
  color: #8290a5;
  text-decoration: none;
  cursor: pointer;
  font: inherit;
  text-align: left;
  transition: .2s ease;
}

.driver-nav-item:hover {
  color: #eaf2f8;
  background: rgba(255,255,255,.045);
}

.driver-nav-item-active {
  color: #ecfdf5;
  background:
    linear-gradient(
      90deg,
      rgba(16,185,129,.16),
      rgba(16,185,129,.055)
    );
  box-shadow: inset 2px 0 #34d399;
}

.driver-nav-item-active .driver-nav-icon {
  color: #34d399;
}

.driver-nav-icon {
  width: 18px;
  min-width: 18px;
  display: grid;
  place-items: center;
  color: #64748b;
}

.driver-nav-arrow {
  margin-left: auto;
  opacity: .35;
}

/* =========================================================
   SIDEBAR BOTTOM
   ========================================================= */

.driver-sidebar-bottom {
  margin-top: auto;
}

.driver-user-card {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 13px 9px;
  border-top: 1px solid rgba(255,255,255,.06);
}

.driver-user-avatar,
.driver-topbar-avatar {
  display: grid;
  place-items: center;
  flex-shrink: 0;
  border-radius: 50%;
  background: linear-gradient(145deg, #183d45, #102a37);
  border: 1px solid rgba(52,211,153,.22);
  color: #a7f3d0;
  font-weight: 700;
}

.driver-user-avatar {
  width: 36px;
  height: 36px;
  font-size: 13px;
}

.driver-user-card strong,
.driver-user-card span {
  display: block;
}

.driver-user-card strong {
  font-size: 12px;
}

.driver-user-card span {
  margin-top: 2px;
  color: #64748b;
  font-size: 10px;
}

.driver-logout {
  width: 100%;
  height: 40px;
  border: 1px solid rgba(255,255,255,.06);
  border-radius: 11px;
  background: rgba(255,255,255,.025);
  color: #8390a2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  cursor: pointer;
  font: inherit;
  transition: .2s ease;
}

.driver-logout:hover {
  color: #fca5a5;
  border-color: rgba(248,113,113,.2);
  background: rgba(248,113,113,.035);
}

/* =========================================================
   MAIN / TOPBAR
   ========================================================= */

.driver-main {
  flex: 1;
  min-width: 0;
}

.driver-topbar {
  height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 34px;
  border-bottom: 1px solid rgba(255,255,255,.06);
  background: rgba(7,17,31,.68);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  position: sticky;
  top: 0;
  z-index: 20;
  box-sizing: border-box;
}

.driver-menu-button {
  display: none;
  border: 1px solid rgba(255,255,255,.08);
  background: rgba(255,255,255,.04);
  color: #d9e2ec;
  border-radius: 10px;
  width: 40px;
  height: 40px;
  cursor: pointer;
}

.driver-topbar-title span,
.driver-topbar-title strong {
  display: block;
}

.driver-topbar-title span {
  color: #526176;
  font-size: 9px;
  letter-spacing: .15em;
  font-weight: 800;
}

.driver-topbar-title strong {
  margin-top: 4px;
  font-size: 14px;
  color: #e7edf5;
}

.driver-topbar-right {
  display: flex;
  align-items: center;
  gap: 22px;
}

.driver-live-indicator {
  display: flex;
  align-items: center;
  gap: 7px;
  color: #9fb0c4;
  font-size: 11px;
}

.driver-live-indicator span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #34d399;
  box-shadow: 0 0 0 4px rgba(52,211,153,.09);
}

.driver-topbar-user {
  display: flex;
  align-items: center;
  gap: 9px;
}

.driver-topbar-avatar {
  width: 34px;
  height: 34px;
  font-size: 12px;
}

/* =========================================================
   CONTENT
   ========================================================= */

.driver-content {
  width: min(1440px, 100%);
  margin: 0 auto;
  padding: 34px;
  box-sizing: border-box;
}

.driver-content h1 {
  color: #f5f8fc !important;
}

.driver-content h2,
.driver-content h3 {
  color: #f5f8fc !important;
}

.driver-content p {
  color: #8190a5;
}

.driver-content strong {
  color: #e8eef7;
}

.driver-content small {
  color: #718096;
}

/* =========================================================
   GLASS SECTIONS
   ========================================================= */

.driver-content section {
  position: relative;
  margin-bottom: 22px;
  padding: 24px;
  border: 1px solid rgba(255,255,255,.07);
  border-radius: 18px;
  background:
    radial-gradient(
      circle at 90% 0%,
      rgba(16,185,129,.08),
      transparent 35%
    ),
    rgba(255,255,255,.035);
  box-shadow: 0 24px 70px rgba(0,0,0,.14);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  box-sizing: border-box;
}

.driver-content section:last-child {
  margin-bottom: 0;
}

/* =========================================================
   STAT CARDS
   ========================================================= */

.driver-content section > div[style*="grid"] > div {
  border: 1px solid rgba(255,255,255,.07) !important;
  border-radius: 16px !important;
  background:
    radial-gradient(
      circle at 90% 0%,
      rgba(16,185,129,.07),
      transparent 40%
    ),
    rgba(255,255,255,.035) !important;
  box-shadow: 0 18px 45px rgba(0,0,0,.12) !important;
  color: #e8eef7 !important;
  transition:
    transform .2s ease,
    border-color .2s ease,
    background .2s ease;
}

.driver-content section > div[style*="grid"] > div:hover {
  transform: translateY(-2px);
  border-color: rgba(52,211,153,.16) !important;
}

/* =========================================================
   BOOKING / PASSENGER ITEMS
   ========================================================= */

.driver-content section > div[style*="border"] {
  color: #cbd5e1;
}

.driver-content section > div[style*="border"] strong {
  color: #f1f5f9 !important;
}

.driver-content section > div[style*="border"] div {
  color: #8190a5 !important;
}

/* =========================================================
   ERROR
   ========================================================= */

.driver-content [style*="background: #fff7ed"] {
  background: rgba(127,29,29,.14) !important;
  border: 1px solid rgba(248,113,113,.18) !important;
  color: #fca5a5 !important;
}

.driver-content [style*="background: #fff7ed"] strong {
  color: #fecaca !important;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 900px) {
  .driver-sidebar {
    width: 230px;
    min-width: 230px;
  }

  .driver-topbar {
    padding: 0 20px;
  }

  .driver-content {
    padding: 24px 20px;
  }
}

@media (max-width: 700px) {
  .driver-app {
    display: block;
  }

  .driver-sidebar {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: 260px;
    min-width: 260px;
    transform: translateX(-100%);
    transition: transform .22s ease;
    box-shadow: 20px 0 60px rgba(0,0,0,.3);
  }

  .driver-sidebar.driver-sidebar-open {
    transform: translateX(0);
  }

  .driver-menu-button {
    display: grid;
    place-items: center;
  }

  .driver-topbar {
    height: 70px;
    padding: 0 16px;
  }

  .driver-content {
    padding: 22px 16px;
  }

  .driver-topbar-title span {
    display: none;
  }

  .driver-topbar-right {
    gap: 10px;
  }
}

@media (max-width: 480px) {
  .driver-topbar-user > div:not(.driver-topbar-avatar) {
    display: none;
  }

  .driver-content section {
    padding: 18px;
    border-radius: 15px;
  }
}
