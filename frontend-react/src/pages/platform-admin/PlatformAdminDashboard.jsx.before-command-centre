          <p className="pa-nav-label">SYSTEM</p>

          <SideLink to="/platform-admin/settings" icon={Settings}>
            Settings
          </SideLink>
        </nav>

        <button className="pa-logout" onClick={logout}>
          <LogOut size={18} />
          Logout
        </button>
      </aside>

      <div className="pa-main">
        <header className="pa-topbar">
          <div>
            <span className="pa-overline">GLOBAL OPERATIONS</span>
            <h2>Platform administration</h2>
