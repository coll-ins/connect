  return (
    <div className="pa-shell">
      <aside className="pa-sidebar">
        <div className="pa-brand">
          <div className="pa-brand-mark">C</div>
          <div>
            <strong>CONNECT</strong>
            <small>Platform Control</small>
          </div>
