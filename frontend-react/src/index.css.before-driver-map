.driver-booking-card {
  padding: 18px;
}

.driver-booking-top {
  display: flex;
  justify-content: space-between;
  gap: 15px;
}

.driver-booking-top h3 {
  margin: 5px 0 0;
  color: #0f172a;
  font-size: 17px;
