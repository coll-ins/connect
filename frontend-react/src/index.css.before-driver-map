/* =========================================================
   CONNECT DRIVER PORTAL
   ========================================================= */

.driver-app {
  min-height: 100vh;
  display: flex;
  background:
    radial-gradient(circle at 70% -10%, rgba(22, 199, 132, 0.09), transparent 30%),
    radial-gradient(circle at 10% 80%, rgba(48, 106, 160, 0.10), transparent 30%),
    #07111f;
  color: #e8eef7;
}

.driver-sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 250px;
  z-index: 50;
  display: flex;
  flex-direction: column;
  padding: 25px 16px;
  border-right: 1px solid rgba(148, 173, 199, 0.13);
  background: rgba(6, 18, 31, 0.82);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
}

.driver-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 3px 9px 30px;
}

.driver-brand-mark {
  width: 39px;
  height: 39px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: linear-gradient(135deg, #19cf8d, #087f5d);
  color: #03120e;
  font-size: 20px;
  font-weight: 950;
  box-shadow: 0 8px 25px rgba(22, 199, 132, 0.18);
}

.driver-brand strong,
.driver-brand span {
  display: block;
}

.driver-brand strong {
  font-size: 14px;
  letter-spacing: 0.08em;
}

.driver-brand span {
  margin-top: 2px;
  color: #71869d;
  font-size: 11px;
}

.driver-nav {
  display: grid;
  gap: 6px;
}

.driver-nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 45px;
  padding: 0 13px;
  border: 1px solid transparent;
  border-radius: 12px;
  color: #8ea2b8;
  font-size: 13px;
  font-weight: 750;
  transition: 160ms ease;
}

.driver-nav-item:hover {
  color: #eaf4f2;
  background: rgba(255, 255, 255, 0.035);
}

.driver-nav-item.active {
  color: #72e1bd;
  border-color: rgba(44, 211, 153, 0.13);
  background: rgba(27, 185, 127, 0.09);
}

.driver-sidebar-bottom {
  margin-top: auto;
  padding-top: 18px;
  border-top: 1px solid rgba(148, 173, 199, 0.10);
}

.driver-mini-profile {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px;
}

.driver-avatar,
.driver-topbar-avatar {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  border-radius: 50%;
  background: linear-gradient(135deg, #153d50, #0b7560);
  color: #a9f1d7;
  font-weight: 850;
}

.driver-avatar {
  width: 35px;
  height: 35px;
  font-size: 13px;
}

.driver-mini-copy {
  min-width: 0;
}

.driver-mini-copy strong,
.driver-mini-copy span {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-mini-copy strong {
  color: #dce7f2;
  font-size: 12px;
}

.driver-mini-copy span {
  margin-top: 2px;
  color: #687f96;
  font-size: 10px;
}

.driver-signout {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 10px;
  padding: 10px;
  border: 1px solid rgba(148, 173, 199, 0.10);
  border-radius: 10px;
  background: transparent;
  color: #8195aa;
  font-size: 12px;
  font-weight: 750;
}

.driver-signout:hover {
  color: #f1c4c4;
  border-color: rgba(239, 107, 107, 0.18);
  background: rgba(239, 107, 107, 0.05);
}

.driver-main {
  width: calc(100% - 250px);
  min-height: 100vh;
  margin-left: 250px;
}

.driver-topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  min-height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 34px;
  border-bottom: 1px solid rgba(148, 173, 199, 0.09);
  background: rgba(7, 17, 31, 0.74);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.driver-topbar-title span,
.driver-panel-kicker,
.driver-eyebrow {
  display: block;
  color: #5fcfae;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 0.16em;
}

.driver-topbar-title strong {
  display: block;
  margin-top: 4px;
  color: #dce7f2;
  font-size: 14px;
}

.driver-topbar-user {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #8ca1b7;
  font-size: 12px;
  font-weight: 700;
}

.driver-status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #28cf91;
  box-shadow: 0 0 12px rgba(40, 207, 145, 0.65);
}

.driver-topbar-avatar {
  width: 33px;
  height: 33px;
  margin-left: 5px;
  font-size: 12px;
}

.driver-mobile-menu {
  display: none;
}

.driver-content {
  width: min(1380px, 100%);
  margin: 0 auto;
  padding: 36px 38px 60px;
}

.driver-welcome {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 25px;
  margin-bottom: 28px;
}

.driver-welcome h1 {
  margin: 8px 0 8px;
  color: #f1f6fb;
  font-size: clamp(30px, 4vw, 46px);
  line-height: 1.05;
  letter-spacing: -0.035em;
}

.driver-welcome p {
  margin: 0;
  color: #8297ad;
  font-size: 14px;
}

.driver-vehicle-chip {
  min-width: 205px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 15px;
  border: 1px solid rgba(148, 173, 199, 0.12);
  border-radius: 15px;
  background: rgba(14, 31, 48, 0.62);
}

.driver-vehicle-chip svg {
  color: #64d9b5;
}

.driver-vehicle-chip span,
.driver-vehicle-chip strong {
  display: block;
}

.driver-vehicle-chip span {
  color: #71869c;
  font-size: 10px;
  font-weight: 750;
}

.driver-vehicle-chip strong {
  margin-top: 3px;
  color: #dce8f3;
  font-size: 14px;
}

.driver-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 18px;
  padding: 12px 14px;
  border: 1px solid rgba(239, 107, 107, 0.20);
  border-radius: 12px;
  background: rgba(151, 43, 43, 0.10);
  color: #f2aaaa;
  font-size: 12px;
}

.driver-error button {
  display: grid;
  place-items: center;
  border: 0;
  background: transparent;
  color: inherit;
}

.driver-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 13px;
  margin-bottom: 18px;
}

.driver-stat-card,
.driver-panel,
.driver-booking-card,
.driver-empty-state {
  border: 1px solid rgba(148, 173, 199, 0.11);
  background: linear-gradient(
    145deg,
    rgba(17, 37, 56, 0.78),
    rgba(8, 22, 36, 0.74)
  );
  box-shadow: 0 18px 45px rgba(0, 0, 0, 0.16);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.driver-stat-card {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 17px;
  border-radius: 16px;
}

.driver-stat-icon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  border-radius: 12px;
  background: rgba(30, 201, 140, 0.09);
  color: #65dcb8;
}

.driver-stat-blue .driver-stat-icon {
  background: rgba(74, 146, 226, 0.10);
  color: #79b8ef;
}

.driver-stat-purple .driver-stat-icon {
  background: rgba(155, 116, 232, 0.10);
  color: #b69be9;
}

.driver-stat-amber .driver-stat-icon {
  background: rgba(224, 168, 69, 0.10);
  color: #e9ba68;
}

.driver-stat-content {
  min-width: 0;
}

.driver-stat-content span,
.driver-stat-content strong,
.driver-stat-content small {
  display: block;
}

.driver-stat-content span {
  color: #70859b;
  font-size: 10px;
  font-weight: 750;
  text-transform: uppercase;
  letter-spacing: 0.07em;
}

.driver-stat-content strong {
  margin-top: 4px;
  overflow: hidden;
  color: #edf4f9;
  font-size: 20px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-stat-content small {
  margin-top: 3px;
  overflow: hidden;
  color: #61768b;
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-primary-grid {
  display: grid;
  grid-template-columns: 1.35fr 0.65fr;
  gap: 15px;
  margin-bottom: 30px;
}

.driver-panel {
  padding: 21px;
  border-radius: 18px;
}

.driver-panel-heading,
.driver-section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
}

.driver-panel-heading h2,
.driver-section-heading h2 {
  margin: 5px 0 0;
  color: #e8f0f6;
  font-size: 18px;
  letter-spacing: -0.02em;
}

.driver-panel-heading > svg {
  color: #6b8299;
}

.driver-live-indicator {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 8px;
  border: 1px solid rgba(40, 207, 145, 0.12);
  border-radius: 7px;
  color: #66d8b6;
  font-size: 9px;
  font-weight: 850;
  letter-spacing: 0.08em;
}

.driver-live-indicator span {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #2bd093;
}

.driver-location-content {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 14px;
  margin-top: 24px;
  padding-top: 20px;
  border-top: 1px solid rgba(148, 173, 199, 0.08);
}

.driver-location-icon {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  border-radius: 15px;
  color: #6fe0ba;
  background: rgba(31, 200, 140, 0.08);
}

.driver-location-copy strong,
.driver-location-copy span {
  display: block;
}

.driver-location-copy strong {
  color: #e0eaf2;
  font-size: 14px;
}

.driver-location-copy span {
  max-width: 470px;
  margin-top: 5px;
  color: #72879c;
  font-size: 11px;
  line-height: 1.5;
}

.driver-primary-button,
.driver-board-button,
.driver-refresh-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: 10px;
  font-size: 11px;
  font-weight: 800;
  transition: 160ms ease;
}

.driver-primary-button,
.driver-board-button {
  border: 1px solid rgba(35, 211, 151, 0.20);
  background: linear-gradient(135deg, #17b97f, #0c9166);
  color: #03140f;
  padding: 10px 14px;
  box-shadow: 0 8px 20px rgba(17, 185, 127, 0.12);
}

.driver-primary-button:hover,
.driver-board-button:hover {
  transform: translateY(-1px);
  filter: brightness(1.06);
}

.driver-primary-button:disabled {
  transform: none;
}

.driver-profile-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px 20px;
  margin-top: 21px;
}

.driver-profile-list div {
  min-width: 0;
}

.driver-profile-list span,
.driver-profile-list strong {
  display: block;
}

.driver-profile-list span {
  color: #697f95;
  font-size: 10px;
  font-weight: 750;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.driver-profile-list strong {
  margin-top: 4px;
  overflow: hidden;
  color: #dce7ef;
  font-size: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-bookings-section {
  scroll-margin-top: 90px;
}

.driver-section-heading {
  align-items: flex-end;
  margin-bottom: 14px;
}

.driver-section-heading p {
  margin: 7px 0 0;
  color: #71869b;
  font-size: 12px;
}

.driver-refresh-button {
  padding: 9px 12px;
  border: 1px solid rgba(148, 173, 199, 0.13);
  background: rgba(17, 35, 52, 0.60);
  color: #9eb1c4;
}

.driver-refresh-button:hover {
  border-color: rgba(44, 211, 153, 0.18);
  color: #71dcb9;
}

.driver-spin {
  animation: driver-spin 0.8s linear infinite;
}

@keyframes driver-spin {
  to {
    transform: rotate(360deg);
  }
}

.driver-bookings-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.driver-booking-card {
  padding: 18px;
  border-radius: 16px;
  transition: transform 160ms ease, border-color 160ms ease;
}

.driver-booking-card:hover {
  transform: translateY(-2px);
  border-color: rgba(93, 216, 178, 0.18);
}

.driver-booking-header {
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

.driver-booking-number {
  color: #5f7890;
  font-size: 9px;
  font-weight: 850;
  letter-spacing: 0.10em;
}

.driver-booking-card h3 {
  margin: 4px 0 0;
  color: #e4edf4;
  font-size: 15px;
}

.driver-booking-status {
  align-self: flex-start;
  padding: 5px 8px;
  border-radius: 7px;
  font-size: 9px;
  font-weight: 850;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.driver-booking-status.confirmed {
  border: 1px solid rgba(40, 207, 145, 0.13);
  background: rgba(40, 207, 145, 0.08);
  color: #65dcb8;
}

.driver-booking-status.other {
  border: 1px solid rgba(225, 176, 77, 0.14);
  background: rgba(225, 176, 77, 0.08);
  color: #e6bb70;
}

.driver-route-box {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 16px 0;
  padding: 11px;
  border: 1px solid rgba(148, 173, 199, 0.08);
  border-radius: 10px;
  background: rgba(3, 13, 23, 0.22);
}

.driver-route-box svg {
  color: #63d7b5;
  flex: 0 0 auto;
}

.driver-route-box span,
.driver-route-box strong {
  display: block;
}

.driver-route-box span {
  color: #60768d;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.driver-route-box strong {
  margin-top: 2px;
  color: #cbd9e5;
  font-size: 11px;
}

.driver-booking-details {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.driver-booking-details span,
.driver-booking-details strong {
  display: block;
}

.driver-booking-details span {
  color: #60768d;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.driver-booking-details strong {
  margin-top: 3px;
  color: #cbd9e5;
  font-size: 11px;
  font-weight: 700;
}

.driver-board-button {
  width: 100%;
  margin-top: 16px;
}

.driver-empty-state {
  min-height: 230px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30px;
  border-radius: 17px;
  text-align: center;
}

.driver-empty-icon {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  margin-bottom: 13px;
  border-radius: 15px;
  color: #70dcb9;
  background: rgba(31, 200, 140, 0.08);
}

.driver-empty-state strong {
  color: #dbe6ef;
  font-size: 14px;
}

.driver-empty-state > span {
  max-width: 440px;
  margin-top: 6px;
  color: #6f8499;
  font-size: 11px;
  line-height: 1.6;
}

.driver-loading-spinner {
  width: 27px;
  height: 27px;
  margin-bottom: 13px;
  border: 2px solid rgba(111, 224, 186, 0.18);
  border-top-color: #65dcb8;
  border-radius: 50%;
  animation: driver-spin 0.8s linear infinite;
}

.driver-mobile-backdrop {
  display: none;
}

/* Driver responsive layout */

@media (max-width: 1100px) {
  .driver-stats {
    grid-template-columns: 1fr 1fr;
  }

  .driver-primary-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 820px) {
  .driver-sidebar {
    transform: translateX(-100%);
    transition: transform 180ms ease;
    box-shadow: 20px 0 50px rgba(0, 0, 0, 0.30);
  }

  .driver-sidebar-open {
    transform: translateX(0);
  }

  .driver-mobile-backdrop {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 40;
    border: 0;
    background: rgba(0, 0, 0, 0.48);
    backdrop-filter: blur(3px);
  }

  .driver-main {
    width: 100%;
    margin-left: 0;
  }

  .driver-mobile-menu {
    display: inline-grid;
    place-items: center;
    width: 35px;
    height: 35px;
    margin-right: 8px;
    border: 1px solid rgba(148, 173, 199, 0.12);
    border-radius: 9px;
    background: rgba(15, 32, 49, 0.60);
    color: #a5b8ca;
    vertical-align: middle;
  }

  .driver-topbar {
    padding: 0 17px;
  }

  .driver-topbar-user > span {
    display: none;
  }

  .driver-content {
    padding: 27px 17px 45px;
  }

  .driver-welcome {
    align-items: stretch;
    flex-direction: column;
  }

  .driver-vehicle-chip {
    width: 100%;
  }

  .driver-bookings-grid {
    grid-template-columns: 1fr;
  }

  .driver-location-content {
    grid-template-columns: auto 1fr;
  }

  .driver-primary-button {
    grid-column: 1 / -1;
    width: 100%;
  }
}

@media (max-width: 540px) {
  .driver-stats {
    grid-template-columns: 1fr;
  }

  .driver-welcome h1 {
    font-size: 31px;
  }

  .driver-profile-list {
    grid-template-columns: 1fr;
  }

  .driver-section-heading {
    align-items: stretch;
    flex-direction: column;
  }

  .driver-refresh-button {
    width: 100%;
  }

  .driver-booking-details {
    grid-template-columns: 1fr;
  }
}

/* =========================================================
   DRIVER BOARDING VERIFICATION MODAL
   ========================================================= */

.driver-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(15, 23, 42, 0.62);
  backdrop-filter: blur(5px);
  animation: driver-modal-fade-in 160ms ease-out;
}

.driver-boarding-modal {
  width: min(100%, 520px);
  max-height: calc(100vh - 48px);
  overflow-y: auto;
  background: #ffffff;
  border-radius: 22px;
  padding: 28px;
  box-shadow: 0 24px 80px rgba(15, 23, 42, 0.28);
  animation: driver-modal-slide-up 180ms ease-out;
}

.driver-boarding-modal-icon {
  width: 52px;
  height: 52px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18px;
  border-radius: 15px;
  background: #ecfdf5;
  color: #047857;
}

.driver-boarding-modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.driver-boarding-modal-header span {
  display: block;
  margin-bottom: 5px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: #64748b;
}

.driver-boarding-modal-header h2 {
  margin: 0;
  font-size: 25px;
  line-height: 1.2;
  color: #0f172a;
}

.driver-boarding-close {
  width: 38px;
  height: 38px;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 10px;
  background: #f1f5f9;
  color: #475569;
  cursor: pointer;
}

.driver-boarding-close:hover:not(:disabled) {
  background: #e2e8f0;
}

.driver-boarding-close:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

.driver-boarding-summary {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 24px;
  padding: 16px;
  border: 1px solid #e2e8f0;
  border-radius: 15px;
  background: #f8fafc;
}

.driver-boarding-summary div:last-child {
  grid-column: 1 / -1;
}

.driver-boarding-summary span {
  display: block;
  margin-bottom: 4px;
  font-size: 11px;
  font-weight: 700;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.driver-boarding-summary strong {
  display: block;
  overflow: hidden;
  font-size: 14px;
  color: #0f172a;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-boarding-form {
  margin-top: 24px;
}

.driver-boarding-form label {
  display: block;
  margin-bottom: 8px;
  font-size: 14px;
  font-weight: 700;
  color: #0f172a;
}

.driver-boarding-form input {
  width: 100%;
  box-sizing: border-box;
  padding: 15px 16px;
  border: 1px solid #cbd5e1;
  border-radius: 12px;
  outline: none;
  background: #ffffff;
  color: #0f172a;
  font-size: 24px;
  font-weight: 800;
  letter-spacing: 0.35em;
  text-align: center;
  transition: border-color 150ms ease, box-shadow 150ms ease;
}

.driver-boarding-form input::placeholder {
  color: #94a3b8;
  font-size: 15px;
  font-weight: 500;
  letter-spacing: normal;
}

.driver-boarding-form input:focus {
  border-color: #059669;
  box-shadow: 0 0 0 4px rgba(5, 150, 105, 0.12);
}

.driver-boarding-form input:disabled {
  background: #f8fafc;
  cursor: not-allowed;
}

.driver-boarding-help {
  display: block;
  margin-top: 8px;
  font-size: 12px;
  line-height: 1.5;
  color: #64748b;
}

.driver-boarding-error {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin-top: 12px;
  padding: 11px 12px;
  border: 1px solid #fecaca;
  border-radius: 10px;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 13px;
  line-height: 1.4;
}

.driver-boarding-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 26px;
}

.driver-boarding-cancel,
.driver-boarding-submit {
  min-height: 44px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 0 17px;
  border-radius: 11px;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  transition: transform 120ms ease, opacity 120ms ease, background 120ms ease;
}

.driver-boarding-cancel {
  border: 1px solid #cbd5e1;
  background: #ffffff;
  color: #334155;
}

.driver-boarding-cancel:hover:not(:disabled) {
  background: #f8fafc;
}

.driver-boarding-submit {
  border: 1px solid #047857;
  background: #047857;
  color: #ffffff;
}

.driver-boarding-submit:hover:not(:disabled) {
  background: #065f46;
  transform: translateY(-1px);
}

.driver-boarding-submit:disabled,
.driver-boarding-cancel:disabled {
  cursor: not-allowed;
  opacity: 0.55;
  transform: none;
}

.driver-button-spinner {
  width: 15px;
  height: 15px;
  border: 2px solid rgba(255, 255, 255, 0.4);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: driver-button-spin 700ms linear infinite;
}

@keyframes driver-modal-fade-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes driver-modal-slide-up {
  from {
    opacity: 0;
    transform: translateY(12px) scale(0.98);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes driver-button-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (max-width: 560px) {
  .driver-modal-backdrop {
    padding: 14px;
  }

  .driver-boarding-modal {
    padding: 22px;
    border-radius: 18px;
  }

  .driver-boarding-summary {
    grid-template-columns: 1fr;
  }

  .driver-boarding-summary div:last-child {
    grid-column: auto;
  }

  .driver-boarding-actions {
    flex-direction: column-reverse;
  }

  .driver-boarding-cancel,
  .driver-boarding-submit {
    width: 100%;
  }
}

/* ============================================================
   CONNECT LIVE MAP
   ============================================================ */

.connect-map-wrapper {
  width: 100%;
  overflow: hidden;
  border-radius: 16px;
  position: relative;
  background: #eef2f7;
}

.connect-map-wrapper .leaflet-container {
  font-family: inherit;
}

.connect-map-marker {
  background: transparent !important;
  border: none !important;
}

.connect-map-marker-inner {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23px;
  background: white;
  border: 3px solid #111827;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
}

.driver-marker {
  border-color: #2563eb;
}

.passenger-marker {
  border-color: #16a34a;
}

/* ============================================================
   DRIVER LIVE MAP
   ============================================================ */

.driver-location-map {
  margin-top: 18px;
  overflow: hidden;
  border-radius: 18px;
  border: 1px solid rgba(15, 23, 42, 0.08);
}

.driver-map-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-top: 16px;
}

.driver-map-status {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.driver-map-passenger {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 20px;
  margin-top: 18px;
  padding-top: 18px;
  border-top: 1px solid rgba(15, 23, 42, 0.08);
}

.driver-map-passenger > div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.driver-map-select {
  min-width: 250px;
  border: 1px solid rgba(15, 23, 42, 0.14);
  border-radius: 10px;
  padding: 11px 13px;
  background: #fff;
  color: #111827;
  font: inherit;
}

.driver-map-live-info {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 14px;
}

.driver-map-live-info > div {
  padding: 13px 15px;
  border-radius: 12px;
  background: rgba(15, 23, 42, 0.035);
}

.driver-map-live-info span {
  display: block;
  margin-bottom: 5px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  opacity: 0.62;
}

.driver-map-live-info strong {
  display: block;
  font-size: 14px;
}

@media (max-width: 720px) {
  .driver-map-controls,
  .driver-map-passenger {
    align-items: stretch;
    flex-direction: column;
  }

  .driver-map-select {
    width: 100%;
    min-width: 0;
  }

  .driver-map-live-info {
    grid-template-columns: 1fr;
  }
}

/* ============================================================
   DRIVER FULL-SCREEN LIVE MAP
   ============================================================ */

.driver-location-map {
  position: relative;
}

.driver-location-map-expanded {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100dvh !important;
  margin: 0;
  padding: 0;
  z-index: 9999;
  border: 0;
  border-radius: 0;
  background: #eef2f7;
}

.driver-location-map-expanded .connect-map-wrapper {
  width: 100%;
  height: 100% !important;
  border-radius: 0;
}

.driver-location-map-expanded .leaflet-container {
  width: 100%;
  height: 100% !important;
  border-radius: 0 !important;
}

.driver-map-back-button {
  position: absolute;
  top: max(18px, env(safe-area-inset-top));
  left: 18px;
  z-index: 10000;

  display: flex;
  align-items: center;
  gap: 8px;

  min-height: 46px;
  padding: 0 16px;

  border: 0;
  border-radius: 14px;

  background: rgba(17, 24, 39, 0.94);
  color: #ffffff;

  font-size: 15px;
  font-weight: 800;

  box-shadow:
    0 8px 24px rgba(0, 0, 0, 0.28);

  cursor: pointer;
}

.driver-map-back-button:hover {
  background: rgba(17, 24, 39, 1);
}

.driver-map-back-button:active {
  transform: scale(0.98);
}

/* ============================================================
   CONNECT MAP — STAGE MARKERS
   ============================================================ */

.connect-stage-marker {
  background: transparent !important;
  border: 0 !important;
}

.connect-stage-pin {
  width: 32px;
  height: 40px;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  position: relative;
  filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.28));
}

.connect-stage-pin::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 1px;
  width: 9px;
  height: 9px;
  transform: translateX(-50%) rotate(45deg);
  background: #ef4444;
  border-right: 2px solid #fff;
  border-bottom: 2px solid #fff;
}

.connect-stage-pin .connect-stage-number {
  position: relative;
  z-index: 1;
  width: 29px;
  height: 29px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ef4444;
  border: 2px solid #fff;
  box-shadow:
    0 0 0 2px rgba(239, 68, 68, 0.22),
    0 2px 6px rgba(0, 0, 0, 0.25);
  color: #fff;
  font-family: Arial, sans-serif;
  font-size: 12px;
  line-height: 1;
  font-weight: 900;
}


/* ============================================================
   DRIVER LIVE TRIP — PRODUCTION LAYOUT
   ============================================================ */

.driver-live-page {
  position: relative;
  width: 100%;
  height: calc(100dvh - 72px);
  min-height: 620px;
  overflow: hidden;
  background: #e8edf3;
}

.driver-live-map {
  position: absolute;
  inset: 0;
  z-index: 1;
  overflow: hidden;
}

.driver-live-map .connect-map-wrapper {
  width: 100%;
  height: 100% !important;
  border-radius: 0;
}

.driver-live-map .leaflet-container {
  width: 100%;
  height: 100% !important;
  border-radius: 0 !important;
}

/* Back button */

.driver-live-back {
  position: absolute;
  top: 18px;
  left: 18px;
  z-index: 1000;

  display: inline-flex;
  align-items: center;
  gap: 8px;

  min-height: 44px;
  padding: 0 15px;

  border: 0;
  border-radius: 12px;

  background: rgba(17, 24, 39, 0.94);
  color: #fff;

  font-size: 14px;
  font-weight: 800;

  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.24);

  cursor: pointer;
  backdrop-filter: blur(8px);
}

.driver-live-back:hover {
  background: #111827;
}

/* GPS status */

.driver-live-status {
  position: absolute;
  top: 18px;
  right: 18px;
  z-index: 1000;

  display: inline-flex;
  align-items: center;
  gap: 8px;

  min-height: 38px;
  padding: 0 12px;

  border: 1px solid rgba(255, 255, 255, 0.65);
  border-radius: 999px;

  background: rgba(255, 255, 255, 0.94);
  color: #166534;

  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.06em;

  box-shadow: 0 5px 18px rgba(0, 0, 0, 0.16);
  backdrop-filter: blur(8px);
}

.driver-live-status span {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.18);
}

/* Bottom sheet */

.driver-live-sheet {
  position: absolute;
  left: 50%;
  bottom: 18px;
  z-index: 1100;

  width: min(560px, calc(100% - 32px));
  max-height: min(430px, calc(100dvh - 120px));

  transform: translateX(-50%);

  overflow: hidden;

  border: 1px solid rgba(15, 23, 42, 0.10);
  border-radius: 22px;

  background: rgba(255, 255, 255, 0.97);

  box-shadow:
    0 16px 50px rgba(15, 23, 42, 0.22),
    0 4px 14px rgba(15, 23, 42, 0.12);

  backdrop-filter: blur(16px);

  transition:
    max-height 220ms ease,
    box-shadow 220ms ease;
}

/* Collapsed sheet */

.driver-live-sheet:not(.driver-live-sheet-open) {
  max-height: 88px;
}

/* Handle */

.driver-live-handle {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 100%;
  height: 30px;

  padding: 0;

  border: 0;
  background: transparent;

  cursor: pointer;
}

.driver-live-handle span {
  width: 42px;
  height: 4px;

  border-radius: 999px;
  background: #cbd5e1;
}

/* Header */

.driver-live-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;

  padding: 2px 20px 14px;
}

.driver-live-sheet-header > div {
  min-width: 0;
}

.driver-live-sheet-header > div > span {
  display: block;
  margin-bottom: 4px;

  color: #64748b;

  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.09em;
}

.driver-live-sheet-header h1 {
  margin: 0;

  overflow: hidden;

  color: #0f172a;

  font-size: 19px;
  line-height: 1.25;
  font-weight: 850;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-live-locate {
  flex: 0 0 auto;

  width: 42px;
  height: 42px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  border: 1px solid #dbe2ea;
  border-radius: 12px;

  background: #f8fafc;
  color: #1d4ed8;

  cursor: pointer;
}

.driver-live-locate:hover {
  background: #eff6ff;
}

/* Route information */

.driver-live-route {
  display: flex;
  align-items: center;
  gap: 12px;

  margin: 0 20px;
  padding: 12px 14px;

  border-radius: 13px;
  background: #f8fafc;
}

.driver-live-route > svg {
  flex: 0 0 auto;
  color: #2563eb;
}

.driver-live-route > div {
  min-width: 0;
}

.driver-live-route strong {
  display: block;

  overflow: hidden;

  color: #0f172a;

  font-size: 14px;
  line-height: 1.3;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-live-route span {
  display: block;
  margin-top: 3px;

  color: #64748b;

  font-size: 12px;
}

/* Statistics */

.driver-live-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;

  margin: 12px 20px;
}

.driver-live-stats > div {
  display: grid;
  grid-template-columns: auto 1fr;
  grid-template-rows: auto auto;
  column-gap: 8px;

  padding: 10px 11px;

  border: 1px solid #e5eaf0;
  border-radius: 12px;

  background: #fff;
}

.driver-live-stats svg {
  grid-row: 1 / span 2;
  align-self: center;
  color: #475569;
}

.driver-live-stats strong {
  color: #0f172a;
  font-size: 14px;
  line-height: 1.1;
}

.driver-live-stats span {
  color: #64748b;
  font-size: 10px;
  font-weight: 700;
}

/* Trip selector */

.driver-live-bookings {
  margin: 0 20px 12px;
}

.driver-live-bookings label {
  display: block;
  margin-bottom: 5px;

  color: #64748b;

  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.driver-live-bookings select {
  width: 100%;
  height: 42px;

  padding: 0 12px;

  border: 1px solid #dbe2ea;
  border-radius: 11px;

  background: #fff;
  color: #0f172a;

  font: inherit;
  font-size: 13px;
}

/* Errors */

.driver-live-error {
  margin: 0 20px 12px;
  padding: 10px 12px;

  border: 1px solid #fecaca;
  border-radius: 10px;

  background: #fef2f2;
  color: #991b1b;

  font-size: 12px;
  line-height: 1.4;
}

/* Location button */

.driver-live-update {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  width: calc(100% - 40px);
  min-height: 44px;

  margin: 0 20px 18px;

  border: 0;
  border-radius: 12px;

  background: #2563eb;
  color: #fff;

  font-size: 13px;
  font-weight: 800;

  cursor: pointer;
}

.driver-live-update:hover {
  background: #1d4ed8;
}

/* Mobile */

@media (max-width: 720px) {
  .driver-live-page {
    height: calc(100dvh - 64px);
    min-height: 560px;
  }

  .driver-live-back {
    top: 12px;
    left: 12px;
    min-height: 40px;
    padding: 0 12px;
    font-size: 13px;
  }

  .driver-live-status {
    top: 12px;
    right: 12px;
    min-height: 34px;
    padding: 0 10px;
  }

  .driver-live-sheet {
    bottom: 10px;
    width: calc(100% - 20px);
    border-radius: 20px;
    max-height: min(440px, calc(100dvh - 90px));
  }

  .driver-live-sheet:not(.driver-live-sheet-open) {
    max-height: 78px;
  }

  .driver-live-sheet-header {
    padding-left: 16px;
    padding-right: 16px;
  }

  .driver-live-route {
    margin-left: 16px;
    margin-right: 16px;
  }

  .driver-live-stats {
    margin-left: 16px;
    margin-right: 16px;
  }

  .driver-live-bookings,
  .driver-live-error {
    margin-left: 16px;
    margin-right: 16px;
  }

  .driver-live-update {
    width: calc(100% - 32px);
    margin-left: 16px;
    margin-right: 16px;
  }
}

/* =========================================================
   CONNECT DRIVER PORTAL - DEDICATED PAGES
   ========================================================= */

.driver-portal,
.driver-map-page {
  min-height: 100vh;
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.driver-portal {
  display: flex;
  background: #f4f7fb;
  color: #111827;
}

.driver-sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 260px;
  background: #0b1220;
  color: #fff;
  display: flex;
  flex-direction: column;
  z-index: 1000;
  padding: 22px 14px;
}

.driver-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 10px 24px;
}

.driver-brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: #2563eb;
  font-size: 21px;
  font-weight: 900;
}

.driver-brand strong {
  display: block;
  font-size: 16px;
  letter-spacing: .08em;
}

.driver-brand span {
  display: block;
  margin-top: 3px;
  color: #94a3b8;
  font-size: 11px;
}

.driver-user-card {
  display: flex;
  align-items: center;
  gap: 11px;
  margin: 0 4px 18px;
  padding: 12px;
  border: 1px solid rgba(255,255,255,.08);
  background: rgba(255,255,255,.04);
  border-radius: 14px;
}

.driver-avatar,
.driver-profile-avatar {
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #2563eb;
  color: #fff;
  font-weight: 900;
}

.driver-avatar {
  width: 38px;
  height: 38px;
}

.driver-user-card strong {
  display: block;
  font-size: 13px;
}

.driver-user-card span {
  display: block;
  margin-top: 3px;
  color: #94a3b8;
  font-size: 11px;
}

.driver-nav {
  display: grid;
  gap: 5px;
}

.driver-nav-item {
  width: 100%;
  border: 0;
  border-radius: 11px;
  background: transparent;
  color: #a8b3c7;
  display: flex;
  align-items: center;
  gap: 12px;
  text-align: left;
  padding: 12px 13px;
  cursor: pointer;
  font: inherit;
  transition: .15s ease;
}

.driver-nav-item:hover {
  color: #fff;
  background: rgba(255,255,255,.06);
}

.driver-nav-item.active {
  color: #fff;
  background: #2563eb;
  box-shadow: 0 8px 22px rgba(37,99,235,.25);
}

.driver-nav-icon {
  width: 22px;
  text-align: center;
  font-size: 17px;
}

.driver-sidebar-bottom {
  margin-top: auto;
  display: grid;
  gap: 4px;
}

.driver-logout {
  color: #fca5a5;
}

.driver-main {
  margin-left: 260px;
  min-height: 100vh;
  width: calc(100% - 260px);
}

.driver-content {
  max-width: 1500px;
  margin: 0 auto;
  padding: 34px;
}

.driver-page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 24px;
  margin-bottom: 28px;
}

.driver-page-header h1 {
  margin: 4px 0 6px;
  color: #0f172a;
