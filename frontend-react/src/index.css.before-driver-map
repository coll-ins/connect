  border: 0;
  background: transparent;
  color: #2563eb;
  font-weight: 800;
  cursor: pointer;
}

.driver-list {
  display: grid;
  gap: 12px;
}

.driver-booking-card {
  padding: 18px;
}

.driver-booking-top {
  display: flex;
  justify-content: space-between;
  gap: 15px;
}

.driver-booking-top h3 {
  margin: 5px 0 0;
  color: #0f172a;
  font-size: 17px;
}

.driver-status {
  height: fit-content;
  border-radius: 999px;
  padding: 6px 9px;
  background: #eff6ff;
  color: #2563eb;
  font-size: 10px;
  font-weight: 900;
  text-transform: uppercase;
}

.driver-booking-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0,1fr));
  gap: 13px;
  margin: 17px 0;
}

.driver-booking-grid div,
.driver-detail-grid div,
.driver-boarding-details div {
  min-width: 0;
}

.driver-booking-grid span,
.driver-detail-grid span,
.driver-boarding-details span {
  display: block;
  color: #94a3b8;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .07em;
}

.driver-booking-grid strong,
.driver-detail-grid strong,
.driver-boarding-details strong {
  display: block;
  margin-top: 4px;
  color: #334155;
  font-size: 12px;
  line-height: 1.35;
}

.driver-booking-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-top: 14px;
  border-top: 1px solid #edf1f5;
  color: #94a3b8;
  font-size: 11px;
}

.driver-primary-button,
.driver-secondary-button {
  border-radius: 10px;
  border: 0;
  padding: 11px 15px;
  cursor: pointer;
  font: inherit;
  font-size: 12px;
  font-weight: 800;
}

.driver-primary-button {
  background: #2563eb;
  color: #fff;
  box-shadow: 0 7px 18px rgba(37,99,235,.18);
}

.driver-primary-button:hover {
  background: #1d4ed8;
}

.driver-primary-button:disabled {
  opacity: .55;
  cursor: not-allowed;
}

.driver-secondary-button {
  background: #eef2f7;
  color: #334155;
}

.driver-quick-panel {
  display: flex;
  flex-direction: column;
}

.driver-quick-panel > button {
  border: 0;
  border-top: 1px solid #edf1f5;
  background: transparent;
  padding: 15px 0;
  display: flex;
  align-items: center;
  gap: 12px;
  text-align: left;
  cursor: pointer;
}

.driver-quick-panel > button:first-of-type {
  margin-top: 12px;
}

.driver-quick-panel > button > span {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  background: #eff6ff;
  color: #2563eb;
}

.driver-quick-panel strong,
.driver-quick-panel small {
  display: block;
}

.driver-quick-panel strong {
  color: #0f172a;
  font-size: 13px;
}

.driver-quick-panel small {
  margin-top: 2px;
  color: #94a3b8;
  font-size: 10px;
}

.driver-empty {
  text-align: center;
  padding: 45px 20px;
}

.driver-empty-large {
  margin-top: 15px;
  padding: 80px 20px;
  background: #fff;
  border: 1px dashed #dbe2ea;
  border-radius: 18px;
}

.driver-empty-icon {
  width: 48px;
  height: 48px;
  margin: 0 auto 12px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  background: #eff6ff;
  color: #2563eb;
  font-size: 21px;
}

.driver-empty h2,
.driver-empty h3 {
  margin: 0;
  color: #0f172a;
}

.driver-empty p {
  margin: 7px 0 0;
  color: #64748b;
  font-size: 13px;
}

.driver-trip-list {
  display: grid;
  gap: 15px;
}

.driver-trip-card {
  padding: 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22px;
}

.driver-trip-card h2 {
  margin: 6px 0 13px;
  color: #0f172a;
  font-size: 21px;
}

.driver-trip-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  color: #64748b;
  font-size: 12px;
}

.driver-boarding-card {
  padding: 22px;
  display: grid;
  grid-template-columns: 1.1fr 1fr auto;
  align-items: center;
  gap: 25px;
}

.driver-boarding-card h2 {
  margin: 6px 0 5px;
  color: #0f172a;
}

.driver-boarding-card p {
  margin: 0;
  color: #64748b;
  font-size: 12px;
}

.driver-boarding-details {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 12px;
}

.driver-profile-grid {
  display: grid;
  grid-template-columns: 300px minmax(0,1fr);
  gap: 20px;
}

.driver-profile-hero {
  padding: 30px;
  text-align: center;
  height: fit-content;
}

.driver-profile-avatar {
  width: 90px;
  height: 90px;
  margin: 0 auto 17px;
  font-size: 34px;
}

.driver-profile-hero h2 {
  margin: 0;
  color: #0f172a;
}

.driver-profile-hero p {
  color: #64748b;
  font-size: 13px;
}

.driver-detail-grid {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 20px;
  margin-top: 24px;
}

.driver-detail-grid div {
  padding: 15px;
  background: #f8fafc;
  border-radius: 12px;
}

.driver-error {
  border-radius: 11px;
  padding: 11px 13px;
  background: #fef2f2;
  color: #b91c1c;
  border: 1px solid #fecaca;
  font-size: 12px;
}

.driver-global-error {
  margin: 0 34px 0;
}

.driver-app-loading,
.driver-map-loading {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  background: #f4f7fb;
  color: #475569;
}

.driver-loading-spinner {
  width: 25px;
  height: 25px;
  border-radius: 50%;
  border: 3px solid #dbeafe;
  border-top-color: #2563eb;
  animation: driver-spin .75s linear infinite;
}

@keyframes driver-spin {
  to { transform: rotate(360deg); }
}

/* Full-screen live location */

.driver-map-page {
  position: fixed;
  inset: 0;
  background: #dbeafe;
  overflow: hidden;
  z-index: 2000;
}

.driver-map,
.driver-full-map {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.driver-map-topbar {
  position: absolute;
  top: 18px;
  left: 18px;
  right: 18px;
  z-index: 1000;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 11px 14px;
  border-radius: 16px;
  background: rgba(255,255,255,.95);
  box-shadow: 0 10px 30px rgba(15,23,42,.16);
  pointer-events: none;
}

.driver-map-topbar > * {
  pointer-events: auto;
}

.driver-map-topbar strong,
.driver-map-topbar span {
  display: block;
}

.driver-map-topbar strong {
  color: #0f172a;
  font-size: 14px;
}

.driver-map-topbar span {
  margin-top: 2px;
  color: #64748b;
  font-size: 10px;
}

.driver-map-back {
  width: 39px;
  height: 39px;
  border: 0;
  border-radius: 11px;
  background: #0f172a;
  color: #fff;
  font-size: 20px;
  cursor: pointer;
}

.driver-map-live-dot {
  width: 10px;
  height: 10px;
  margin-left: auto;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 0 5px rgba(34,197,94,.16);
}

.driver-map-sheet {
  position: absolute;
  z-index: 1000;
  left: 50%;
  bottom: 20px;
  width: min(650px, calc(100% - 30px));
  transform: translateX(-50%);
  padding: 11px 20px 20px;
  border-radius: 22px;
  background: rgba(255,255,255,.97);
  box-shadow: 0 20px 60px rgba(15,23,42,.2);
}

.driver-sheet-handle {
  width: 42px;
  height: 4px;
  margin: 0 auto 14px;
  border-radius: 99px;
  background: #cbd5e1;
}

.driver-sheet-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
}

.driver-sheet-heading h2 {
  margin: 4px 0 0;
  color: #0f172a;
  font-size: 19px;
}

.driver-live-badge {
  border-radius: 99px;
  padding: 6px 9px;
  background: #dcfce7;
  color: #15803d;
  font-size: 9px;
  font-weight: 900;
}

.driver-trip-select {
  width: 100%;
  margin-top: 15px;
  padding: 12px;
  border: 1px solid #dbe2ea;
  border-radius: 10px;
  background: #fff;
  color: #334155;
}

.driver-map-stats {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 9px;
  margin-top: 10px;
}

.driver-map-stats div {
  padding: 9px;
  border-radius: 10px;
  background: #f8fafc;
}

.driver-map-stats span,
.driver-map-stats strong {
  display: block;
}

.driver-map-stats span {
  color: #94a3b8;
  font-size: 9px;
  text-transform: uppercase;
}

.driver-map-stats strong {
  margin-top: 3px;
  color: #0f172a;
  font-size: 14px;
}

.driver-stage-marker,
.driver-bus-marker,
.driver-passenger-marker {
  background: transparent !important;
  border: 0 !important;
}

.driver-stage-pin {
  width: 42px;
  height: 48px;
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  filter: drop-shadow(0 3px 5px rgba(0,0,0,.3));
}

.driver-stage-pin::after {
  content: "";
  position: absolute;
  bottom: 1px;
  left: 50%;
  width: 11px;
  height: 11px;
  transform: translateX(-50%) rotate(45deg);
  background: #ef4444;
  border-right: 2px solid #fff;
  border-bottom: 2px solid #fff;
}

.driver-stage-pin span {
  position: relative;
  z-index: 2;
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  border: 3px solid #fff;
  background: #ef4444;
  color: #fff;
  font-weight: 900;
  font-size: 13px;
  box-shadow: 0 0 0 2px rgba(239,68,68,.28), 0 4px 9px rgba(0,0,0,.28);
}

.driver-bus-pin {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #2563eb;
  border: 4px solid #fff;
  box-shadow: 0 5px 15px rgba(37,99,235,.4);
  font-size: 25px;
}

.driver-passenger-pin {
  width: 24px;
  height: 24px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #16a34a;
  border: 3px solid #fff;
  box-shadow: 0 2px 8px rgba(0,0,0,.25);
  color: #fff;
  font-size: 8px;
}

.driver-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 5000;
  display: grid;
  place-items: center;
  padding: 20px;
  background: rgba(2,6,23,.62);
  backdrop-filter: blur(5px);
}

.driver-modal {
  width: min(430px,100%);
  padding: 28px;
  border-radius: 22px;
  background: #fff;
  box-shadow: 0 30px 100px rgba(0,0,0,.28);
}

.driver-modal-icon {
  width: 48px;
  height: 48px;
  margin-bottom: 17px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: #eff6ff;
  color: #2563eb;
  font-size: 22px;
  font-weight: 900;
}

.driver-modal h2 {
  margin: 5px 0;
  color: #0f172a;
}

.driver-modal p {
  color: #64748b;
  font-size: 12px;
  line-height: 1.55;
}

.driver-modal-passenger {
  display: flex;
  flex-direction: column;
  gap: 3px;
  margin: 18px 0;
  padding: 13px;
  border-radius: 12px;
  background: #f8fafc;
}

.driver-modal-passenger strong {
  color: #0f172a;
}

.driver-modal-passenger span {
  color: #64748b;
  font-size: 11px;
}

.driver-pin-input {
  width: 100%;
  box-sizing: border-box;
  padding: 15px;
  border: 2px solid #dbe2ea;
  border-radius: 12px;
  outline: none;
  text-align: center;
  letter-spacing: .55em;
  font-size: 24px;
  font-weight: 900;
}

.driver-pin-input:focus {
  border-color: #2563eb;
}

.driver-modal .driver-error {
  margin-top: 10px;
}

.driver-modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 9px;
  margin-top: 17px;
}

@media (max-width: 1050px) {
  .driver-stat-grid {
    grid-template-columns: repeat(2,1fr);
  }

  .driver-overview-grid,
  .driver-profile-grid {
    grid-template-columns: 1fr;
  }

  .driver-boarding-card {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 760px) {
  .driver-sidebar {
    width: 76px;
    padding: 15px 9px;
  }

  .driver-brand {
    justify-content: center;
    padding: 0 0 18px;
  }

  .driver-brand > div:last-child,
  .driver-user-card > div:last-child,
  .driver-nav-item > span:last-child {
    display: none;
  }

  .driver-user-card {
    justify-content: center;
    padding: 9px 4px;
  }

  .driver-nav-item {
    justify-content: center;
    padding: 12px 5px;
  }

  .driver-main {
    margin-left: 76px;
    width: calc(100% - 76px);
  }

  .driver-content {
    padding: 22px 15px;
  }

  .driver-page-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .driver-stat-grid {
    grid-template-columns: 1fr 1fr;
  }

  .driver-booking-grid,
  .driver-detail-grid {
    grid-template-columns: 1fr 1fr;
  }

  .driver-trip-card {
    align-items: flex-start;
    flex-direction: column;
  }

  .driver-map-sheet {
    bottom: 10px;
    width: calc(100% - 20px);
  }
}

@media (max-width: 480px) {
  .driver-stat-grid,
  .driver-booking-grid,
  .driver-detail-grid,
  .driver-boarding-details {
    grid-template-columns: 1fr;
  }

  .driver-booking-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .driver-modal {
    padding: 22px;
  }
}
