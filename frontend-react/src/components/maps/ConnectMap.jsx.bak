import { useEffect } from 'react';
import {
  MapContainer,
  TileLayer,
  Marker,
  Popup,
  Polyline,
  CircleMarker,
  useMap,
} from 'react-leaflet';
import L from 'leaflet';
import 'leaflet/dist/leaflet.css';

const DEFAULT_CENTER = [-1.286389, 36.817223];

const driverIcon = L.divIcon({
  className: 'connect-map-marker',
  html: `
    <div class="connect-map-marker-inner driver-marker">
      <span>🚌</span>
    </div>
  `,
  iconSize: [42, 42],
  iconAnchor: [21, 21],
  popupAnchor: [0, -22],
});

const passengerIcon = L.divIcon({
  className: 'connect-map-marker',
  html: `
    <div class="connect-map-marker-inner passenger-marker">
      <span>📍</span>
    </div>
  `,
  iconSize: [42, 42],
  iconAnchor: [21, 21],
  popupAnchor: [0, -22],
});

function MapCenter({ center }) {
  const map = useMap();

  useEffect(() => {
    if (center) {
      map.setView(center, map.getZoom());
    }
  }, [center, map]);

  return null;
}

export default function ConnectMap({
  driver,
  passenger,
  pickup,
  routeGeometry,
  height = 380,
  zoom = 14,
  showDriver = true,
  showPassenger = true,
}) {
  const driverPosition =
    driver?.latitude != null && driver?.longitude != null
      ? [Number(driver.latitude), Number(driver.longitude)]
      : null;

  const passengerPosition =
    passenger?.latitude != null && passenger?.longitude != null
      ? [Number(passenger.latitude), Number(passenger.longitude)]
      : null;

  const pickupPosition =
    pickup?.latitude != null && pickup?.longitude != null
      ? [Number(pickup.latitude), Number(pickup.longitude)]
      : null;

  const routePositions =
    routeGeometry?.type === 'LineString' &&
    Array.isArray(routeGeometry.coordinates)
      ? routeGeometry.coordinates
          .filter(
            (point) =>
              Array.isArray(point) &&
              point.length >= 2 &&
              Number.isFinite(Number(point[0])) &&
              Number.isFinite(Number(point[1]))
          )
          .map(([lng, lat]) => [Number(lat), Number(lng)])
      : [];

  const center =
    driverPosition ||
    passengerPosition ||
    pickupPosition ||
    (routePositions.length ? routePositions[Math.floor(routePositions.length / 2)] : null) ||
    DEFAULT_CENTER;

  return (
    <div
      className="connect-map-wrapper"
      style={{ height }}
    >
      <MapContainer
        center={center}
        zoom={zoom}
        scrollWheelZoom
        style={{
          height: '100%',
          width: '100%',
          borderRadius: '16px',
        }}
      >
        <TileLayer
          attribution='&copy; OpenStreetMap contributors'
          url="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
        />

        <MapCenter center={center} />

        {showDriver && driverPosition && (
          <Marker
            position={driverPosition}
            icon={driverIcon}
          >
            <Popup>
              <strong>{driver.name || 'Driver'}</strong>
              <br />
              {driver.bus_number
                ? `Bus: ${driver.bus_number}`
                : 'Driver location'}
            </Popup>
          </Marker>
        )}

        {routePositions.length > 1 && (
          <Polyline
            positions={routePositions}
            pathOptions={{
              weight: 5,
              opacity: 0.75,
            }}
          />
        )}

        {pickupPosition && (
          <CircleMarker
            center={pickupPosition}
            radius={8}
            pathOptions={{
              weight: 3,
              fillOpacity: 0.9,
            }}
          >
            <Popup>
              <strong>{pickup?.name || 'Pickup stage'}</strong>
              <br />
              Selected boarding point
            </Popup>
          </CircleMarker>
        )}

        {showPassenger && passengerPosition && (
          <Marker
            position={passengerPosition}
            icon={passengerIcon}
          >
            <Popup>
              <strong>Your location</strong>
              <br />
              Live passenger location
            </Popup>
          </Marker>
        )}
      </MapContainer>
    </div>
  );
}
