import { useEffect, useMemo, useRef } from 'react';
import {
  MapContainer,
  TileLayer,
  Marker,
  Popup,
  Polyline,
  CircleMarker,
  useMap,
} from 'react-leaflet';
import L from 'leaflet';
import 'leaflet/dist/leaflet.css';

const DEFAULT_CENTER = [-1.286389, 36.817223];

const driverIcon = L.divIcon({
  className: 'connect-map-marker',
  html: `
    <div class="connect-map-marker-inner driver-marker">
      <span>🚌</span>
    </div>
  `,
  iconSize: [42, 42],
  iconAnchor: [21, 21],
  popupAnchor: [0, -22],
});

const passengerIcon = L.divIcon({
  className: 'connect-map-marker',
  html: `
    <div class="connect-map-marker-inner passenger-marker">
      <span>📍</span>
    </div>
  `,
  iconSize: [42, 42],
  iconAnchor: [21, 21],
  popupAnchor: [0, -22],
});

function stageIcon(stage) {
  const order = Number(stage?.order || 0);
  const count = Number(stage?.passenger_count || 0);

  return L.divIcon({
    className: 'connect-stage-marker',
    html: `
      <div class="connect-stage-pin">
        <div class="connect-stage-pin-core">
          <span class="connect-stage-number">${order}</span>
        </div>
      </div>
    `,
    iconSize: [42, 50],
    iconAnchor: [21, 46],
    popupAnchor: [0, -42],
  });
}

function MapResize({ height }) {
  const map = useMap();

  useEffect(() => {
    const timers = [
      setTimeout(() => map.invalidateSize(), 50),
      setTimeout(() => map.invalidateSize(), 250),
      setTimeout(() => map.invalidateSize(), 600),
    ];

    return () => timers.forEach(clearTimeout);
  }, [height, map]);

  return null;
}

function MapCenter({ routePositions }) {
  const map = useMap();
  const fitted = useRef(false);

  useEffect(() => {
    if (fitted.current || routePositions.length < 2) {
      return;
    }

const bounds = L.latLngBounds(routePositions);

if (bounds.isValid()) {
  map.fitBounds(bounds, {
    padding: [40, 40],
    maxZoom: 14,
  });
  fitted.current = true;
}
  }, [routePositions, map]);

  return null;
}

export default function ConnectMap({
  driver,
  passenger,
  pickup,
  routeGeometry,
  stages = [],
  height = 380,
  zoom = 14,
  showDriver = true,
  showPassenger = true,
}) {
  const driverPosition =
    driver?.latitude != null && driver?.longitude != null
      ? [Number(driver.latitude), Number(driver.longitude)]
      : null;

  const passengerPosition =
    passenger?.latitude != null && passenger?.longitude != null
      ? [Number(passenger.latitude), Number(passenger.longitude)]
      : null;

  const pickupPosition =
    pickup?.latitude != null && pickup?.longitude != null
      ? [Number(pickup.latitude), Number(pickup.longitude)]
      : null;

  const routePositions =
    routeGeometry?.type === 'LineString' &&
    Array.isArray(routeGeometry.coordinates)
      ? routeGeometry.coordinates
          .filter(
            (point) =>
              Array.isArray(point) &&
              point.length >= 2 &&
              Number.isFinite(Number(point[0])) &&
              Number.isFinite(Number(point[1]))
          )
          .map(([lng, lat]) => [Number(lat), Number(lng)])
      : [];

  console.log("[CONNECT MAP] routeGeometry:", routeGeometry);
  console.log("[CONNECT MAP] route points:", routePositions.length);
  console.log("[CONNECT MAP] stages:", stages.length);

  const stageMarkers = useMemo(
    () =>
      stages
        .filter(
          (stage) =>
            stage?.latitude != null &&
            stage?.longitude != null &&
            Number.isFinite(Number(stage.latitude)) &&
            Number.isFinite(Number(stage.longitude))
        )
        .map((stage) => ({
          ...stage,
          position: [Number(stage.latitude), Number(stage.longitude)],
        })),
    [stages],
  );

  const center =
    driverPosition ||
    passengerPosition ||
    pickupPosition ||
    (routePositions.length
      ? routePositions[Math.floor(routePositions.length / 2)]
      : null) ||
    DEFAULT_CENTER;

  return (
    <div className="connect-map-wrapper" style={{ height }}>

  <MapContainer
    center={center}
    zoom={zoom}
    scrollWheelZoom
    style={{
      height: '100%',
      width: '100%',
      borderRadius: '16px',
    }}
  >
    <TileLayer
      attribution="&copy; OpenStreetMap contributors"
      url="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
    />

    <MapResize height={height} />
    <MapCenter routePositions={routePositions} />

    {routePositions.length > 1 && (
      <>
        {/* Soft outer glow */}
        <Polyline
          positions={routePositions}
          pathOptions={{
            color: "#1677ff",
            weight: 11,
            opacity: 0.20,
            lineCap: "round",
            lineJoin: "round",
            interactive: false,
          }}
        />

        {/* Main route - medium thickness */}
        <Polyline
          positions={routePositions}
          pathOptions={{
            color: "#1677ff",
            weight: 6,
            opacity: 0.95,
            lineCap: "round",
            lineJoin: "round",
            interactive: false,
          }}
        />

        {/* Thin light center */}
        <Polyline
          positions={routePositions}
          pathOptions={{
            color: "#ffffff",
            weight: 2,
            opacity: 0.80,
            lineCap: "round",
            lineJoin: "round",
            interactive: false,
          }}
        />
      </>
    )}

    {stageMarkers.map((stage) => (
      <Marker
        key={stage.id}
        position={stage.position}
        icon={stageIcon(stage)}
      >
        <Popup>
          <strong>
            {stage.order}. {stage.name}
          </strong>
          <br />
          Passengers: {stage.passenger_count || 0}
          <br />
          Bookings: {stage.booking_count || 0}
        </Popup>
      </Marker>
    ))}

    {showDriver && driverPosition && (
      <Marker position={driverPosition} icon={driverIcon}>
        <Popup>
          <strong>{driver.name || 'Driver'}</strong>
          <br />
          {driver.bus_number
            ? `Bus: ${driver.bus_number}`
            : 'Driver location'}
        </Popup>
      </Marker>
    )}

    {pickupPosition && (
      <CircleMarker
        center={pickupPosition}
        radius={8}
        pathOptions={{
          weight: 3,
          fillOpacity: 0.9,
        }}
      >
        <Popup>
          <strong>{pickup?.name || 'Pickup stage'}</strong>
          <br />
          Selected boarding point
        </Popup>
      </CircleMarker>
    )}

    {showPassenger && passengerPosition && (
      <Marker position={passengerPosition} icon={passengerIcon}>
        <Popup>
          <strong>Your location</strong>
          <br />
          Live passenger location
        </Popup>
      </Marker>
    )}
  </MapContainer>
</div>
  );
}