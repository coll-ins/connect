# Copy to /etc/connect/connect.env (chmod 640, owner root:connect).
# Values: no spaces, quotes or $ characters (the file is read by systemd AND sourced by bash).
# Generate SECRET_KEY with: python3 -c "import secrets;print(secrets.token_urlsafe(64))"
DEBUG=False
SECRET_KEY=PASTE_GENERATED_KEY_HERE
ALLOWED_HOSTS=connect.example.com
CORS_ALLOWED_ORIGINS=https://connect.example.com
FRONTEND_URL=https://connect.example.com
DATABASE_URL=postgres://connect:CHANGE_ME@127.0.0.1:5432/connect
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
BEHIND_TLS_PROXY=True
NUM_PROXIES=1
PAYSTACK_SECRET_KEY=sk_live_REPLACE
ADMIN_ALERT_PHONE_NUMBERS=+254700000000
ADMIN_SIGNUP_CODE=REPLACE_WITH_24_PLUS_RANDOM_CHARS
AT_USERNAME=REPLACE
AT_API_KEY=REPLACE
SECURE_HSTS_SECONDS=3600
OFFSITE_REMOTE=
