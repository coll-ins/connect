SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
*/5  * * * * connect /srv/connect/deploy/run_cmd.sh expire_pending_bookings
*/10 * * * * connect /srv/connect/deploy/run_cmd.sh process_noshows
*/15 * * * * connect /srv/connect/deploy/run_cmd.sh reconcile_refunds
15 2 * * *   connect bash -c 'set -a; . /etc/connect/connect.env; set +a; /srv/connect/deploy/backup.sh >> /var/log/connect/backup.log 2>&1'
# NOT scheduled on purpose: settle_company. Add any 4th command after the Block 3 ls output is confirmed.
